.DS_Store
**/.DS_Store
._*
**/._*
__MACOSX/
**/__MACOSX/
__pycache__/
*.py[cod]
.pytest_cache/
*.tmp
*.lock

# Sensitive evidence is never public.
private/*
!private/README.md
!private/evidence/
private/evidence/*
!private/evidence/.gitkeep

# Batch working files contain advertisements and tailored materials.
batches/*
!batches/.gitkeep

# Candidate CVs and master documents are local inputs.
profile/cv/*.docx
profile/cv/*.pdf
profile/cv/masters/*
!profile/cv/masters/.gitkeep

# Submitted materials stay local.
archive/applications/*
!archive/applications/.gitkeep
