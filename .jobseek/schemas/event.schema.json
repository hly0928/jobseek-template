{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JobSeek Event Envelope",
  "type": "object",
  "required": ["schema_version", "event_type", "at", "batch_id", "track"],
  "properties": {
    "schema_version": {"const": 1},
    "event_type": {"type": "string", "minLength": 1},
    "at": {"type": "string", "minLength": 1},
    "batch_id": {"type": "string", "minLength": 1},
    "track": {"enum": ["IT", "PartTime"]},
    "actor": {
      "enum": [
        "lead",
        "discovery",
        "eligibility-audit",
        "materials",
        "submission",
        "confirmation-audit",
        "user"
      ]
    },
    "submission_attempt_id": {
      "type": ["string", "null"],
      "pattern": "^(attempt|legacy)-[A-Za-z0-9._-]+$"
    },
    "submission_review_cycle_id": {
      "type": ["string", "null"],
      "pattern": "^(review-cycle|legacy-review-cycle)-[A-Za-z0-9._-]+$"
    },
    "control_signal_id": {
      "type": "string",
      "pattern": "^(signal|legacy-signal)-[A-Za-z0-9._-]+$"
    },
    "control_signal_resolution": {
      "enum": ["resolved"]
    },
    "authorized_by": {
      "enum": ["user"]
    },
    "resolution": {
      "enum": ["resolved"]
    },
    "reason_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$"
    },
    "trigger_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$"
    },
    "trigger_version": {
      "type": "integer",
      "minimum": 1
    },
    "eligibility_trigger_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "covered_trigger_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "eligibility_trigger_version": {
      "type": "integer",
      "minimum": 0
    },
    "resolution_status": {
      "enum": ["pending", "remain_paused", "resolved", "skipped"]
    },
    "confirmation_audit_result": {
      "enum": ["verified", "not_submitted", "unresolved"]
    },
    "evidence": {
      "type": ["object", "null"],
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "additionalProperties": false
    }
  }
}
