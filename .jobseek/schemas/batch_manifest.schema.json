{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JobSeek Batch Manifest v2",
  "type": "object",
  "required": [
    "schema_version",
    "batch_id",
    "batch_sequence",
    "track",
    "created_at",
    "state",
    "input_snapshot",
    "policy"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "batch_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,39}-[0-9]{8}-[0-9]{3,}$"
    },
    "batch_sequence": {
      "type": "integer",
      "minimum": 1
    },
    "batch_date": {
      "type": "string",
      "pattern": "^[0-9]{8}$"
    },
    "batch_naming_version": {
      "type": "integer",
      "const": 1
    },
    "track": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "enum": [
        "Preflight",
        "Active",
        "Completed"
      ]
    },
    "policy": {
      "type": "object",
      "required": [
        "limits",
        "stop_conditions"
      ],
      "properties": {
        "limits": {
          "type": "object"
        },
        "stop_conditions": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "required": [
        "runtime_version",
        "control_sha256"
      ],
      "properties": {
        "runtime_version": {
          "enum": [
            1,
            2
          ]
        },
        "control_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "input_snapshot": {
      "type": "object",
      "required": [
        "schema_version",
        "root",
        "files",
        "aggregate_sha256"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "root": {
          "const": "inputs"
        },
        "aggregate_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "path",
              "sha256",
              "size"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "size": {
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}
