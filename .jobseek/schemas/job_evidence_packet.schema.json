{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JobSeek immutable Job Evidence Packet",
  "type": "object",
  "required": ["schema_version", "job_key", "advertisement", "metadata", "extracted_facts", "duplicate_check", "hard_exclusions", "score_breakdown", "candidate_fact_ids", "supported_inferences", "classification", "classification_inputs", "risks", "unresolved_items", "artifact_paths"],
  "properties": {
    "schema_version": {"const": 1},
    "job_key": {"type": "string", "minLength": 1},
    "advertisement": {
      "type": "object",
      "properties": {
        "saved_text": {"type": "string", "minLength": 1},
        "source_path": {"type": "string", "minLength": 1},
        "snapshot_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "anyOf": [{"required": ["saved_text"]}, {"required": ["source_path"]}],
      "additionalProperties": false
    },
    "metadata": {"type": "object", "required": ["track", "company", "role", "direct_url"], "properties": {"track": {"type": "string", "minLength": 1}, "company": {"type": "string", "minLength": 1}, "role": {"type": "string", "minLength": 1}, "direct_url": {"type": "string", "minLength": 1}, "canonical_identity": {"type": "string", "minLength": 1}, "source_url": {"type": "string", "minLength": 1}, "advertisement_url": {"type": "string", "minLength": 1}, "url_aliases": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}, "additionalProperties": false},
    "extracted_facts": {"type": "array", "items": {"type": "object", "required": ["fact_id", "claim", "evidence_location"], "properties": {"fact_id": {"type": "string", "minLength": 1}, "claim": {"type": "string", "minLength": 1}, "evidence_location": {"type": "string", "minLength": 1}}, "additionalProperties": false}},
    "duplicate_check": {"type": "object", "required": ["result"], "properties": {"result": {"type": "string"}, "evidence": {"type": "string"}}, "additionalProperties": false},
    "hard_exclusions": {
      "type": "object",
      "required": ["result", "evaluations"],
      "properties": {
        "result": {"enum": ["none", "unknown", "hard_exclusion_confirmed"]},
        "evidence": {"type": "string"},
        "evaluations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/hard_exclusion_evaluation"}
        }
      },
      "additionalProperties": false
    },
    "score_breakdown": {"type": "object", "required": ["total", "components"], "properties": {"total": {"type": "number", "minimum": 0, "maximum": 100}, "components": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "object", "required": ["category", "points", "evidence"], "properties": {"category": {"type": "string", "minLength": 1}, "points": {"type": "number", "minimum": 0, "maximum": 100}, "evidence": {"type": "string", "minLength": 1}}, "additionalProperties": false}}}, "additionalProperties": false},
    "candidate_fact_ids": {"type": "array", "items": {"type": "string", "pattern": "^fact-"}},
    "supported_inferences": {"type": "array", "items": {"$ref": "#/$defs/inference"}},
    "classification": {"enum": ["Eligible", "Skipped", "Needs Review", "Blocked", "Duplicate", "Expired", "Withdrawn"]},
    "classification_inputs": {
      "type": "object",
      "required": ["mechanical_terminal", "sensitive_review_required", "sensitive_reasons", "eligible_threshold", "referee_requirement"],
      "properties": {
        "mechanical_terminal": {"enum": ["Duplicate", "Expired", "Withdrawn", null]},
        "sensitive_review_required": {"type": "boolean"},
        "sensitive_reasons": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "eligible_threshold": {"type": "number", "minimum": 0, "maximum": 100},
        "referee_requirement": {
          "oneOf": [
            {"$ref": "#/$defs/referee_requirement"},
            {"type": "null"}
          ]
        }
      },
      "additionalProperties": false
    },
    "advertisement_summary": {"$ref": "#/$defs/advertisement_summary"},
    "experience_gaps": {"type": "array", "items": {"$ref": "#/$defs/experience_gap"}},
    "review_requests": {"type": "array", "items": {"$ref": "#/$defs/review_request"}},
    "reason_codes": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "audit": {
      "type": "object",
      "required": ["eligibility_required", "eligibility_triggers"],
      "properties": {
        "eligibility_required": {"type": "boolean"},
        "eligibility_triggers": {
          "type": "array",
          "items": {
            "enum": [
              "missing_evidence", "conflicting_evidence", "suspicious_evidence",
              "near_material_threshold", "material_supported_inference",
              "disputed_exclusion_or_blocker", "sensitive_declaration",
              "deterministic_validation_failure", "lead_requested"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "risks": {"type": "array", "items": {"type": "string"}},
    "unresolved_items": {"type": "array", "items": {"type": "string"}},
    "artifact_paths": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "hard_exclusion_evaluation": {
      "type": "object",
      "required": ["rule_id", "advertisement_evidence_location", "candidate_fact_id", "comparison_result", "classification_effect", "reason"],
      "properties": {
        "rule_id": {"type": "string", "minLength": 1},
        "advertisement_evidence_location": {"type": "string", "minLength": 1},
        "candidate_fact_id": {"type": "string", "pattern": "^fact-"},
        "comparison_result": {"enum": ["met", "not_met", "unknown"]},
        "classification_effect": {"enum": ["none", "Skipped", "Needs Review"]},
        "reason": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "inference": {
      "type": "object",
      "required": ["inference_id", "application_question", "candidate_fact_ids", "inferred_capability", "equivalence_reason", "applicable_scope", "prohibited_exaggeration_boundary", "exact_answer"],
      "properties": {
        "inference_id": {"type": "string", "pattern": "^inference-[a-z0-9][a-z0-9._-]{2,119}$"},
        "application_question": {"type": "string", "minLength": 1},
        "candidate_fact_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^fact-"}},
        "inferred_capability": {"type": "string", "minLength": 1},
        "equivalence_reason": {"type": "string", "minLength": 1},
        "applicable_scope": {"type": "string", "minLength": 1},
        "prohibited_exaggeration_boundary": {"type": "string", "minLength": 1},
        "exact_answer": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "referee_requirement": {
      "type": "object",
      "required": [
        "requirement", "alternative_permitted", "authoritative_availability",
        "advertisement_evidence_location", "candidate_fact_id"
      ],
      "properties": {
        "requirement": {
          "enum": [
            "none", "optional", "required_any_professional",
            "current_supervisor_preferred", "current_supervisor_mandatory", "ambiguous"
          ]
        },
        "alternative_permitted": {"enum": ["yes", "no", "unknown"]},
        "authoritative_availability": {"enum": ["available", "unavailable", "unknown"]},
        "advertisement_evidence_location": {"type": "string", "minLength": 1},
        "candidate_fact_id": {"type": "string", "pattern": "^fact-"}
      },
      "additionalProperties": false
    },
    "advertisement_summary": {
      "type": "object",
      "required": [
        "canonical_identity", "mandatory_requirements", "preferred_requirements",
        "blockers", "sensitive_issues", "screening_risks", "role_summary",
        "material_keywords", "source_path"
      ],
      "properties": {
        "canonical_identity": {"type": "string", "minLength": 1},
        "mandatory_requirements": {"type": "array", "items": {"type": "string"}},
        "preferred_requirements": {"type": "array", "items": {"type": "string"}},
        "blockers": {"type": "array", "items": {"type": "string"}},
        "sensitive_issues": {"type": "array", "items": {"type": "string"}},
        "screening_risks": {"type": "array", "items": {"type": "string"}},
        "role_summary": {"type": "string", "minLength": 1},
        "material_keywords": {"type": "array", "items": {"type": "string"}},
        "source_path": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "experience_gap": {
      "type": "object",
      "required": [
        "requirement_id", "requirement_level", "evidence_status", "handling",
        "evidence_location", "candidate_fact_ids"
      ],
      "properties": {
        "requirement_id": {"type": "string", "minLength": 1},
        "requirement_level": {"enum": ["mandatory", "preferred", "soft", "ambiguous"]},
        "evidence_status": {"enum": ["met", "not_met", "unsupported"]},
        "handling": {"enum": ["hard_exclusion", "scoring", "continue_despite_experience_gap", "none"]},
        "evidence_location": {"type": "string", "minLength": 1},
        "candidate_fact_ids": {"type": "array", "items": {"type": "string", "pattern": "^fact-"}},
        "question_fingerprint": {"type": "string", "pattern": "^question-[a-f0-9]{24}$"}
      },
      "additionalProperties": false
    },
    "review_request": {
      "type": "object",
      "required": ["review_type", "question_fingerprint", "allowed_decisions", "status", "decision"],
      "properties": {
        "reason_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$"
        },
        "review_type": {
          "enum": [
            "continue_despite_experience_gap", "unsupported_factual_answer",
            "sensitive_declaration", "document_request", "genuine_user_decision"
          ]
        },
        "question_fingerprint": {"type": "string", "pattern": "^question-[a-f0-9]{24}$"},
        "allowed_decisions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["continue", "resolve", "remain_paused", "skip"]
          }
        },
        "status": {
          "enum": ["pending", "remain_paused", "resolved", "skipped"]
        },
        "decision": {"type": ["string", "null"]},
        "unresolved_item_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
