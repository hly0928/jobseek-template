def safe_id(value: str, label: str) -> str:
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{0,119}", value):
        raise ControlError(f"invalid_{label}")
    return value


def read_json(path: Path, default: Any = None) -> Any:
    if not path.exists():
        return default
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except json.JSONDecodeError as exc:
        raise ControlError(f"invalid_json:{rel(path)}:{exc.lineno}") from exc


def read_json_arg(raw: str) -> Any:
    try:
        return json.loads(raw)
    except json.JSONDecodeError as exc:
        raise ControlError(f"invalid_input_json:{exc.msg}") from exc


def read_jsonl(path: Path) -> list[dict[str, Any]]:
    rows: list[dict[str, Any]] = []
    if not path.exists():
        return rows
    for number, line in enumerate(path.read_text(encoding="utf-8").splitlines(), 1):
        if not line.strip():
            continue
        try:
            row = json.loads(line)
        except json.JSONDecodeError as exc:
            raise ControlError(f"invalid_jsonl:{rel(path)}:{number}:{exc.msg}") from exc
        if not isinstance(row, dict):
            raise ControlError(f"jsonl_object_required:{rel(path)}:{number}")
        rows.append(row)
    return rows


def json_schema_errors(
    value: Any,
    schema: dict[str, Any],
    root_schema: dict[str, Any] | None = None,
    path: str = "$",
) -> list[tuple[str, str]]:
    """Small Draft-2020-12 subset used without adding a runtime dependency."""
    root_schema = root_schema or schema
    if "$ref" in schema:
        ref = schema["$ref"]
        if isinstance(ref, str) and ref.startswith("#/$defs/"):
            schema = root_schema.get("$defs", {}).get(ref.split("/")[-1], {})
        else:
            return [(path, "unsupported_ref")]
    errors: list[tuple[str, str]] = []
    if "allOf" in schema:
        for child in schema["allOf"]:
            errors.extend(json_schema_errors(value, child, root_schema, path))
    for alternatives_key in ("anyOf", "oneOf"):
        if alternatives_key in schema:
            matches = [
                not json_schema_errors(value, child, root_schema, path)
                for child in schema[alternatives_key]
            ]
            valid = sum(bool(item) for item in matches)
            if (alternatives_key == "oneOf" and valid != 1) or (
                alternatives_key == "anyOf" and valid == 0
            ):
                errors.append((path, f"{alternatives_key}_failed"))
            if alternatives_key == "anyOf" and valid:
                return errors
    if "const" in schema and value != schema["const"]:
        errors.append((path, "const_mismatch"))
    if "enum" in schema and value not in schema["enum"]:
        errors.append((path, "enum_mismatch"))
    expected = schema.get("type")
    if expected is not None:
        choices = expected if isinstance(expected, list) else [expected]
        def matches(kind: str) -> bool:
            return {
                "object": isinstance(value, dict),
                "array": isinstance(value, list),
                "string": isinstance(value, str),
                "integer": isinstance(value, int) and not isinstance(value, bool),
                "number": isinstance(value, (int, float)) and not isinstance(value, bool),
                "boolean": isinstance(value, bool),
                "null": value is None,
            }.get(kind, True)
        if not any(matches(kind) for kind in choices):
            return errors + [(path, "type_mismatch")]
    if isinstance(value, dict):
        required = schema.get("required", [])
        for key in required:
            if key not in value:
                errors.append((f"{path}.{key}", "required"))
        properties = schema.get("properties", {})
        for key, child in properties.items():
            if key in value:
                errors.extend(json_schema_errors(value[key], child, root_schema, f"{path}.{key}"))
        if schema.get("additionalProperties") is False:
            for key in value:
                if key not in properties:
                    errors.append((f"{path}.{key}", "additional_property"))
    if isinstance(value, list):
        if isinstance(schema.get("minItems"), int) and len(value) < schema["minItems"]:
            errors.append((path, "minItems"))
        if schema.get("uniqueItems"):
            encoded = [json.dumps(item, sort_keys=True, separators=(",", ":")) for item in value]
            if len(encoded) != len(set(encoded)):
                errors.append((path, "uniqueItems"))
        item_schema = schema.get("items")
        if isinstance(item_schema, dict):
            for index, item in enumerate(value):
                errors.extend(json_schema_errors(item, item_schema, root_schema, f"{path}[{index}]"))
    if isinstance(value, str):
        if isinstance(schema.get("minLength"), int) and len(value) < schema["minLength"]:
            errors.append((path, "minLength"))
        pattern = schema.get("pattern")
        if isinstance(pattern, str):
            try:
                # JSON Schema pattern is a regular-expression search, not a
                # whole-string match (for example, ^fact- accepts a fact ID).
                if re.search(pattern, value) is None:
                    errors.append((path, "pattern"))
            except re.error:
                errors.append((path, "invalid_pattern"))
    if isinstance(value, (int, float)) and not isinstance(value, bool):
        if isinstance(schema.get("minimum"), (int, float)) and value < schema["minimum"]:
            errors.append((path, "minimum"))
        if isinstance(schema.get("maximum"), (int, float)) and value > schema["maximum"]:
            errors.append((path, "maximum"))
    return errors


def schema_validate_file(
    value: Any,
    file_path: Path,
    schema_path: Path,
) -> list[str]:
    schema = read_json(schema_path)
    return [
        f"schema_validation:{rel(file_path)}:{schema_path.name}:{json_path}:{reason}"
        for json_path, reason in json_schema_errors(value, schema)
    ]


def latest_state_attempt(
    events: list[dict[str, Any]], key: str, target: str,
) -> str | None:
    for event in reversed(events):
        if (
            event.get("event_type") == "state_transition"
            and event.get("job_key") == key
            and event.get("to_state") == target
        ):
            attempt = event.get("submission_attempt_id")
            if isinstance(attempt, str) and attempt:
                return attempt
            try:
                return current_submission_attempt(
                    batch_dir(event.get("batch_id")), key,
                )
            except (ControlError, TypeError):
                return None
    return None


def atomic_json(path: Path, data: Any) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    staged = path.with_suffix(path.suffix + ".tmp")
    staged.write_text(json.dumps(data, ensure_ascii=False, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    staged.replace(path)


@contextmanager
def exclusive_lock(path: Path):
    """Use a cross-platform advisory lock beside a mutable shared record."""
    lock_path = path.with_suffix(path.suffix + ".lock")
    lock_path.parent.mkdir(parents=True, exist_ok=True)
    with lock_path.open("a+b") as handle:
        if fcntl is not None:
            fcntl.flock(handle.fileno(), fcntl.LOCK_EX)
        elif msvcrt is not None:  # pragma: no cover - Windows
            handle.seek(0)
            handle.write(b"\0")
            handle.flush()
            msvcrt.locking(handle.fileno(), msvcrt.LK_LOCK, 1)
        else:  # pragma: no cover - unsupported Python platform
            raise ControlError("platform_lock_unavailable")
        try:
            yield
        finally:
            if fcntl is not None:
                fcntl.flock(handle.fileno(), fcntl.LOCK_UN)
            elif msvcrt is not None:  # pragma: no cover - Windows
                handle.seek(0)
                msvcrt.locking(handle.fileno(), msvcrt.LK_UNLCK, 1)


def append_jsonl(path: Path, item: dict[str, Any]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    with exclusive_lock(path):
        append_jsonl_unlocked(path, item)


def append_jsonl_unlocked(path: Path, item: dict[str, Any]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    if path.name == "events.jsonl" and item.get("event_type") != "batch_finalized":
        manifest = read_json(path.parent / "manifest.json", {})
        if manifest.get("state") == "Completed":
            raise ControlError("batch_completed_read_only")
        existing = read_jsonl(path)
        if existing and existing[-1].get("event_type") == "batch_finalized":
            raise ControlError("batch_completed_read_only")
    with path.open("a", encoding="utf-8") as handle:
        handle.write(json.dumps(item, ensure_ascii=False, sort_keys=True, separators=(",", ":")) + "\n")
        handle.flush()
        os.fsync(handle.fileno())


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for block in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()


PLACEHOLDER_PATTERNS = (
    re.compile(r"\{\{[^{}]+\}\}"),
    re.compile(r"\[TODO(?::[^\]]*)?\]", re.IGNORECASE),
    re.compile(r"<(?:replace|insert|your)[^>]*>", re.IGNORECASE),
)


def extract_preflight_text(path: Path) -> str:
    if path.suffix.casefold() == ".docx":
        try:
            with zipfile.ZipFile(path) as archive:
                data = archive.read("word/document.xml")
        except (OSError, KeyError, zipfile.BadZipFile) as exc:
            raise ControlError(f"invalid_required_docx:{rel(path)}") from exc
        return re.sub(r"<[^>]+>", " ", data.decode("utf-8", errors="replace"))
    if path.suffix.casefold() in {".md", ".txt", ".toml", ".json", ".yaml", ".yml"}:
        return path.read_text(encoding="utf-8")
    return ""


def configured_input_paths(track: str) -> list[Path]:
    config = workspace_config()
    safe_track(track)
    paths = [ROOT / value for value in config["tracks"][track]["input_paths"]]
    paths.extend(control_paths())
    paths.append(CONFIG_PATH)
    unique = sorted(set(paths), key=rel)
    for path in unique:
        try:
            resolved = path.resolve()
        except OSError as exc:
            raise ControlError(f"invalid_required_input:{path}") from exc
        if ROOT not in resolved.parents or resolved == (ROOT / "Profile" / "Private_Details.md").resolve():
            raise ControlError("unsafe_snapshot_input")
    return unique


def validate_preflight_inputs(track: str) -> list[Path]:
    paths = configured_input_paths(track)
    missing = [rel(path) for path in paths if not path.is_file()]
    if missing:
        raise ControlError("required_input_missing:" + ",".join(missing))
    placeholders = []
    for path in paths:
        text = extract_preflight_text(path)
        if any(pattern.search(text) for pattern in PLACEHOLDER_PATTERNS):
            placeholders.append(rel(path))
    if placeholders:
        raise ControlError("unresolved_placeholder:" + ",".join(placeholders))
    return paths


def snapshot_manifest(batch: Path, inputs: list[Path]) -> dict[str, Any]:
    root = batch / "inputs"
    records = []
    for source in inputs:
        target = root / rel(source)
        target.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(source, target)
        records.append({"path": rel(source), "sha256": sha256(target), "size": target.stat().st_size})
    digest = hashlib.sha256()
    for record in records:
        digest.update(f"{record['path']}\0{record['sha256']}\0{record['size']}\n".encode())
    result = {
        "schema_version": 1,
        "root": "inputs",
        "files": records,
        "aggregate_sha256": digest.hexdigest(),
    }
    atomic_json(batch / "input_snapshot.json", result)
    return result


def validate_batch_snapshot(batch: Path, manifest: dict[str, Any]) -> dict[str, Any]:
    expected = manifest.get("input_snapshot")
    stored = read_json(batch / "input_snapshot.json")
    if not isinstance(expected, dict) or not isinstance(stored, dict) or stored != expected:
        raise ControlError("batch_snapshot_manifest_missing_or_tampered")
    records = stored.get("files")
    if stored.get("schema_version") != 1 or not isinstance(records, list) or not records:
        raise ControlError("batch_snapshot_manifest_invalid")
    digest = hashlib.sha256()
    for record in records:
        if not isinstance(record, dict) or set(record) != {"path", "sha256", "size"}:
            raise ControlError("batch_snapshot_manifest_invalid")
        relative = record.get("path")
        if not isinstance(relative, str):
            raise ControlError("batch_snapshot_manifest_invalid")
        path = (batch / "inputs" / relative).resolve()
        inputs_root = (batch / "inputs").resolve()
        if inputs_root not in path.parents or not path.is_file():
            raise ControlError("batch_snapshot_file_missing:" + relative)
        if path.stat().st_size != record.get("size") or sha256(path) != record.get("sha256"):
            raise ControlError("batch_snapshot_file_tampered:" + relative)
        digest.update(f"{relative}\0{record['sha256']}\0{record['size']}\n".encode())
    if digest.hexdigest() != stored.get("aggregate_sha256"):
        raise ControlError("batch_snapshot_aggregate_mismatch")
    runtime = manifest.get("runtime")
    if isinstance(runtime, dict):
        control = batch / "inputs" / "tools" / "jobseekctl"
        if (
            runtime.get("runtime_version") not in {1, 2}
            or not isinstance(runtime.get("control_sha256"), str)
            or not control.is_file()
            or sha256(control) != runtime["control_sha256"]
        ):
            raise ControlError("batch_runtime_missing_or_tampered")
    return stored


def control_paths() -> list[Path]:
    """Return the small rule surface that must remain stable during a batch."""
    fixed = [
        ROOT / "AGENTS.md",
        ROOT / "tools" / "jobseekctl",
        ROOT / "tools" / "jobseek_classification.py",
    ]
    patterns = (
        ".jobseek/schemas/*.json",
        ".agents/skills/jobseek-*/SKILL.md",
        ".agents/skills/jobseek-*/agents/openai.yaml",
        ".codex/agents/*.toml",
    )
    paths = [path for path in fixed if path.exists()]
    for pattern in patterns:
        paths.extend(path for path in ROOT.glob(pattern) if path.is_file())
    config = ROOT / ".codex" / "config.toml"
    if config.exists():
        paths.append(config)
    return sorted(set(paths), key=rel)


def current_control_hashes() -> dict[str, str]:
    return {rel(path): sha256(path) for path in control_paths()}


def control_hash_drift(manifest: dict[str, Any]) -> list[dict[str, str | None]]:
    expected = manifest.get("control_hashes")
    if not isinstance(expected, dict):
        return [{"path": "*", "expected": None, "actual": "control_hashes_missing"}]
    actual = current_control_hashes()
    return [
        {"path": path, "expected": expected.get(path), "actual": actual.get(path)}
        for path in sorted(set(expected) | set(actual))
        if expected.get(path) != actual.get(path)
    ]


def require_batch(
    track: str,
    batch_id: str,
    *,
    allow_completed: bool = False,
    migrate_legacy: bool = True,
) -> tuple[Path, dict[str, Any]]:
    safe_track(track)
    batch = batch_dir(batch_id)
    manifest = read_json(batch / "manifest.json")
    if not manifest or manifest.get("track") != track:
        raise ControlError("missing_or_wrong_batch")
    if manifest.get("state") == "Completed":
        if not allow_completed:
            raise ControlError("batch_completed_read_only")
        return batch, manifest
    if manifest.get("schema_version", 1) >= 2:
        validate_batch_snapshot(batch, manifest)
    # Legacy batches predate immutable snapshots. They remain compatible and are
    # never silently rebound to current source hashes.
    if migrate_legacy:
        ensure_legacy_compatibility(batch, manifest, track, mutate=True)
    return batch, manifest


def activate_batch(batch: Path, manifest: dict[str, Any]) -> dict[str, Any]:
    """Mark the first operational mutation without rewriting event history."""
    if manifest.get("state") != "Preflight":
        return manifest
    active = {**manifest, "state": "Active", "started_at": now()}
    atomic_json(batch / "manifest.json", active)
    return active


def authority_paths(track: str) -> list[Path]:
    return configured_input_paths(track)


def hashes(track: str) -> dict[str, Any]:
    missing = [rel(p) for p in authority_paths(track) if not p.exists()]
    return {"schema_version": CACHE_SCHEMA_VERSION, "track": track, "generated_at": now(),
            "files": {rel(p): sha256(p) for p in authority_paths(track) if p.exists()}, "missing": missing}


def normalized(text: Any) -> str:
    return re.sub(r"\s+", " ", str(text or "").strip()).casefold()


def job_key(company: str, role: str, url: str = "") -> str:
    seed = "|".join((normalized(company), normalized(role), normalized(url)))
    slug = re.sub(r"[^a-z0-9]+", "-", f"{company}-{role}".casefold()).strip("-")[:56] or "job"
    return f"{slug}-{hashlib.sha256(seed.encode()).hexdigest()[:12]}"


def search_fingerprint(track: str, source: str, query: str, location: str, filters: str, date_range: str) -> str:
    value = "|".join(normalized(v) for v in (track, source, query, location, filters, date_range))
    return hashlib.sha256(value.encode()).hexdigest()[:24]


def question_fingerprint(
    job_key_value: str,
    review_type: str,
    reason_id: str | None = None,
) -> str:
    seed = (
        f"{safe_id(job_key_value, 'job_key')}|"
        f"{safe_id(review_type, 'review_type')}"
    )
    if reason_id is not None:
        seed += f"|{safe_id(reason_id, 'reason_id')}"
    return "question-" + hashlib.sha256(seed.encode()).hexdigest()[:24]


def review_reason_id(
    key: str,
    review_type: str,
    reason_id: Any = None,
) -> str:
    if isinstance(reason_id, str) and reason_id:
        return safe_id(reason_id, "reason_id")
    # Existing packets used their type-scoped fingerprint as the reason identity.
    return question_fingerprint(key, review_type)


def packet_paths() -> list[Path]:
    return sorted((CONTROL / "batches").glob("*/jobs/*/job_evidence_packet.json")) if (CONTROL / "batches").exists() else []


def line_registry(path: Path, kind: str, logical_source: str | None = None) -> list[dict[str, Any]]:
    items: list[dict[str, Any]] = []
    if path.suffix.lower() != ".md" or not path.exists():
        return items
    for line_no, raw in enumerate(path.read_text(encoding="utf-8").splitlines(), 1):
        text = raw.strip()
        if not text or text.startswith("#") or text.startswith("<!--"):
            continue
        # A fact ID follows its authoritative source text, not its current line number.
        # Moving a fact in the source keeps the ID stable; changing the fact creates a new ID.
        anchor = hashlib.sha256(normalized(text).encode()).hexdigest()[:24]
        source = logical_source or rel(path)
        stable = hashlib.sha256(f"{source}:{anchor}".encode()).hexdigest()[:16]
        items.append({"id": f"{kind}-{stable}", "source": source, "anchor_sha256": anchor,
                      "line": line_no, "text": text})
    return items


def historical_job_rows(track: str) -> list[dict[str, Any]]:
    rows = read_jsonl(ROOT / track / "Tracker" / "applications.jsonl")
    indexed = []
    for row in rows:
        company = row.get("company") or row.get("employer") or ""
        role = row.get("job_title") or row.get("title") or ""
        url = row.get("job_url") or row.get("direct_url") or ""
        if company or role or url:
            indexed.append({"job_key": job_key(company, role, url), "company": company, "role": role,
                            "url": url, "status": row.get("status"), "source": "legacy_tracker"})
    return indexed


def rebuild_cache(track: str) -> dict[str, Any]:
    safe_track(track)
    cache = CONTROL / "cache" / track
    cache.mkdir(parents=True, exist_ok=True)
    authority = hashes(track)
    fact_sources = [ROOT / "Profile" / "Candidate_Profile.md", ROOT / track / "Profile" / "Track_Profile.md"]
    facts = [item for path in fact_sources for item in line_registry(path, "fact")]
    compiled = {"schema_version": CACHE_SCHEMA_VERSION, "track": track, "generated_at": now(),
                "sources": [rel(ROOT / track / "Templates" / "Search_Criteria.md"),
                            rel(ROOT / track / "Templates" / "Application_Answer_Overrides.md")],
                "lines": line_registry(ROOT / track / "Templates" / "Search_Criteria.md", "criteria") +
                         line_registry(ROOT / track / "Templates" / "Application_Answer_Overrides.md", "override")}
    packets: list[dict[str, Any]] = []
    inferences: list[dict[str, Any]] = []
    unresolved: list[dict[str, Any]] = []
    known_fact_ids = {item["id"] for item in facts}
    for packet_path in packet_paths():
        packet = read_json(packet_path, {})
        metadata = packet.get("metadata") if isinstance(packet, dict) and isinstance(packet.get("metadata"), dict) else {}
        if metadata.get("track") != track:
            continue
        key = packet.get("job_key", packet_path.parent.name)
        valid = True
        try:
            validate_packet(packet, track, key, known_fact_ids)
        except ControlError:
            valid = False
        packets.append({"job_key": key, "packet_path": rel(packet_path), "company": metadata.get("company"),
                        "role": metadata.get("role"), "url": metadata.get("direct_url"), "valid": valid})
        if not valid:
            continue
        for item in packet.get("supported_inferences", []):
            inferences.append({"id": item["inference_id"], "job_key": key, "packet_path": rel(packet_path), "record": item})
        for item in packet.get("unresolved_items", []):
            unresolved.append({"job_key": key, "packet_path": rel(packet_path), "item": item})
    jobs = historical_job_rows(track) + packets
    events = []
    for event_path in (CONTROL / "batches").glob("*/events.jsonl") if (CONTROL / "batches").exists() else []:
        for event in read_jsonl(event_path):
            if event.get("track") == track and event.get("event_type") == "search_fingerprint":
                events.append(event)
    fingerprints = {e.get("fingerprint"): {"batch_id": e.get("batch_id"), "at": e.get("at"), "fields": e.get("fields", {})}
                    for e in events if e.get("fingerprint")}
    snapshot = {"schema_version": CACHE_SCHEMA_VERSION, "track": track, "generated_at": now(), "authority_hash": authority["files"],
                "fact_count": len(facts), "packet_count": len(packets), "historical_job_count": len(historical_job_rows(track)),
                "unresolved_count": len(unresolved), "fingerprint_count": len(fingerprints)}
    atomic_json(cache / "authority_hashes.json", authority)
    atomic_json(cache / "candidate_fact_registry.json", {"schema_version": CACHE_SCHEMA_VERSION, "items": facts})
    atomic_json(cache / "supported_inference_registry.json", {"schema_version": CACHE_SCHEMA_VERSION, "items": inferences,
                                                                 "notice": "Derived index only; packet and authority citations remain required."})
    atomic_json(cache / "criteria_compiled.json", compiled)
    atomic_json(cache / "job_keys.json", {"schema_version": CACHE_SCHEMA_VERSION, "items": jobs})
    atomic_json(cache / "search_fingerprints.json", {"schema_version": CACHE_SCHEMA_VERSION, "items": fingerprints})
    atomic_json(cache / "unresolved_items.json", {"schema_version": CACHE_SCHEMA_VERSION, "items": unresolved})
    atomic_json(cache / "context_snapshot.json", snapshot)
    return {"cache": rel(cache), "rebuilt": True, "snapshot": snapshot, "missing_authority": authority["missing"]}


def cache_current(track: str) -> tuple[bool, dict[str, Any]]:
    path = CONTROL / "cache" / track / "authority_hashes.json"
    cached = read_json(path, {})
    current = hashes(track)
    return (cached.get("schema_version") == CACHE_SCHEMA_VERSION and cached.get("files") == current["files"]
            and cached.get("missing") == current["missing"]), current


def ensure_cache(track: str) -> dict[str, Any]:
    current, _ = cache_current(track)
    if not current:
        return rebuild_cache(track)
    snapshot = read_json(CONTROL / "cache" / track / "context_snapshot.json", {})
    return {"cache": rel(CONTROL / "cache" / track), "rebuilt": False, "snapshot": snapshot, "missing_authority": []}


def batch_dir(batch_id: str) -> Path:
    return CONTROL / "batches" / safe_id(batch_id, "batch_id")


def canonical_legacy_batch_sequence(batch_id: str) -> int | None:
    """Read only the former three-digit canonical form; ignore timestamp-like legacy IDs."""
    match = BATCH_ID_RE.fullmatch(batch_id)
    if not match or len(match.group(3)) != 3:
        return None
    return int(match.group(3))


def observed_batch_sequence() -> tuple[int, str | None]:
    highest = 0
    last_batch_id: str | None = None
    batches = CONTROL / "batches"
    for path in sorted(batches.glob("*/manifest.json")):
        manifest = read_json(path, {})
        batch_id = manifest.get("batch_id")
        if not isinstance(batch_id, str) or path.parent.name != batch_id:
            continue
        sequence = manifest.get("batch_sequence")
        if not isinstance(sequence, int) or isinstance(sequence, bool) or sequence < 1:
            sequence = canonical_legacy_batch_sequence(batch_id)
        if sequence is not None and sequence > highest:
            highest = sequence
            last_batch_id = batch_id
    return highest, last_batch_id


def current_batch_sequence() -> tuple[int, str | None]:
    observed, observed_id = observed_batch_sequence()
    ledger = read_json(BATCH_SEQUENCE_PATH, {})
    if ledger and (
        ledger.get("schema_version") != 1
        or not isinstance(ledger.get("current_sequence"), int)
        or isinstance(ledger.get("current_sequence"), bool)
        or ledger["current_sequence"] < 0
    ):
        raise ControlError("invalid_batch_sequence_ledger")
    recorded = ledger.get("current_sequence", 0)
    if recorded >= observed:
        return recorded, ledger.get("last_batch_id")
    return observed, observed_id


def next_batch_identity(track: str) -> tuple[str, int, str]:
    safe_track(track)
    current, _ = current_batch_sequence()
    sequence = current + 1
    date = dt.datetime.now(PERTH_TIMEZONE).strftime("%Y%m%d")
    return f"{track}-{date}-{sequence:03d}", sequence, date


def create_batch(track: str, cache: dict[str, Any], dry_run: bool = False) -> dict[str, Any]:
    inputs = validate_preflight_inputs(track)
    (CONTROL / "batches").mkdir(parents=True, exist_ok=True)
    with exclusive_lock(BATCH_SEQUENCE_PATH):
        batch_id, sequence, date = next_batch_identity(track)
        final_batch = batch_dir(batch_id)
        path = final_batch / "manifest.json"
        if final_batch.exists():
            raise ControlError("next_batch_id_already_exists")
        policy = batch_policy()
        if dry_run:
            records = [{"path": rel(item), "sha256": sha256(item), "size": item.stat().st_size} for item in inputs]
            digest = hashlib.sha256()
            for record in records:
                digest.update(f"{record['path']}\0{record['sha256']}\0{record['size']}\n".encode())
            snapshot = {"schema_version": 1, "root": "inputs", "files": records,
                        "aggregate_sha256": digest.hexdigest()}
        else:
            staging = Path(tempfile.mkdtemp(prefix=f".{batch_id}.", dir=CONTROL / "batches"))
            try:
                snapshot = snapshot_manifest(staging, inputs)
            except Exception:
                shutil.rmtree(staging, ignore_errors=True)
                raise
        manifest = {
            "schema_version": 2,
            "batch_id": batch_id,
            "batch_sequence": sequence,
            "batch_date": date,
            "batch_naming_version": 1,
            "track": track,
            "created_at": now(),
            "state": "Preflight",
            "input_snapshot": snapshot,
            "runtime": {
                "runtime_version": 2,
                "control_sha256": sha256(inputs[inputs.index(ROOT / "tools" / "jobseekctl")]),
            },
            "policy": policy,
            "notes": "Operational event state plus immutable public/ordinary candidate inputs; no private values.",
        }
        if not dry_run:
            try:
                atomic_json(staging / "manifest.json", manifest)
                (staging / "jobs").mkdir(exist_ok=True)
                (staging / "reports").mkdir(exist_ok=True)
                staging.replace(final_batch)
            except Exception:
                shutil.rmtree(staging, ignore_errors=True)
                raise
            atomic_json(BATCH_SEQUENCE_PATH, {
                "schema_version": 1,
                "current_sequence": sequence,
                "last_batch_id": batch_id,
            })
    runtime = (
        batch_runtime_context(final_batch, manifest)
        if not dry_run
        else {
            "runtime_version": 2,
            "project_root": rel(final_batch / "inputs"),
            "worker_launch_rule": (
                "Launch every bounded worker with project_root as its cwd, pass "
                "required_environment, and invoke control_entrypoint for every CLI call."
            ),
        }
    )
    return {
        "batch_id": batch_id,
        "manifest": rel(path),
        "created": not dry_run,
        "would_create": dry_run,
        "cache_rebuilt": cache["rebuilt"],
        "snapshot_files": len(snapshot["files"]),
        "snapshot": cache["snapshot"],
        "missing_authority": cache["missing_authority"],
        "worker_runtime": runtime,
    }


def init_batch(
    track: str, batch_id: str | None, dry_run: bool = False,
    new_batch: bool = False, test_mode: bool = False, legacy_test_mode: bool = False,
) -> dict[str, Any]:
    if (test_mode or legacy_test_mode) and os.environ.get("JOBSEEK_TEST_MODE") != "1":
        raise ControlError("test_mode_environment_required")
    if new_batch:
        if batch_id is not None or test_mode or legacy_test_mode:
            raise ControlError("new_batch_arguments_conflict")
        safe_track(track)
        workspace_config()
        cache = ensure_cache(track)
        return create_batch(track, cache, dry_run)
    if batch_id is None:
        raise ControlError("batch_id_required_for_resume")
    path = batch_dir(batch_id) / "manifest.json"
    existing = read_json(path)
    if existing:
        if existing.get("track") != track:
            raise ControlError("batch_track_mismatch")
        if existing.get("state") == "Completed":
            raise ControlError("batch_completed_read_only")
        if existing.get("schema_version", 1) >= 2:
            validate_batch_snapshot(path.parent, existing)
        else:
            ensure_legacy_compatibility(
                path.parent, existing, track, mutate=not dry_run,
            )
        runtime = (
            batch_runtime_context(path.parent, existing)
            if not dry_run
            else None
        )
        snapshot = existing.get("input_snapshot", {})
        return {
            "batch_id": batch_id,
            "manifest": rel(path),
            "created": False,
            "would_create": False,
            "cache_rebuilt": False,
            "snapshot_files": len(snapshot.get("files", [])) if isinstance(snapshot, dict) else 0,
            "snapshot": snapshot,
            "missing_authority": [],
            "worker_runtime": runtime,
        }
    if not (test_mode or legacy_test_mode):
        raise ControlError("batch_not_found_use_new_batch")
    if "test" not in batch_id.casefold():
        raise ControlError("test_batch_id_required")

    # Test-only creation still uses the current source set. Normal resume above
    # intentionally avoids every mutable workspace configuration/cache read.
    safe_track(track)
    workspace_config()
    cache = ensure_cache(track)
    if test_mode:
        inputs = validate_preflight_inputs(track)
        records = [
            {"path": rel(item), "sha256": sha256(item), "size": item.stat().st_size}
            for item in inputs
        ]
        digest = hashlib.sha256()
        for record in records:
            digest.update(f"{record['path']}\0{record['sha256']}\0{record['size']}\n".encode())
        snapshot = {
            "schema_version": 1,
            "root": "inputs",
            "files": records,
            "aggregate_sha256": digest.hexdigest(),
        }
        manifest = {
            "schema_version": 2,
            "batch_id": batch_id,
            "track": track,
            "created_at": now(),
            "state": "Preflight",
            "input_snapshot": snapshot,
            "runtime": {
                "runtime_version": 2,
                "control_sha256": sha256(ROOT / "tools" / "jobseekctl"),
            },
            "policy": batch_policy(),
            "notes": "Test-only v2 batch.",
        }
    else:
        manifest = {
            "schema_version": 1,
            "batch_id": batch_id,
            "track": track,
            "created_at": now(),
            "state": "Preflight",
            "authority_hashes": cache["snapshot"].get("authority_hash", {}),
            "control_hashes": current_control_hashes(),
            "counter_start": {},
            "notes": "Legacy test-only batch; no private values or candidate facts.",
        }
    if not dry_run:
        path.parent.mkdir(parents=True, exist_ok=True)
        if test_mode:
            snapshot_manifest(path.parent, validate_preflight_inputs(track))
            manifest["input_snapshot"] = read_json(path.parent / "input_snapshot.json")
        atomic_json(path, manifest)
        (path.parent / "jobs").mkdir(exist_ok=True)
        (path.parent / "reports").mkdir(exist_ok=True)
    return {
        "batch_id": batch_id,
        "manifest": rel(path),
        "created": not dry_run,
        "would_create": dry_run,
        "cache_rebuilt": cache["rebuilt"],
        "snapshot_files": len(manifest.get("input_snapshot", {}).get("files", [])),
        "snapshot": cache["snapshot"],
        "missing_authority": cache["missing_authority"],
        "worker_runtime": (
            batch_runtime_context(path.parent, manifest) if not dry_run and test_mode else None
        ),
    }

def job_state(batch: Path, key: str) -> str | None:
    state = None
    for event in read_jsonl(batch / "events.jsonl"):
        if event.get("event_type") == "state_transition" and event.get("job_key") == key:
            state = event.get("to_state")
    return state


def packet_path(batch: Path, key: str) -> Path:
    return batch / "jobs" / key / "job_evidence_packet.json"


def packet_fact_ids(track: str) -> set[str]:
    ensure_cache(track)
    registry = read_json(CONTROL / "cache" / track / "candidate_fact_registry.json", {"items": []})
    return {item.get("id") for item in registry.get("items", []) if isinstance(item, dict) and isinstance(item.get("id"), str)}


def batch_fact_ids(batch: Path, track: str) -> set[str]:
    manifest = read_json(batch / "manifest.json", {})
    if manifest.get("schema_version", 1) < 2:
        compatibility = ensure_legacy_compatibility(batch, manifest, track, mutate=True)
        return {
            item["id"] for item in compatibility.get("candidate_facts", [])
            if isinstance(item, dict) and isinstance(item.get("id"), str)
        }
    sources = [
        (batch / "inputs" / "Profile" / "Candidate_Profile.md", "Profile/Candidate_Profile.md"),
        (batch / "inputs" / track / "Profile" / "Track_Profile.md", f"{track}/Profile/Track_Profile.md"),
    ]
    return {
        item["id"]
        for source, logical in sources
        for item in line_registry(source, "fact", logical)
    }


def require_string(value: Any, field: str) -> str:
    if not isinstance(value, str) or not value.strip():
        raise ControlError(f"packet_invalid_{field}")
    return value


def require_object(value: Any, field: str) -> dict[str, Any]:
    if not isinstance(value, dict):
        raise ControlError(f"packet_invalid_{field}")
    return value


def reject_sensitive_packet_keys(value: Any) -> None:
    """Reject sensitive keys recursively without inspecting ordinary text values."""
    if isinstance(value, dict):
        for key, child in value.items():
            if not isinstance(key, str):
                raise ControlError("packet_invalid_key")
            lowered = key.casefold()
            if lowered not in SAFE_PACKET_KEYS and any(token in lowered for token in SENSITIVE_PACKET_KEY_TOKENS):
                raise ControlError("packet_sensitive_key_rejected")
            reject_sensitive_packet_keys(child)
    elif isinstance(value, list):
        for child in value:
            reject_sensitive_packet_keys(child)


def require_exact_keys(
    value: Any,
    required: set[str],
    field: str,
    allowed: set[str] | None = None,
) -> dict[str, Any]:
    item = require_object(value, field)
    permitted = allowed if allowed is not None else required
    if required - set(item):
        raise ControlError(f"packet_missing_field_{field}")
    if set(item) - permitted:
        raise ControlError(f"packet_unexpected_field_{field}")
    return item


def validate_hard_exclusion_evaluations(
    value: Any,
    valid_facts: set[str],
    expected_rule_ids: list[str] | None = None,
) -> list[dict[str, Any]]:
    if not isinstance(value, list):
        raise ControlError("packet_invalid_hard_exclusion_evaluations")
    allowed = {
        "rule_id", "advertisement_evidence_location", "candidate_fact_id",
        "comparison_result", "classification_effect", "reason",
    }
    expected_effect = {"met": "none", "not_met": "Skipped", "unknown": "Needs Review"}
    evaluations: list[dict[str, Any]] = []
    seen: set[str] = set()
    for index, raw in enumerate(value):
        item = require_exact_keys(raw, allowed, f"hard_exclusion_evaluation_{index}")
        for field in ("rule_id", "advertisement_evidence_location", "candidate_fact_id",
                      "comparison_result", "classification_effect", "reason"):
            require_string(item.get(field), f"hard_exclusion_evaluation_{index}_{field}")
        rule_id = item["rule_id"]
        if rule_id in seen:
            raise ControlError("packet_duplicate_hard_exclusion_rule")
        seen.add(rule_id)
        if item["candidate_fact_id"] not in valid_facts:
            raise ControlError("packet_unknown_hard_exclusion_candidate_fact_id")
        comparison = item["comparison_result"]
        if comparison not in expected_effect:
            raise ControlError("packet_invalid_hard_exclusion_comparison")
        if item["classification_effect"] != expected_effect[comparison]:
            raise ControlError("packet_invalid_hard_exclusion_effect")
        evaluations.append(item)
    if expected_rule_ids is not None and set(seen) != set(expected_rule_ids):
        raise ControlError("packet_hard_exclusion_rule_coverage_mismatch")
    return evaluations


def validate_classification_inputs(
    value: Any,
    *,
    modern: bool = False,
    expected_threshold: int | float | None = None,
) -> dict[str, Any]:
    allowed = {
        "mechanical_terminal", "sensitive_review_required", "sensitive_reasons",
        "eligible_threshold", "referee_requirement",
    }
    item = require_exact_keys(
        value,
        allowed if modern else {"sensitive_review_required", "sensitive_reasons"},
        "classification_inputs",
        allowed,
    )
    if not isinstance(item.get("sensitive_review_required"), bool):
        raise ControlError("packet_invalid_sensitive_review_required")
    reasons = item.get("sensitive_reasons")
    if not isinstance(reasons, list) or not all(isinstance(reason, str) and reason.strip() for reason in reasons):
        raise ControlError("packet_invalid_sensitive_reasons")
    if item["sensitive_review_required"] != bool(reasons):
        raise ControlError("packet_inconsistent_sensitive_reasons")
    threshold = item.get("eligible_threshold", 70)
    if (
        isinstance(threshold, bool) or not isinstance(threshold, (int, float))
        or not 0 <= threshold <= 100
    ):
        raise ControlError("packet_invalid_eligible_threshold")
    if expected_threshold is not None and threshold != expected_threshold:
        raise ControlError("packet_eligible_threshold_snapshot_mismatch")
    mechanical = item.get("mechanical_terminal")
    if mechanical is not None and mechanical not in {"Duplicate", "Expired", "Withdrawn"}:
        raise ControlError("packet_invalid_mechanical_terminal")
    referee = item.get("referee_requirement")
    if referee is not None:
        referee = require_exact_keys(
            referee,
            {
                "requirement", "alternative_permitted", "authoritative_availability",
                "advertisement_evidence_location", "candidate_fact_id",
            },
            "referee_requirement",
        )
        if referee.get("requirement") not in {
            "none", "optional", "required_any_professional",
            "current_supervisor_preferred", "current_supervisor_mandatory", "ambiguous",
        }:
            raise ControlError("packet_invalid_referee_requirement")
        if referee.get("alternative_permitted") not in {"yes", "no", "unknown"}:
            raise ControlError("packet_invalid_referee_alternative")
        if referee.get("authoritative_availability") not in {"available", "unavailable", "unknown"}:
            raise ControlError("packet_invalid_referee_availability")
        require_string(
            referee.get("advertisement_evidence_location"),
            "referee_advertisement_evidence_location",
        )
        if not isinstance(referee.get("candidate_fact_id"), str):
            raise ControlError("packet_invalid_referee_candidate_fact_id")
    return item


def validate_audit(value: Any) -> dict[str, Any]:
    item = require_exact_keys(
        value,
        {"eligibility_required", "eligibility_triggers"},
        "audit",
    )
    triggers = item.get("eligibility_triggers")
    if not isinstance(triggers, list) or any(trigger not in ELIGIBILITY_AUDIT_TRIGGERS for trigger in triggers):
        raise ControlError("packet_invalid_eligibility_audit_triggers")
    if not isinstance(item.get("eligibility_required"), bool):
        raise ControlError("packet_invalid_eligibility_audit_required")
    if item["eligibility_required"] != bool(triggers):
        raise ControlError("packet_inconsistent_eligibility_audit")
    return item


def validate_review_requests(
    value: Any, key: str, *, modern: bool = False,
) -> list[dict[str, Any]]:
    if not isinstance(value, list):
        raise ControlError("packet_invalid_review_requests")
    result = []
    seen = set()
    for index, raw in enumerate(value):
        item = require_exact_keys(
            raw,
            {"review_type", "question_fingerprint", "allowed_decisions", "status", "decision"},
            f"review_request_{index}",
            {
                "review_type", "reason_id", "question_fingerprint",
                "allowed_decisions", "status", "decision",
                "unresolved_item_ids",
            },
        )
        review_type = item.get("review_type")
        if review_type not in REVIEW_TYPES:
            raise ControlError("packet_invalid_review_type")
        reason_id = review_reason_id(key, review_type, item.get("reason_id"))
        fingerprint = item.get("question_fingerprint")
        expected_fingerprint = question_fingerprint(
            key,
            review_type,
            reason_id if item.get("reason_id") is not None else None,
        )
        if (
            fingerprint != expected_fingerprint
            or reason_id in seen
            or fingerprint in seen
        ):
            raise ControlError("packet_invalid_or_duplicate_question_fingerprint")
        seen.update({reason_id, fingerprint})
        decisions = item.get("allowed_decisions")
        if (
            review_type == "continue_despite_experience_gap"
            and decisions != ["continue", "skip"]
        ):
            raise ControlError("experience_gap_review_continue_or_skip_only")
        if not isinstance(decisions, list) or not decisions or not all(isinstance(choice, str) for choice in decisions):
            raise ControlError("packet_invalid_review_decisions")
        legacy_decisions = {"remain_paused", "skip"}
        if modern and (
            set(decisions) != REVIEW_DECISIONS[review_type]
            and not (
                review_type in {
                    "unsupported_factual_answer",
                    "sensitive_declaration",
                    "document_request",
                }
                and set(decisions) == legacy_decisions
            )
        ):
            raise ControlError("packet_invalid_review_decisions")
        status = item.get("status")
        decision = item.get("decision")
        if status not in {
            "pending", "remain_paused", "resolved", "skipped",
        }:
            raise ControlError("packet_invalid_review_status")
        if status == "pending" and decision is not None:
            raise ControlError("packet_invalid_pending_review_decision")
        if status == "remain_paused" and decision != "remain_paused":
            raise ControlError("packet_invalid_paused_review_decision")
        if status == "resolved" and (
            decision not in decisions
            or decision in {"remain_paused", "skip"}
        ):
            raise ControlError("packet_invalid_resolved_review_decision")
        if status == "skipped" and decision != "skip":
            raise ControlError("packet_invalid_skipped_review_decision")
        unresolved_item_ids = item.get("unresolved_item_ids", [])
        if (
            not isinstance(unresolved_item_ids, list)
            or not all(
                isinstance(value, str) and value
                for value in unresolved_item_ids
            )
            or len(unresolved_item_ids) != len(set(unresolved_item_ids))
        ):
            raise ControlError("packet_invalid_review_unresolved_items")
        item["unresolved_item_ids"] = unresolved_item_ids
        result.append(item)
    return result


def validate_experience_gaps(value: Any, key: str, reviews: list[dict[str, Any]]) -> list[dict[str, Any]]:
    if not isinstance(value, list):
        raise ControlError("packet_invalid_experience_gaps")
    experience_reviews = {
        review["question_fingerprint"]: review
        for review in reviews
        if review["review_type"] == "continue_despite_experience_gap"
    }
    result = []
    for index, raw in enumerate(value):
        item = require_exact_keys(
            raw,
            {
                "requirement_id", "requirement_level", "evidence_status",
                "handling", "evidence_location", "candidate_fact_ids",
            },
            f"experience_gap_{index}",
            {
                "requirement_id", "requirement_level", "evidence_status",
                "handling", "evidence_location", "candidate_fact_ids",
                "question_fingerprint",
            },
        )
        require_string(item.get("requirement_id"), f"experience_gap_{index}_requirement_id")
        if item.get("requirement_level") not in {"mandatory", "preferred", "soft", "ambiguous"}:
            raise ControlError("packet_invalid_experience_requirement_level")
        if item.get("evidence_status") not in {"met", "not_met", "unsupported"}:
            raise ControlError("packet_invalid_experience_evidence_status")
        if item.get("handling") not in {
            "hard_exclusion", "scoring", "continue_despite_experience_gap", "none",
        }:
            raise ControlError("packet_invalid_experience_handling")
        require_string(item.get("evidence_location"), f"experience_gap_{index}_evidence_location")
        if not isinstance(item.get("candidate_fact_ids"), list) or not all(
            isinstance(fact_id, str) for fact_id in item["candidate_fact_ids"]
        ):
            raise ControlError("packet_invalid_experience_fact_ids")
        if item["requirement_level"] == "mandatory" and item["evidence_status"] == "not_met":
            if item["handling"] != "hard_exclusion":
                raise ControlError("mandatory_unmet_experience_must_be_hard_exclusion")
        if item["evidence_status"] == "unsupported" and item["requirement_level"] != "mandatory":
            if item["handling"] == "hard_exclusion":
                raise ControlError("unsupported_soft_experience_cannot_be_hard_exclusion")
        if item["handling"] == "continue_despite_experience_gap":
            review = experience_reviews.get(item.get("question_fingerprint"))
            if review is None:
                raise ControlError("experience_gap_review_request_required")
            reason_id = review_reason_id(
                key, review["review_type"], review.get("reason_id"),
            )
            expected = question_fingerprint(
                key,
                "continue_despite_experience_gap",
                reason_id if review.get("reason_id") is not None else None,
            )
            if item.get("question_fingerprint") != expected:
                raise ControlError("experience_gap_question_fingerprint_required")
        elif item.get("question_fingerprint") is not None:
            raise ControlError("unexpected_experience_gap_question_fingerprint")
        result.append(item)
    return result


def validate_packet(
    packet: Any,
    track: str,
    key: str,
    known_fact_ids: set[str] | None = None,
    *,
    modern: bool = False,
    assessment: dict[str, Any] | None = None,
) -> dict[str, Any]:
    if not isinstance(packet, dict) or PACKET_REQUIRED - set(packet):
        raise ControlError("packet_missing_required_fields")
    reject_sensitive_packet_keys(packet)
    if set(packet) - (PACKET_REQUIRED | PACKET_OPTIONAL):
        raise ControlError("packet_unexpected_root_field")
    if packet.get("schema_version") != 1 or packet.get("job_key") != key:
        raise ControlError("packet_identity_mismatch")
    if modern and "classification_inputs" not in packet:
        raise ControlError("packet_classification_inputs_required")
    metadata = require_exact_keys(
        packet.get("metadata"), {"track", "company", "role", "direct_url"}, "metadata",
        {"track", "company", "role", "direct_url", "canonical_identity", "source_url", "advertisement_url", "url_aliases"},
    )
    if metadata.get("track") != track:
        raise ControlError("packet_identity_mismatch")
    for field in ("company", "role", "direct_url"):
        require_string(metadata.get(field), f"metadata_{field}")
    for field in ("canonical_identity", "source_url", "advertisement_url"):
        if field in metadata:
            require_string(metadata[field], f"metadata_{field}")
    aliases = metadata.get("url_aliases", [])
    if not isinstance(aliases, list) or not all(isinstance(item, str) and item for item in aliases):
        raise ControlError("metadata_url_aliases_invalid")
    # Every URL in this packet is a declared identity alias.  Normalisation is
    # intentionally conservative: unknown query keys remain part of identity.
    for value in [metadata["direct_url"], *aliases]:
        canonical_url(value)
    advertisement = require_exact_keys(
        packet.get("advertisement"), set(), "advertisement",
        {"saved_text", "source_path", "snapshot_sha256"},
    )
    if "saved_text" not in advertisement and "source_path" not in advertisement:
        raise ControlError("packet_advertisement_source_required")
    if "saved_text" in advertisement:
        require_string(advertisement.get("saved_text"), "advertisement_saved_text")
    if "source_path" in advertisement:
        require_string(advertisement.get("source_path"), "advertisement_source_path")
    if "snapshot_sha256" in advertisement and not re.fullmatch(r"[a-f0-9]{64}", str(advertisement["snapshot_sha256"])):
        raise ControlError("packet_invalid_advertisement_snapshot_sha256")
    if not isinstance(packet.get("extracted_facts"), list):
        raise ControlError("packet_invalid_extracted_facts")
    for index, fact in enumerate(packet["extracted_facts"]):
        fact = require_exact_keys(fact, {"fact_id", "claim", "evidence_location"}, f"extracted_facts_{index}")
        for field in ("fact_id", "claim", "evidence_location"):
            require_string(fact.get(field), f"extracted_facts_{index}_{field}")
    if not isinstance(packet.get("candidate_fact_ids"), list) or not all(isinstance(item, str) for item in packet["candidate_fact_ids"]):
        raise ControlError("packet_invalid_candidate_fact_ids")
    valid_facts = known_fact_ids if known_fact_ids is not None else packet_fact_ids(track)
    if any(item not in valid_facts for item in packet["candidate_fact_ids"]):
        raise ControlError("packet_unknown_candidate_fact_id")
    duplicate = require_exact_keys(
        packet.get("duplicate_check"), {"result"}, "duplicate_check", {"result", "evidence"},
    )
    if not isinstance(duplicate.get("result"), str):
        raise ControlError("packet_invalid_duplicate_check")
    hard_exclusions = require_exact_keys(
        packet.get("hard_exclusions"),
        {"result", "evaluations"} if modern else {"result"},
        "hard_exclusions",
        {"result", "evidence", "evaluations"},
    )
    if not isinstance(hard_exclusions.get("result"), str): raise ControlError("packet_invalid_hard_exclusions")
    score = require_exact_keys(
        packet.get("score_breakdown"),
        {"total", "components"} if modern else {"total"},
        "score_breakdown",
        {"total", "components"},
    )
    if isinstance(score.get("total"), bool) or not isinstance(score.get("total"), (int, float)):
        raise ControlError("packet_invalid_score_breakdown")
    if not 0 <= score["total"] <= 100:
        raise ControlError("packet_invalid_score_total_range")
    components = score.get("components", [])
    if not isinstance(components, list) or (modern and not components):
        raise ControlError("packet_invalid_score_components")
    expected_components = {
        item["category"]: item["max_points"]
        for item in (assessment or {}).get("score_components", [])
    }
    seen_components: set[str] = set()
    component_total = 0.0
    for index, component in enumerate(components):
        component = require_exact_keys(component, {"category", "points", "evidence"}, f"score_component_{index}")
        category = require_string(component.get("category"), f"score_component_{index}_category")
        if category in seen_components:
            raise ControlError("packet_duplicate_score_component")
        seen_components.add(category)
        points = component.get("points")
        if isinstance(points, bool) or not isinstance(points, (int, float)):
            raise ControlError("packet_invalid_score_component_points")
        maximum = expected_components.get(category)
        if modern and (maximum is None or not 0 <= points <= maximum):
            raise ControlError("packet_invalid_score_component_range")
        if not modern and not 0 <= points <= 100:
            raise ControlError("packet_invalid_score_component_range")
        component_total += points
        require_string(component.get("evidence"), f"score_component_{index}_evidence")
    if modern and set(seen_components) != set(expected_components):
        raise ControlError("packet_score_component_coverage_mismatch")
    if components and abs(component_total - score["total"]) > 1e-9:
        raise ControlError("packet_score_components_total_mismatch")
    for field in ("risks", "unresolved_items", "artifact_paths"):
        if not isinstance(packet.get(field), list) or not all(isinstance(item, str) for item in packet[field]):
            raise ControlError(f"packet_invalid_{field}")
    if packet.get("classification") not in {
        "Eligible", "Skipped", "Needs Review", "Blocked",
        *MECHANICAL_CLASSIFICATIONS,
    }:
        raise ControlError("packet_invalid_classification")
    summary = packet.get("advertisement_summary")
    if summary is not None:
        summary = require_exact_keys(
            summary,
            {
                "canonical_identity", "mandatory_requirements", "preferred_requirements",
                "blockers", "sensitive_issues", "screening_risks", "role_summary",
                "material_keywords", "source_path",
            },
            "advertisement_summary",
        )
        for field in (
            "mandatory_requirements", "preferred_requirements", "blockers",
            "sensitive_issues", "screening_risks", "material_keywords",
        ):
            if not isinstance(summary.get(field), list) or not all(isinstance(item, str) for item in summary[field]):
                raise ControlError(f"packet_invalid_advertisement_summary_{field}")
        for field in ("canonical_identity", "role_summary", "source_path"):
            require_string(summary.get(field), f"advertisement_summary_{field}")
    audit = validate_audit(packet.get("audit", {
        "eligibility_required": False, "eligibility_triggers": [],
    }))
    reviews = validate_review_requests(
        packet.get("review_requests", []), key, modern=modern,
    )
    unresolved_values = set(packet.get("unresolved_items", []))
    if any(
        unresolved_id not in unresolved_values
        for review in reviews
        for unresolved_id in review.get("unresolved_item_ids", [])
    ):
        raise ControlError("review_unknown_unresolved_item")
    experience_gaps = validate_experience_gaps(packet.get("experience_gaps", []), key, reviews)
    if not isinstance(packet.get("reason_codes", []), list) or not all(
        isinstance(reason, str) and reason.strip() for reason in packet.get("reason_codes", [])
    ):
        raise ControlError("packet_invalid_reason_codes")
    evaluations: list[dict[str, Any]] | None = None
    if "evaluations" in hard_exclusions:
        evaluations = validate_hard_exclusion_evaluations(
            hard_exclusions["evaluations"],
            valid_facts,
            (assessment or {}).get("hard_exclusion_rules") if modern else None,
        )
    if "classification_inputs" in packet:
        expected_threshold = (assessment or {}).get("eligible_threshold") if modern else None
        inputs = validate_classification_inputs(
            packet["classification_inputs"],
            modern=modern,
            expected_threshold=expected_threshold,
        )
        if evaluations is None:
            raise ControlError("packet_structured_hard_exclusions_required")
        try:
            reduced = reduce_classification({
                "mechanical_terminal": inputs.get("mechanical_terminal"),
                "hard_exclusions": evaluations,
                "referee_requirement": inputs.get("referee_requirement"),
                "sensitive_review_required": inputs["sensitive_review_required"],
                "score_total": score["total"],
                "eligible_threshold": inputs.get("eligible_threshold", 70),
            })
        except ClassificationError as exc:
            raise ControlError(f"packet_invalid_classification_signals:{exc}") from exc
        pending_experience_reviews = [
            review for review in reviews
            if review["review_type"] == "continue_despite_experience_gap"
            and review["status"] in {"pending", "remain_paused"}
        ]
        pure_experience_review = (
            bool(pending_experience_reviews)
            and len(pending_experience_reviews) == len([
                review for review in reviews
                if review["status"] in {"pending", "remain_paused"}
            ])
            and all(
                any(
                    gap.get("question_fingerprint")
                    == review["question_fingerprint"]
                    and gap["requirement_level"] != "mandatory"
                    and gap["handling"] == "continue_despite_experience_gap"
                    for gap in experience_gaps
                )
                for review in pending_experience_reviews
            )
            and all(
                gap["requirement_level"] != "mandatory"
                and gap["handling"] == "continue_despite_experience_gap"
                for gap in experience_gaps
                if gap.get("question_fingerprint") in {
                    review["question_fingerprint"]
                    for review in pending_experience_reviews
                }
            )
        )
        expected_classification = reduced["classification"]
        if (
            modern
            and (pure_experience_review or any(
                review["status"] in {"pending", "remain_paused"}
                for review in reviews
            ))
            and expected_classification in {"Eligible", "Skipped"}
        ):
            expected_classification = "Needs Review"
        if packet["classification"] != expected_classification:
            raise ControlError("packet_classification_priority_mismatch")
        if modern:
            expected_hard_result = (
                "hard_exclusion_confirmed"
                if any(item["comparison_result"] == "not_met" for item in evaluations)
                else "unknown"
                if any(item["comparison_result"] == "unknown" for item in evaluations)
                else "none"
            )
            if hard_exclusions["result"] != expected_hard_result:
                raise ControlError("packet_hard_exclusion_result_mismatch")
        referee = inputs.get("referee_requirement")
        if referee is not None and referee["candidate_fact_id"] not in valid_facts:
            raise ControlError("packet_unknown_referee_candidate_fact_id")
        if (
            reduced.get("reason_code") == "mandatory_current_supervisor_unavailable"
            and "mandatory_current_supervisor_unavailable" not in packet.get("reason_codes", [])
        ):
            raise ControlError("packet_referee_blocker_reason_code_required")
    elif evaluations is not None:
        raise ControlError("packet_classification_inputs_required")
    hard_exclusion_rule_ids = {
        evaluation["rule_id"] for evaluation in (evaluations or [])
        if evaluation["comparison_result"] == "not_met"
    }
    for gap in experience_gaps:
        if (
            gap["requirement_level"] == "mandatory"
            and gap["evidence_status"] == "not_met"
            and gap["requirement_id"] not in hard_exclusion_rule_ids
        ):
            raise ControlError("mandatory_unmet_experience_exclusion_evaluation_required")
        if any(fact_id not in valid_facts for fact_id in gap["candidate_fact_ids"]):
            raise ControlError("packet_unknown_experience_candidate_fact_id")
    pending_reviews = [
        review for review in reviews
        if review["status"] in {"pending", "remain_paused"}
    ]
    if pending_reviews and packet["classification"] != "Needs Review":
        raise ControlError("pending_review_requires_needs_review")
    if audit["eligibility_required"] and packet["classification"] not in {"Eligible", "Needs Review"}:
        raise ControlError("eligibility_audit_not_applicable")
    if not isinstance(packet.get("supported_inferences"), list):
        raise ControlError("packet_invalid_supported_inferences")
    seen_inferences: set[str] = set()
    required_inference_fields = ("inference_id", "application_question", "candidate_fact_ids", "inferred_capability",
                                 "equivalence_reason", "applicable_scope", "prohibited_exaggeration_boundary", "exact_answer")
    for index, inference in enumerate(packet["supported_inferences"]):
        inference = require_exact_keys(inference, set(required_inference_fields), f"supported_inferences_{index}")
        inference_id = require_string(inference.get("inference_id"), f"supported_inferences_{index}_inference_id")
        if not re.fullmatch(r"inference-[a-z0-9][a-z0-9._-]{2,119}", inference_id) or inference_id in seen_inferences:
            raise ControlError("packet_invalid_inference_id")
        seen_inferences.add(inference_id)
        for field in required_inference_fields:
            if field == "candidate_fact_ids":
                refs = inference.get(field)
                if not isinstance(refs, list) or not refs or not all(isinstance(item, str) and item in valid_facts for item in refs):
                    raise ControlError("packet_invalid_inference_fact_references")
            else:
                require_string(inference.get(field), f"supported_inferences_{index}_{field}")
    return packet


def load_valid_packet(batch: Path, track: str, key: str) -> tuple[dict[str, Any], str, Path]:
    path = packet_path(batch, key)
    if not path.exists():
        raise ControlError("job_evidence_packet_required")
    manifest = read_json(batch / "manifest.json", {})
    modern = manifest.get("schema_version", 1) >= 2
    return validate_packet(
        read_json(path),
        track,
        key,
        batch_fact_ids(batch, track),
        modern=modern,
        assessment=batch_assessment_policy(batch, manifest) if modern else None,
    ), sha256(path), path


def evidence_reference(batch: Path, value: str) -> dict[str, str]:
    path = public_workspace_path(value)
    if batch not in path.parents or not path.is_file():
        raise ControlError("invalid_evidence_reference")
    return {"path": rel(path), "sha256": sha256(path)}


def eligibility_trigger_snapshot(
    batch: Path,
    key: str,
    packet: dict[str, Any] | None = None,
) -> dict[str, Any]:
    """Replay immutable trigger IDs and audit coverage for the current packet."""
    records: list[dict[str, Any]] = []
    trigger_events = [
        event for event in read_jsonl(batch / "events.jsonl")
        if event.get("event_type") == "eligibility_audit_trigger"
        and event.get("job_key") == key
    ]
    for index, event in enumerate(trigger_events, 1):
        trigger_id = event.get("trigger_id")
        if not isinstance(trigger_id, str) or not trigger_id:
            trigger_id = f"legacy-trigger-{index}-{event.get('trigger', 'unknown')}"
        version = event.get("trigger_version")
        if not isinstance(version, int) or version < 1:
            version = index
        records.append({
            "trigger_id": trigger_id,
            "trigger": event.get("trigger"),
            "trigger_version": version,
            "evidence_sha256": (
                event.get("evidence", {}).get("sha256")
                if isinstance(event.get("evidence"), dict) else None
            ),
        })
    if isinstance(packet, dict):
        audit = packet.get("audit")
        trigger_types = audit.get("eligibility_triggers", []) if isinstance(audit, dict) else []
        existing_ids = {item["trigger_id"] for item in records}
        for index, trigger in enumerate(trigger_types, 1):
            if not isinstance(trigger, str) or not trigger:
                continue
            trigger_id = f"legacy-packet-trigger-{index}-{trigger}"
            if trigger_id in existing_ids:
                continue
            records.append({
                "trigger_id": trigger_id,
                "trigger": trigger,
                # Packet-native triggers occupy their own stable version range;
                # event trigger versions remain append-only and independent.
                "trigger_version": index,
                "evidence_sha256": None,
            })
            existing_ids.add(trigger_id)
    all_ids = [item["trigger_id"] for item in records]
    versions = [item["trigger_version"] for item in records]
    covered: set[str] = set()
    for event in read_jsonl(batch / "events.jsonl"):
        if (
            event.get("event_type") != "eligibility_audit_resolution"
            or event.get("job_key") != key
            or event.get("result") not in {"pass", "pass_with_warnings"}
            or event.get("outcome") != "Eligible"
        ):
            continue
        ids = event.get("covered_trigger_ids") or event.get("eligibility_trigger_ids")
        if isinstance(ids, list) and all(isinstance(item, str) for item in ids):
            covered.update(ids)
        elif not trigger_events:
            # Legacy packet-only audit events had no IDs; their coverage is
            # limited to the packet trigger set at the time of the audit.
            covered.update(all_ids)
    unresolved = [trigger_id for trigger_id in all_ids if trigger_id not in covered]
    return {
        "trigger_ids": sorted(all_ids),
        "unresolved_trigger_ids": sorted(unresolved),
        "covered_trigger_ids": sorted(covered & set(all_ids)),
        "trigger_version": max(versions, default=0),
    }


def gate_event(
    batch: Path,
    key: str,
    gate_type: str,
    packet_hash: str,
    submission_attempt_id: str | None = None,
) -> dict[str, Any] | None:
    for event in reversed(read_jsonl(batch / "events.jsonl")):
        if event.get("event_type") != "gate" or event.get("job_key") != key or event.get("gate_type") != gate_type:
            continue
        if (
            submission_attempt_id is not None
            and event.get("submission_attempt_id") != submission_attempt_id
        ):
            continue
        evidence = event.get("evidence", {})
        if gate_type in {"eligibility_audit", "confirmation_audit"} and event.get("compatibility_alias") == "record-gate":
            continue
        if event.get("result") == "pass" and event.get("packet_sha256") == packet_hash and isinstance(evidence, dict):
            if gate_type == "eligibility_audit":
                packet = read_json(packet_path(batch, key), {})
                trigger_snapshot = eligibility_trigger_snapshot(batch, key, packet)
                stored_ids = event.get("eligibility_trigger_ids")
                stored_version = event.get("eligibility_trigger_version")
                if event.get("compatibility_alias") == "record-gate":
                    continue
                if trigger_snapshot["unresolved_trigger_ids"]:
                    continue
                if trigger_snapshot["trigger_ids"] and (
                    not isinstance(stored_ids, list)
                    or sorted(stored_ids) != trigger_snapshot["trigger_ids"]
                    or stored_version != trigger_snapshot["trigger_version"]
                ):
                    continue
            try:
                path = public_workspace_path(evidence.get("path", ""))
                if path.is_file() and sha256(path) == evidence.get("sha256"):
                    return event
            except ControlError:
                pass
    return None


def require_gate(
    batch: Path,
    key: str,
    gate_type: str,
    packet_hash: str,
    submission_attempt_id: str | None = None,
) -> None:
    if gate_event(
        batch, key, gate_type, packet_hash, submission_attempt_id,
    ) is None:
        raise ControlError(f"{gate_type}_pass_required")


def packet_requires_eligibility_audit(
    packet: dict[str, Any], batch: Path | None = None, key: str | None = None,
) -> bool:
    audit = packet.get("audit")
    packet_required = isinstance(audit, dict) and audit.get("eligibility_required")
    if batch is None or key is None:
        return bool(packet_required)
    snapshot = eligibility_trigger_snapshot(batch, key, packet)
    return bool(packet_required or snapshot["trigger_ids"]) and bool(
        snapshot["unresolved_trigger_ids"]
        or not any(
            event.get("event_type") == "eligibility_audit_resolution"
            and event.get("job_key") == key
            and event.get("outcome") == "Eligible"
            and event.get("result") in {"pass", "pass_with_warnings"}
            for event in read_jsonl(batch / "events.jsonl")
        )
    )


def eligibility_gate_required(
    packet: dict[str, Any], batch: Path, key: str,
) -> bool:
    audit = packet.get("audit")
    if isinstance(audit, dict) and audit.get("eligibility_required"):
        return True
    return any(
        event.get("event_type") in {
            "eligibility_audit_trigger", "eligibility_audit_resolution",
        }
        and event.get("job_key") == key
        for event in read_jsonl(batch / "events.jsonl")
    )


def latest_review_resolutions(
    batch: Path, key: str,
) -> dict[str, dict[str, Any]]:
    resolutions: dict[str, dict[str, Any]] = {}
    for event in read_jsonl(batch / "events.jsonl"):
        if (
            event.get("event_type") == "eligibility_resolution"
            and event.get("job_key") == key
            and isinstance(event.get("reason_id"), str)
        ):
            resolutions[event["reason_id"]] = event
        elif (
            event.get("event_type") == "user_decision"
            and event.get("job_key") == key
            and isinstance(
                event.get("reason_id")
                or event.get("question_fingerprint"),
                str,
            )
        ):
            reason_id = (
                event.get("reason_id")
                or event.get("question_fingerprint")
            )
            resolutions[reason_id] = {
                **event,
                "resolution_status": (
                    "skipped"
                    if event.get("decision") == "skip"
                    else "remain_paused"
                    if event.get("decision") == "remain_paused"
                    else "resolved"
                ),
            }
    return resolutions


def latest_resolution_decisions(
    batch: Path, key: str,
) -> dict[str, str]:
    return {
        reason_id: event.get("decision")
        for reason_id, event in latest_review_resolutions(batch, key).items()
    }


def job_review_reasons(
    batch: Path,
    key: str,
    packet: dict[str, Any],
) -> list[dict[str, Any]]:
    reasons = [dict(item) for item in packet.get("review_requests", [])]
    seen = {
        review_reason_id(key, item["review_type"], item.get("reason_id"))
        for item in reasons
    }
    for event in read_jsonl(batch / "events.jsonl"):
        if (
            event.get("event_type") != "review_reason_added"
            or event.get("job_key") != key
        ):
            continue
        reason_id = event.get("reason_id")
        if not isinstance(reason_id, str) or reason_id in seen:
            continue
        reasons.append({
            "review_type": event.get("review_type"),
            "reason_id": reason_id,
            "question_fingerprint": event.get("question_fingerprint"),
            "allowed_decisions": event.get("allowed_decisions", []),
            "status": "pending",
            "decision": None,
            "unresolved_item_ids": event.get("unresolved_item_ids", []),
        })
        seen.add(reason_id)
    return reasons


def eligibility_audit_resolutions(
    batch: Path, key: str,
) -> list[dict[str, Any]]:
    return [
        event for event in read_jsonl(batch / "events.jsonl")
        if event.get("event_type") == "eligibility_audit_resolution"
        and event.get("job_key") == key
    ]


def eligibility_audit_overlay_applies(
    overlay: dict[str, Any],
    trigger_snapshot: dict[str, Any],
    packet_hash: str | None,
) -> bool:
    """Return whether one audit overlay covers the current audit generation."""
    if overlay.get("packet_sha256") not in {None, packet_hash}:
        return False
    trigger_ids = trigger_snapshot["trigger_ids"]
    if not trigger_ids:
        return True
    covered_ids = overlay.get("covered_trigger_ids") or overlay.get(
        "eligibility_trigger_ids"
    )
    if isinstance(covered_ids, list) and all(
        isinstance(item, str) for item in covered_ids
    ):
        packet_only = all(
            trigger_id.startswith("legacy-packet-trigger-")
            for trigger_id in trigger_ids
        )
        return (
            sorted(set(covered_ids)) == trigger_ids
            and (
                overlay.get("eligibility_trigger_version")
                == trigger_snapshot["trigger_version"]
                or (
                    overlay.get("eligibility_trigger_version") is None
                    and packet_only
                )
            )
        )
    # Compatibility for packet-only legacy audits. Once an event trigger exists,
    # an old unversioned overlay must not remain authoritative.
    return all(
        trigger_id.startswith("legacy-packet-trigger-")
        for trigger_id in trigger_ids
    )


def current_eligibility_audit_resolution(
    batch: Path,
    key: str,
    packet: dict[str, Any],
    proposed_audit: dict[str, Any] | None = None,
) -> dict[str, Any] | None:
    """Return only the latest overlay for the current trigger generation."""
    packet_hash = (
        sha256(packet_path(batch, key))
        if packet_path(batch, key).exists()
        else None
    )
    snapshot = eligibility_trigger_snapshot(batch, key, packet)
    overlays = eligibility_audit_resolutions(batch, key)
    if proposed_audit is not None:
        overlays = [*overlays, proposed_audit]
    applicable = [
        overlay for overlay in overlays
        if eligibility_audit_overlay_applies(overlay, snapshot, packet_hash)
    ]
    return applicable[-1] if applicable else None


def effective_review_resolution(
    batch: Path, key: str, packet: dict[str, Any],
    proposed: dict[str, str] | None = None,
    proposed_audit: dict[str, Any] | None = None,
) -> dict[str, Any]:
    """Pure reduction of valid review/audit overlays for one packet.

    Immutable packet items are never changed.  This is the sole authority for
    whether an item/reason has been resolved by an event in its proper scope.
    """
    packet_hash = sha256(packet_path(batch, key)) if packet_path(batch, key).exists() else None
    reasons = job_review_reasons(batch, key, packet)
    by_id = {
        review_reason_id(key, item["review_type"], item.get("reason_id")): item
        for item in reasons
    }
    resolutions = latest_review_resolutions(batch, key)
    for reason_id, decision in (proposed or {}).items():
        resolutions[reason_id] = {"decision": decision, "resolution_status": (
            "skipped" if decision == "skip" else "remain_paused"
            if decision == "remain_paused" else "resolved")}
    resolved_reasons: set[str] = set()
    skipped = False
    for reason_id, resolution in resolutions.items():
        reason = by_id.get(reason_id)
        if reason is None:
            continue
        # A modern overlay must be the lead-created record for this exact
        # packet.  Older user_decision events remain compatibility input.
        if resolution.get("event_type") == "eligibility_resolution" and (
            resolution.get("actor") != "lead"
            or resolution.get("packet_sha256") != packet_hash
        ):
            continue
        if resolution.get("decision") == "skip":
            skipped = True
        if resolution.get("resolution_status") == "resolved" or resolution.get("decision") in {"continue", "resolve"}:
            resolved_reasons.add(reason_id)

    resolved_items: set[str] = set()
    for reason_id in resolved_reasons:
        resolved_items.update(by_id[reason_id].get("unresolved_item_ids", []))
    resolved_hard_rules: set[str] = set()
    resolved_blockers: set[str] = set()
    overlay = current_eligibility_audit_resolution(
        batch, key, packet, proposed_audit,
    )
    if overlay and overlay.get("result") in {"pass", "pass_with_warnings"}:
        audit_reason_ids = set(overlay.get("resolved_reason_ids", []))
        # Fail closed for historical and alternate-path audit attempts to
        # resolve user-exclusive questions, including their mapped items.
        if any(
            by_id.get(reason_id, {}).get("review_type") in USER_EXCLUSIVE_REVIEW_TYPES
            for reason_id in audit_reason_ids
        ):
            audit_reason_ids = {
                reason_id for reason_id in audit_reason_ids
                if by_id.get(reason_id, {}).get("review_type") not in USER_EXCLUSIVE_REVIEW_TYPES
            }
        resolved_hard_rules.update(overlay.get("resolved_hard_exclusion_rules", []))
        resolved_blockers.update(overlay.get("resolved_blocker_ids", []))
        # An audit can resolve only packet items not owned by a user-exclusive
        # review; unrelated items remain independently unresolved.
        user_items = {
            item for reason_id, reason in by_id.items()
            if reason.get("review_type") in USER_EXCLUSIVE_REVIEW_TYPES
            for item in reason.get("unresolved_item_ids", [])
        }
        resolved_items.update(
            item for item in overlay.get("resolved_unresolved_items", [])
            if item not in user_items
        )
        # Do not permit an audit to mark the user-exclusive reason itself.
        resolved_reasons.update(audit_reason_ids)
    effective_items = [
        item for item in packet.get("unresolved_items", []) if item not in resolved_items
    ]
    return {
        "reasons": by_id, "resolved_reason_ids": resolved_reasons,
        "effective_unresolved_items": effective_items,
        "resolved_hard_rules": resolved_hard_rules,
        "resolved_blockers": resolved_blockers, "skipped": skipped,
    }


def effective_unresolved_items(batch: Path, key: str, packet: dict[str, Any]) -> list[str]:
    return effective_review_resolution(batch, key, packet)["effective_unresolved_items"]


def packet_effective_classification(
    batch: Path,
    key: str,
    packet: dict[str, Any],
    proposed: dict[str, str] | None = None,
    proposed_audit: dict[str, Any] | None = None,
) -> str:
    audit_resolution = current_eligibility_audit_resolution(
        batch, key, packet, proposed_audit,
    )
    if audit_resolution and audit_resolution.get("outcome") in {
        "Skipped", "Blocked",
    }:
        return audit_resolution["outcome"]
    if packet.get("classification") in {
        "Skipped", "Blocked", *MECHANICAL_CLASSIFICATIONS,
    }:
        return packet["classification"]
    effective_resolution = effective_review_resolution(
        batch, key, packet, proposed, proposed_audit,
    )
    if effective_resolution["skipped"]:
            return "Skipped"
    resolved_reason_ids = effective_resolution["resolved_reason_ids"]
    resolved_hard_rules = effective_resolution["resolved_hard_rules"]
    resolved_blockers = effective_resolution["resolved_blockers"]
    review_reasons = job_review_reasons(batch, key, packet)
    for reason in review_reasons:
        reason_id = review_reason_id(
            key, reason["review_type"], reason.get("reason_id"),
        )
        if reason.get("status") == "skipped":
            return "Skipped"
        if reason.get("status") == "resolved":
            resolved_reason_ids.add(reason_id)
    inputs = packet.get("classification_inputs", {})
    evaluations = packet.get("hard_exclusions", {}).get("evaluations", [])
    if any(
        item.get("comparison_result") == "unknown"
        and item.get("rule_id") not in resolved_hard_rules
        for item in evaluations
    ):
        return "Needs Review"
    sensitive_reasons = [
        reason for reason in review_reasons
        if reason["review_type"] == "sensitive_declaration"
    ]
    if (
        inputs.get("sensitive_review_required")
        and "sensitive-review" not in resolved_blockers
        and (
            not sensitive_reasons
            or any(
            reason["review_type"] == "sensitive_declaration"
            and review_reason_id(
                key, reason["review_type"], reason.get("reason_id"),
            ) not in resolved_reason_ids
            for reason in sensitive_reasons
            )
        )
    ):
        return "Needs Review"
    try:
        referee_result = reduce_referee_requirement(
            inputs.get("referee_requirement"),
            ambiguity_resolved="referee-ambiguity" in resolved_blockers,
        )
    except ClassificationError as exc:
        raise ControlError(str(exc)) from exc
    if referee_result is not None:
        return str(referee_result["classification"])
    if effective_resolution["effective_unresolved_items"]:
        return "Needs Review"
    for review in review_reasons:
        reason_id = review_reason_id(
            key, review["review_type"], review.get("reason_id"),
        )
        resolution = latest_review_resolutions(batch, key).get(reason_id, {})
        decision = review.get("decision")
        status = review.get("status")
        if resolution:
            decision = resolution.get("decision")
            status = resolution.get("resolution_status")
        if reason_id in resolved_reason_ids:
            status = "resolved"
        if review.get("review_type") == "continue_despite_experience_gap":
            if status != "resolved" or decision != "continue":
                return "Needs Review"
        elif status != "resolved":
            return "Needs Review"
    manifest = read_json(batch / "manifest.json", {})
    threshold = packet_eligible_threshold(batch, manifest, packet)
    return (
        "Eligible"
        if packet["score_breakdown"]["total"]
        >= threshold
        else "Skipped"
    )


def packet_effectively_eligible(batch: Path, key: str, packet: dict[str, Any]) -> bool:
    return packet_effective_classification(batch, key, packet) == "Eligible"


def packet_eligible_threshold(
    batch: Path,
    manifest: dict[str, Any],
    packet: dict[str, Any],
) -> int | float:
    if manifest.get("schema_version", 1) >= 2:
        return batch_assessment_policy(batch, manifest)["eligible_threshold"]
    return packet.get("classification_inputs", {}).get("eligible_threshold", 70)


def current_submission_attempt(batch: Path, key: str) -> str:
    events = read_jsonl(batch / "events.jsonl")
    submitted_index = next((
        index for index in range(len(events) - 1, -1, -1)
        if events[index].get("event_type") == "state_transition"
        and events[index].get("job_key") == key
        and events[index].get("to_state") == "Submitted"
    ), None)
    if submitted_index is None:
        raise ControlError("submitted_attempt_required")
    submitted = events[submitted_index]
    attempt_id = submitted.get("submission_attempt_id")
    if isinstance(attempt_id, str) and attempt_id:
        return attempt_id
    ordinal = sum(
        event.get("event_type") == "state_transition"
        and event.get("job_key") == key
        and event.get("to_state") == "Submitted"
        for event in events[:submitted_index + 1]
    )
    # This must exactly match submission_attempt_lifecycle() replay so a
    # confirmation appended by new code closes the original v1 Submitted event.
    return f"legacy-state-{key}-{ordinal}"

def post_submit_attempt_state(
    batch: Path, key: str,
) -> tuple[str, str] | None:
    """Return the current attempt and state for Submitted or legacy post-submit Blocked."""
    current = job_state(batch, key)
    if current == "Submitted":
        return current, current_submission_attempt(batch, key)
    if current != "Blocked":
        return None
    latest = next((
        event for event in reversed(read_jsonl(batch / "events.jsonl"))
        if event.get("event_type") == "state_transition"
        and event.get("job_key") == key
        and event.get("to_state") == "Blocked"
    ), None)
    if not latest or latest.get("from_state") != "Submitted":
        return None
    attempt_id = latest.get("submission_attempt_id")
    if not isinstance(attempt_id, str) or not attempt_id:
        attempt_id = current_submission_attempt(batch, key)
    return current, attempt_id


def confirmation_assessment_event(
    batch: Path,
    key: str,
    submission_attempt_id: str | None = None,
) -> dict[str, Any] | None:
    for event in reversed(read_jsonl(batch / "events.jsonl")):
        event_attempt_id = event.get("submission_attempt_id")
        attempt_matches = (
            submission_attempt_id is None
            or event_attempt_id == submission_attempt_id
            or (
                submission_attempt_id.startswith("legacy-")
                and event_attempt_id is None
            )
        )
        if (
            event.get("event_type") == "confirmation_assessment"
            and event.get("job_key") == key
            and attempt_matches
        ):
            return event
    return None


def confirmation_audit_result_event(
    batch: Path,
    key: str,
    submission_attempt_id: str,
) -> dict[str, Any] | None:
    return next((
        event for event in reversed(read_jsonl(batch / "events.jsonl"))
        if event.get("event_type") == "confirmation_audit_result"
        and event.get("job_key") == key
        and event.get("submission_attempt_id") == submission_attempt_id
        and event.get("compatibility_alias") != "record-gate"
    ), None)


def require_confirmation_gate(
    batch: Path,
    key: str,
    packet_hash: str,
    submission_attempt_id: str,
) -> None:
    audit_result = confirmation_audit_result_event(
        batch, key, submission_attempt_id,
    )
    if (
        audit_result
        and audit_result.get("result") == "verified"
        and gate_event(
            batch, key, "confirmation_audit", packet_hash,
            submission_attempt_id,
        )
    ):
        return
    event = confirmation_assessment_event(
        batch, key, submission_attempt_id,
    )
    if (
        event
        and event.get("result") == "unambiguous"
        and event.get("packet_sha256") == packet_hash
        and not event.get("audit_required")
        and (
            event.get("submission_attempt_id") == submission_attempt_id
            or (
                submission_attempt_id.startswith("legacy-")
                and event.get("submission_attempt_id") is None
            )
        )
    ):
        evidence = event.get("evidence", {})
        if isinstance(evidence, dict):
            try:
                path = public_workspace_path(evidence.get("path", ""))
                if path.is_file() and sha256(path) == evidence.get("sha256"):
                    return
            except ControlError:
                pass
    raise ControlError("submission_confirmation_required")


