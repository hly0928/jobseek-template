def safe_track(track: str) -> str:
    if not isinstance(track, str) or not re.fullmatch(r"[A-Za-z][A-Za-z0-9_-]{0,39}", track):
        raise ControlError("unknown_track")
    runtime_track = os.environ.get("JOBSEEK_BATCH_TRACK")
    if runtime_track == track:
        return track
    manifest = requested_batch_manifest()
    if isinstance(manifest, dict) and manifest.get("track") == track:
        return track
    if track not in track_configurations():
        raise ControlError("unknown_track")
    return track


def workspace_config() -> dict[str, Any]:
    config = read_json(CONFIG_PATH)
    if not isinstance(config, dict) or config.get("schema_version") != 1:
        raise ControlError("invalid_workspace_config")
    limits = config.get("limits")
    stops = config.get("stop_conditions")
    tracks = config.get("tracks")
    if not all(isinstance(item, dict) for item in (limits, stops, tracks)):
        raise ControlError("invalid_workspace_config")
    required_limits = {
        "max_active_workers", "max_discovery_workers", "max_total_agent_calls",
        "max_job_role_attempts", "max_consecutive_no_yield_calls",
        "card_observation_limit", "per_fingerprint_round_limit",
    }
    required_stops = {
        "verified_submissions", "fully_assessed_ads",
        "consecutive_submission_failures", "manual_takeover_sites",
    }
    for name in required_limits:
        if isinstance(limits.get(name), bool) or not isinstance(limits.get(name), int) or limits[name] < 1:
            raise ControlError(f"invalid_workspace_config_limit:{name}")
    for name in required_stops:
        if isinstance(stops.get(name), bool) or not isinstance(stops.get(name), int) or stops[name] < 1:
            raise ControlError(f"invalid_workspace_config_stop:{name}")
    if limits["max_discovery_workers"] > limits["max_active_workers"]:
        raise ControlError("invalid_workspace_config_worker_limits")
    for track, value in tracks.items():
        if (
            not isinstance(value, dict)
            or not isinstance(value.get("input_paths"), list)
            or not isinstance(value.get("assessment"), dict)
        ):
            raise ControlError(f"invalid_track_config:{track}")
        if not value["input_paths"] or not all(isinstance(path, str) and path for path in value["input_paths"]):
            raise ControlError(f"invalid_track_config:{track}")
        assessment = value["assessment"]
        threshold = assessment.get("eligible_threshold")
        rules = assessment.get("hard_exclusion_rules")
        definitions = assessment.get("hard_exclusion_definitions")
        components = assessment.get("score_components")
        if isinstance(threshold, bool) or not isinstance(threshold, (int, float)) or not 0 <= threshold <= 100:
            raise ControlError(f"invalid_track_eligible_threshold:{track}")
        legacy_runtime_config = isinstance(config.get("legacy_runtime_notice"), str)
        if (
            not isinstance(rules, list)
            or (not rules and not legacy_runtime_config)
            or not all(isinstance(rule, str) and rule.strip() for rule in rules)
            or len(rules) != len(set(rules))
        ):
            raise ControlError(f"invalid_track_hard_exclusion_rules:{track}")
        if (
            not isinstance(definitions, dict)
            or set(definitions) != set(rules)
            or not all(
                isinstance(rule_id, str)
                and isinstance(definition, str)
                and definition.strip()
                for rule_id, definition in definitions.items()
            )
        ):
            raise ControlError(f"invalid_track_hard_exclusion_definitions:{track}")
        if not isinstance(components, list) or not components:
            raise ControlError(f"invalid_track_score_components:{track}")
        categories = []
        for component in components:
            if not isinstance(component, dict) or set(component) != {"category", "max_points"}:
                raise ControlError(f"invalid_track_score_components:{track}")
            category = component.get("category")
            maximum = component.get("max_points")
            if (
                not isinstance(category, str) or not category.strip()
                or isinstance(maximum, bool) or not isinstance(maximum, (int, float))
                or maximum <= 0 or maximum > 100
            ):
                raise ControlError(f"invalid_track_score_components:{track}")
            categories.append(category)
        if len(categories) != len(set(categories)) or sum(item["max_points"] for item in components) != 100:
            raise ControlError(f"invalid_track_score_components:{track}")
    return config


def track_configurations() -> dict[str, Any]:
    config = read_json(CONFIG_PATH, {})
    tracks = config.get("tracks") if isinstance(config, dict) else None
    return tracks if isinstance(tracks, dict) else {track: {} for track in TRACKS}


def batch_policy(manifest: dict[str, Any] | None = None) -> dict[str, Any]:
    if manifest is None:
        config = workspace_config()
        return {"limits": json.loads(json.dumps(config["limits"])),
                "stop_conditions": json.loads(json.dumps(config["stop_conditions"]))}
    if isinstance(manifest, dict) and manifest.get("schema_version", 1) >= 2:
        batch_id = manifest.get("batch_id")
        if isinstance(batch_id, str):
            frozen = read_json(batch_dir(batch_id) / "inputs" / ".jobseek" / "config.json")
            if isinstance(frozen, dict):
                expected = {"limits": frozen.get("limits"), "stop_conditions": frozen.get("stop_conditions")}
                if manifest.get("policy") != expected:
                    raise ControlError("batch_policy_tampered")
                return expected
    if isinstance(manifest, dict) and isinstance(manifest.get("policy"), dict):
        return json.loads(json.dumps(manifest["policy"]))
    # Schema-v1 manifests predate immutable policy snapshots. Never bind them
    # to the mutable workspace config; preserve the versioned historical limits.
    return json.loads(json.dumps(LEGACY_V1_POLICY))


def batch_policy_source(manifest: dict[str, Any]) -> str:
    if isinstance(manifest.get("policy"), dict):
        return "manifest_snapshot"
    if manifest.get("schema_version", 1) >= 2:
        return "manifest_snapshot"
    return "legacy_v1_defaults"


def legacy_compatibility_path(batch: Path) -> Path:
    return batch / "legacy_compatibility.json"


def validate_recorded_snapshot(root: Path, snapshot: Any, error: str) -> None:
    if not isinstance(snapshot, dict) or snapshot.get("schema_version") != 1:
        raise ControlError(error)
    records = snapshot.get("files")
    if not isinstance(records, list) or not records:
        raise ControlError(error)
    digest = hashlib.sha256()
    for record in records:
        if not isinstance(record, dict) or set(record) != {"path", "sha256", "size"}:
            raise ControlError(error)
        relative = record.get("path")
        if not isinstance(relative, str) or not relative:
            raise ControlError(error)
        path = (root / relative).resolve()
        if root.resolve() not in path.parents or not path.is_file():
            raise ControlError(error)
        if path.stat().st_size != record.get("size") or sha256(path) != record.get("sha256"):
            raise ControlError(error)
        digest.update(f"{relative}\0{record['sha256']}\0{record['size']}\n".encode())
    if digest.hexdigest() != snapshot.get("aggregate_sha256"):
        raise ControlError(error)


def legacy_runtime_root(batch: Path) -> Path:
    return batch / "legacy_runtime"


def create_legacy_runtime_snapshot(
    batch: Path,
    manifest: dict[str, Any],
    track: str,
) -> dict[str, Any]:
    """Freeze original v1 inputs and the current mandatory safety controller."""
    authority = manifest.get("authority_hashes")
    if not isinstance(authority, dict):
        raise ControlError("legacy_candidate_snapshot_unavailable")
    current_control = {rel(path): path for path in control_paths()}
    source_paths: dict[str, Path] = {}
    # Original application/candidate inputs stay byte-for-byte tied to the v1
    # manifest. AGENTS/control files are intentionally replaced by the current
    # safety-fixed version and then frozen for the remainder of this batch.
    for logical, expected in authority.items():
        if logical in current_control or logical == ".jobseek/config.json":
            continue
        source = (ROOT / logical).resolve()
        if (
            not isinstance(logical, str)
            or not isinstance(expected, str)
            or ROOT not in source.parents
            or not source.is_file()
            or sha256(source) != expected
            or is_sensitive_path(source)
        ):
            raise ControlError("legacy_candidate_snapshot_unavailable")
        source_paths[logical] = source
    required_facts = {
        "Profile/Candidate_Profile.md",
        f"{track}/Profile/Track_Profile.md",
    }
    if not required_facts.issubset(source_paths):
        raise ControlError("legacy_candidate_snapshot_unavailable")

    root = legacy_runtime_root(batch)
    if root.exists():
        raise ControlError("legacy_runtime_snapshot_invalid")
    staging = Path(tempfile.mkdtemp(prefix=".legacy-runtime.", dir=batch))
    records: list[dict[str, Any]] = []
    try:
        combined = {**source_paths, **current_control}
        for logical, source in sorted(combined.items()):
            target = staging / logical
            target.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(source, target)
            records.append({
                "path": logical,
                "sha256": sha256(target),
                "size": target.stat().st_size,
            })
        legacy_config = {
            "schema_version": 1,
            "limits": json.loads(json.dumps(LEGACY_V1_POLICY["limits"])),
            "stop_conditions": json.loads(json.dumps(LEGACY_V1_POLICY["stop_conditions"])),
            "tracks": {
                track: {
                    "input_paths": sorted(source_paths),
                    "assessment": {
                        "eligible_threshold": 70,
                        "hard_exclusion_rules": [],
                        "hard_exclusion_definitions": {},
                        "score_components": [
                            {"category": "legacy_packet_total", "max_points": 100}
                        ],
                    },
                }
            },
            "legacy_runtime_notice": (
                "Schema-v1 safety migration: original hashed inputs plus the "
                "current mandatory review/audit controller, frozen at first resume."
            ),
        }
        config_target = staging / ".jobseek" / "config.json"
        atomic_json(config_target, legacy_config)
        records.append({
            "path": ".jobseek/config.json",
            "sha256": sha256(config_target),
            "size": config_target.stat().st_size,
        })
        records.sort(key=lambda item: item["path"])
        digest = hashlib.sha256()
        for record in records:
            digest.update(
                f"{record['path']}\0{record['sha256']}\0{record['size']}\n".encode()
            )
        snapshot = {
            "schema_version": 1,
            "root": "legacy_runtime",
            "files": records,
            "aggregate_sha256": digest.hexdigest(),
            "safety_migration": "legacy_v1_mandatory_controls_v2",
        }
        atomic_json(staging / ".jobseek" / "runtime_snapshot.json", snapshot)
        staging.replace(root)
        return snapshot
    except Exception:
        shutil.rmtree(staging, ignore_errors=True)
        raise


def ensure_legacy_compatibility(
    batch: Path,
    manifest: dict[str, Any],
    track: str,
    *,
    mutate: bool = True,
) -> dict[str, Any]:
    """Freeze v1 facts and an executable safety-upgraded agent project once."""
    if manifest.get("schema_version", 1) >= 2:
        return {}
    path = legacy_compatibility_path(batch)
    existing = read_json(path, None)
    if isinstance(existing, dict):
        items = existing.get("candidate_facts")
        hashes = existing.get("source_hashes")
        runtime_snapshot = existing.get("runtime_snapshot")
        if (
            existing.get("schema_version") == 1
            and isinstance(items, list)
            and isinstance(hashes, dict)
            and all(isinstance(item, dict) and isinstance(item.get("id"), str) for item in items)
            and isinstance(runtime_snapshot, dict)
        ):
            validate_recorded_snapshot(
                legacy_runtime_root(batch), runtime_snapshot,
                "legacy_runtime_snapshot_invalid",
            )
            return existing
        raise ControlError("legacy_candidate_snapshot_unavailable")
    authority = manifest.get("authority_hashes")
    required = {
        "Profile/Candidate_Profile.md": ROOT / "Profile" / "Candidate_Profile.md",
        f"{track}/Profile/Track_Profile.md": ROOT / track / "Profile" / "Track_Profile.md",
    }
    if not isinstance(authority, dict):
        raise ControlError("legacy_candidate_snapshot_unavailable")
    source_hashes: dict[str, str] = {}
    for logical, source in required.items():
        expected = authority.get(logical)
        if not isinstance(expected, str) or not source.is_file() or sha256(source) != expected:
            raise ControlError("legacy_candidate_snapshot_unavailable")
        source_hashes[logical] = expected
    facts = [
        item
        for source, logical in (
            (required["Profile/Candidate_Profile.md"], "Profile/Candidate_Profile.md"),
            (required[f"{track}/Profile/Track_Profile.md"], f"{track}/Profile/Track_Profile.md"),
        )
        for item in line_registry(source, "fact", logical)
    ]
    if not mutate:
        raise ControlError("legacy_candidate_snapshot_unavailable")
    runtime_snapshot = create_legacy_runtime_snapshot(batch, manifest, track)
    compatibility = {
        "schema_version": 1,
        "migration": "legacy_v1_candidate_facts_and_safety_runtime",
        "source_hashes": source_hashes,
        "candidate_facts": facts,
        "runtime_snapshot": runtime_snapshot,
    }
    events_path = batch / "events.jsonl"
    with exclusive_lock(events_path):
        if not path.exists():
            atomic_json(path, compatibility)
            append_jsonl_unlocked(events_path, {
                "schema_version": 1,
                "event_type": "legacy_compatibility_migrated",
                "at": now(),
                "batch_id": manifest.get("batch_id"),
                "track": track,
                "actor": "lead",
                "compatibility_version": 2,
                "policy_source": "legacy_v1_defaults",
                "source_hashes": source_hashes,
                "runtime_snapshot_sha256": runtime_snapshot["aggregate_sha256"],
                "safety_migration": "legacy_v1_mandatory_controls_v2",
            })
    return compatibility


def batch_runtime_context(batch: Path, manifest: dict[str, Any]) -> dict[str, Any]:
    if manifest.get("schema_version", 1) >= 2:
        runtime_version = manifest.get("runtime", {}).get("runtime_version")
        project = (
            batch / "runtime_v2_compat"
            if runtime_version == 1
            else batch / "inputs"
        )
        if runtime_version == 1:
            metadata = read_json(batch / "runtime_v2_compat_snapshot.json", None)
            if not _early_validate_snapshot(project, metadata):
                raise ControlError("runtime_v1_upgrade_tampered")
    else:
        compatibility = ensure_legacy_compatibility(
            batch, manifest, str(manifest.get("track")), mutate=True,
        )
        if not compatibility:
            raise ControlError("legacy_runtime_snapshot_invalid")
        project = legacy_runtime_root(batch)
        runtime_version = 2
    return {
        "runtime_version": runtime_version,
        "project_root": rel(project),
        "control_entrypoint": rel(project / "tools" / "jobseekctl"),
        "agent_config": rel(project / ".codex" / "config.toml"),
        "skills_root": rel(project / ".agents" / "skills"),
        "required_environment": {
            "JOBSEEK_WORKSPACE_ROOT": str(ROOT),
            "JOBSEEK_BATCH_RUNTIME_ID": str(manifest.get("batch_id")),
            "JOBSEEK_BATCH_INPUT_ROOT": str(project),
            "JOBSEEK_BATCH_TRACK": str(manifest.get("track")),
        },
        "worker_launch_rule": (
            "Launch every bounded worker with project_root as its cwd, pass "
            "required_environment, and invoke control_entrypoint for every CLI call."
        ),
    }

def batch_assessment_policy(batch: Path, manifest: dict[str, Any]) -> dict[str, Any]:
    track = manifest.get("track")
    if manifest.get("schema_version", 1) >= 2:
