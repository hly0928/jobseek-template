def canonical_url(value: str) -> str:
    """Normalise a URL without collapsing business-identifying query fields."""
    parsed = urllib.parse.urlsplit(value.strip())
    if not parsed.scheme or not parsed.netloc:
        raise ControlError("listing_id_or_absolute_url_required")
    retained = [
        (key, item) for key, item in urllib.parse.parse_qsl(
            parsed.query, keep_blank_values=True,
        ) if key.casefold() not in TRACKING_QUERY_KEYS
    ]
    retained.sort(key=lambda item: (item[0].casefold(), item[1]))
    return urllib.parse.urlunsplit((
        parsed.scheme.casefold(), parsed.netloc.casefold(),
        parsed.path.rstrip("/") or "/", urllib.parse.urlencode(retained, doseq=True), "",
    ))


def packet_url_aliases(packet: dict[str, Any]) -> set[str]:
    metadata = packet["metadata"]
    values = [
        metadata["direct_url"], metadata.get("source_url"),
        metadata.get("advertisement_url"), *metadata.get("url_aliases", []),
    ]
    result: set[str] = set()
    for value in values:
        if not value:
            continue
        try:
            result.add(canonical_url(value))
        except ControlError:
            # Packets created before URL normalisation may contain a non-URL;
            # their direct URL still has to match exactly in the caller.
            result.add(normalized(value))
    return result


def packet_matches_url(packet: dict[str, Any], value: str) -> bool:
    try:
        candidate = canonical_url(value)
    except ControlError:
        candidate = normalized(value)
    return candidate in packet_url_aliases(packet)


def parse_authority_toml(text: str) -> dict[str, Any]:
    """Parse TOML with tomllib when available; validate our authority subset on 3.9."""
    if tomllib is not None:
        return tomllib.loads(text)
    # The bundled authority TOML deliberately uses only tables, scalar values,
    # comments and multiline basic strings.  This fallback is intentionally
    # narrow but makes repository validation meaningful on macOS Python 3.9.
    if text.count('"""') % 2:
        raise ValueError("unterminated_multiline_string")
    masked = re.sub(r'""".*?"""', '"value"', text, flags=re.DOTALL)
    current: dict[str, Any] = {}
    result: dict[str, Any] = {}
    for line_number, raw in enumerate(masked.splitlines(), 1):
        line = raw.split("#", 1)[0].strip()
        if not line:
            continue
        table = re.fullmatch(r"\[([A-Za-z0-9_.-]+)\]", line)
        if table:
            current = result
            for part in table.group(1).split("."):
                current = current.setdefault(part, {})
            continue
        match = re.fullmatch(r"([A-Za-z0-9_.-]+)\s*=\s*(.+)", line)
        if not match:
            raise ValueError(f"invalid_toml_syntax_line_{line_number}")
        value = match.group(2).strip()
        if not (
            value in {"true", "false"}
            or re.fullmatch(r"[-+]?\d+(?:\.\d+)?", value)
            or re.fullmatch(r'"(?:[^"\\]|\\.)*"', value)
            or (value.startswith("[") and value.endswith("]"))
        ):
            raise ValueError(f"unsupported_toml_value_line_{line_number}")
        current[match.group(1)] = value
    return result


