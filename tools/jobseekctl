def _early_sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for block in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()


def _early_snapshot_tree(root: Path) -> dict[str, Any]:
    records: list[dict[str, Any]] = []
    for path in sorted(item for item in root.rglob("*") if item.is_file()):
        relative = str(path.relative_to(root))
        records.append({
            "path": relative,
            "sha256": _early_sha256(path),
            "size": path.stat().st_size,
        })
    digest = hashlib.sha256()
    for record in records:
        digest.update(
            f"{record['path']}\0{record['sha256']}\0{record['size']}\n".encode()
        )
    return {
        "schema_version": 1,
        "root": root.name,
        "files": records,
        "aggregate_sha256": digest.hexdigest(),
    }


def _early_validate_snapshot(root: Path, snapshot: Any) -> bool:
    if not isinstance(snapshot, dict) or snapshot.get("schema_version") != 1:
        return False
    records = snapshot.get("files")
    if not isinstance(records, list) or not records:
        return False
    digest = hashlib.sha256()
    root_resolved = root.resolve()
    for record in records:
        if not isinstance(record, dict) or set(record) != {"path", "sha256", "size"}:
            return False
        relative = record.get("path")
        if not isinstance(relative, str) or not relative:
            return False
        path = (root / relative).resolve()
        if root_resolved not in path.parents or not path.is_file():
            return False
        if path.stat().st_size != record.get("size"):
            return False
        if _early_sha256(path) != record.get("sha256"):
            return False
        digest.update(
            f"{relative}\0{record['sha256']}\0{record['size']}\n".encode()
        )
    return digest.hexdigest() == snapshot.get("aggregate_sha256")


def _runtime_v1_control_paths() -> list[Path]:
    fixed = [
        ROOT / "AGENTS.md",
        ROOT / "tools" / "jobseekctl",
        ROOT / "tools" / "jobseek_classification.py",
        ROOT / ".codex" / "config.toml",
    ]
    patterns = (
        ".jobseek/schemas/*.json",
        ".agents/skills/jobseek-*/SKILL.md",
        ".agents/skills/jobseek-*/agents/openai.yaml",
        ".codex/agents/*.toml",
    )
    paths = [path for path in fixed if path.is_file()]
    for pattern in patterns:
        paths.extend(path for path in ROOT.glob(pattern) if path.is_file())
    return sorted(set(paths), key=lambda path: str(path.relative_to(ROOT)))


def _ensure_runtime_v1_upgrade(batch: Path, inputs: Path) -> Path:
    """Create one immutable safety-upgraded project for a runtime-v1 batch."""
    project = batch / "runtime_v2_compat"
    metadata_path = batch / "runtime_v2_compat_snapshot.json"
    if project.exists() or metadata_path.exists():
        try:
            metadata = json.loads(metadata_path.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError):
            metadata = None
        if not _early_validate_snapshot(project, metadata):
            print(json.dumps({"ok": False, "error": "runtime_v1_upgrade_tampered"}))
            raise SystemExit(2)
        return project
    if not inputs.is_dir():
        print(json.dumps({"ok": False, "error": "batch_runtime_missing_or_tampered"}))
        raise SystemExit(2)
    staging = Path(tempfile.mkdtemp(prefix=".runtime-v2-compat.", dir=batch))
    try:
        for source in inputs.rglob("*"):
            relative = source.relative_to(inputs)
            target = staging / relative
            if source.is_dir():
                target.mkdir(parents=True, exist_ok=True)
            elif source.is_file():
                target.parent.mkdir(parents=True, exist_ok=True)
                shutil.copy2(source, target)
        for source in _runtime_v1_control_paths():
            target = staging / source.relative_to(ROOT)
            target.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(source, target)
        metadata = _early_snapshot_tree(staging)
        metadata["safety_migration"] = "runtime_v1_mandatory_controls_v2"
        staging.replace(project)
        temporary = metadata_path.with_suffix(".json.tmp")
        temporary.write_text(
            json.dumps(metadata, ensure_ascii=False, indent=2, sort_keys=True) + "\n",
            encoding="utf-8",
        )
        temporary.replace(metadata_path)
        return project
    except Exception:
        shutil.rmtree(staging, ignore_errors=True)
        raise


def _dispatch_frozen_runtime() -> None:
    """Run a modern batch with its snapshotted control package, never current code."""
    if os.environ.get("JOBSEEK_RUNTIME_DISPATCHED") == "1":
        return
    arguments = sys.argv[1:]
    if "--batch-id" not in arguments:
        return
    try:
        batch_id = arguments[arguments.index("--batch-id") + 1]
        manifest_path = CONTROL / "batches" / batch_id / "manifest.json"
        manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
    except (ValueError, IndexError, OSError, json.JSONDecodeError):
        return
    if manifest.get("schema_version", 1) < 2:
        compatibility_path = CONTROL / "batches" / batch_id / "legacy_compatibility.json"
        if not compatibility_path.is_file():
            # The current safety controller performs the one-time migration.
            return
        try:
            compatibility = json.loads(compatibility_path.read_text(encoding="utf-8"))
            snapshot = compatibility["runtime_snapshot"]
            record = next(
                item for item in snapshot["files"]
                if item.get("path") == "tools/jobseekctl"
            )
            inputs = CONTROL / "batches" / batch_id / "legacy_runtime"
            frozen = inputs / "tools" / "jobseekctl"
            expected = record["sha256"]
        except (OSError, KeyError, StopIteration, TypeError, json.JSONDecodeError):
            print(json.dumps({"ok": False, "error": "legacy_runtime_snapshot_invalid"}))
            raise SystemExit(2)
        if not frozen.is_file() or hashlib.sha256(frozen.read_bytes()).hexdigest() != expected:
            print(json.dumps({"ok": False, "error": "legacy_runtime_snapshot_invalid"}))
            raise SystemExit(2)
        environment = dict(os.environ)
        environment["JOBSEEK_RUNTIME_DISPATCHED"] = "1"
        environment["JOBSEEK_WORKSPACE_ROOT"] = str(ROOT)
        environment["JOBSEEK_BATCH_RUNTIME_ID"] = batch_id
        environment["JOBSEEK_BATCH_INPUT_ROOT"] = str(inputs)
        environment["JOBSEEK_BATCH_TRACK"] = str(manifest.get("track", ""))
        os.execve(sys.executable, [sys.executable, str(frozen), *arguments], environment)
    runtime = manifest.get("runtime")
    if not isinstance(runtime, dict):
        return
    inputs = CONTROL / "batches" / batch_id / "inputs"
    frozen = inputs / "tools" / "jobseekctl"
    expected = runtime.get("control_sha256")
    if not isinstance(expected, str) or not frozen.is_file():
        print(json.dumps({"ok": False, "error": "batch_runtime_missing_or_tampered"}))
        raise SystemExit(2)
    actual = hashlib.sha256(frozen.read_bytes()).hexdigest()
    if actual != expected:
        print(json.dumps({"ok": False, "error": "batch_runtime_missing_or_tampered"}))
        raise SystemExit(2)
    runtime_version = runtime.get("runtime_version")
    if runtime_version == 1:
        inputs = _ensure_runtime_v1_upgrade(CONTROL / "batches" / batch_id, inputs)
        frozen = inputs / "tools" / "jobseekctl"
    elif runtime_version != 2:
        print(json.dumps({"ok": False, "error": "batch_runtime_version_unsupported"}))
        raise SystemExit(2)
    environment = dict(os.environ)
    environment["JOBSEEK_RUNTIME_DISPATCHED"] = "1"
    environment["JOBSEEK_WORKSPACE_ROOT"] = str(ROOT)
    environment["JOBSEEK_BATCH_RUNTIME_ID"] = batch_id
    environment["JOBSEEK_BATCH_INPUT_ROOT"] = str(inputs)
    environment["JOBSEEK_BATCH_TRACK"] = str(manifest.get("track", ""))
    os.execve(sys.executable, [sys.executable, str(frozen), *arguments], environment)


