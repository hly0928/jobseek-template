def validate_actor(actor: str) -> str:
    actor = safe_id(actor, "actor")
    if actor not in ACTORS:
        raise ControlError("unknown_actor")
    return actor


def role_owned(batch: Path, key: str, role: str, actor: str) -> bool:
    owner = None
    for event in read_jsonl(batch / "events.jsonl"):
        if event.get("event_type") == "role_claim" and event.get("job_key") == key and event.get("role") == role:
            owner = event.get("actor")
    return owner == actor


def transition(args: argparse.Namespace) -> dict[str, Any]:
    safe_track(args.track); key = safe_id(args.job_key, "job_key")
    batch, manifest = require_batch(args.track, args.batch_id)
    modern = manifest.get("schema_version", 1) >= 2
    actor_alias = {
        "Discovered": "discovery", "Assessed": "discovery", "Eligible": "discovery",
        "Skipped": "discovery", "Needs Review": "lead", "Package Prepared": "materials",
        "Awaiting User Review": "submission", "Submission Ready": "lead",
        "Submitted": "submission", "Submission Verified": "submission",
        "Blocked": "lead", "Failed": "submission", "Expired": "discovery",
        "Duplicate": "discovery", "Withdrawn": "lead",
    }
    if modern:
        actor = validate_actor(args.actor)
    else:
        actor = args.actor if args.actor in ACTORS else actor_alias.get(args.to_state, "lead")
    previous = job_state(batch, key)
    submission_attempt_id = None
    submission_review_cycle_id = None
    if args.from_state and previous != args.from_state:
        raise ControlError("state_precondition_failed")
    if previous is None and args.to_state != "Discovered":
        raise ControlError("first_state_must_be_discovered")
    if previous is not None and args.to_state not in NORMAL_STATES.get(previous, set()):
        post_submit_recovery = (
            previous == "Blocked"
            and args.to_state in {"Failed", "Submission Verified"}
            and post_submit_attempt_state(batch, key) is not None
        )
        if not post_submit_recovery:
            raise ControlError("illegal_state_transition")
    if (
        previous == "Blocked"
        and post_submit_attempt_state(batch, key) is not None
        and args.to_state not in {"Failed", "Submission Verified"}
    ):
        raise ControlError("post_submit_attempt_must_be_resolved")
    if modern and args.to_state == "Blocked" and args.blocked_kind is None:
        raise ControlError("blocked_kind_required")
    if args.to_state != "Blocked" and args.blocked_kind is not None:
        raise ControlError("blocked_kind_only_for_blocked_state")
    if previous == "Package Prepared" and args.to_state == "Submission Ready":
        raise ControlError("human_review_state_required")
    if previous == "Submitted" and args.to_state in {
        "Failed", "Submission Verified", "Blocked",
    }:
        submission_attempt_id = current_submission_attempt(batch, key)
    if previous == "Blocked" and args.to_state in {
        "Failed", "Submission Verified",
    }:
        submission_attempt_id = post_submit_attempt_state(batch, key)[1]
    if previous in {"Submitted", "Blocked"} and args.to_state == "Failed":
        audit_result = confirmation_audit_result_event(
            batch, key, submission_attempt_id,
        )
        if (
            audit_result is None
            or audit_result.get("result") != "not_submitted"
        ):
            raise ControlError("confirmation_not_submitted_required")
    if actor not in STATE_ACTORS.get(args.to_state, set()):
        raise ControlError("state_actor_not_allowed")
    owned_role = STATE_OWNED_ROLE.get(args.to_state)
    if args.to_state == "Submission Verified" and actor == "confirmation-audit":
        owned_role = "confirmation-audit"
    if modern and owned_role and not role_owned(batch, key, owned_role, actor):
        raise ControlError("state_role_ownership_required")
    evidence = evidence_reference(batch, args.evidence_path)
    if args.to_state in {
        "Assessed", "Eligible", "Skipped", "Needs Review", "Package Prepared",
        "Awaiting User Review", "Submission Ready", "Submitted", "Submission Verified",
    }:
        packet, packet_hash, _ = load_valid_packet(batch, args.track, key)
        if args.to_state == "Eligible":
            if not packet_effectively_eligible(batch, key, packet):
                raise ControlError("packet_not_eligible")
            if eligibility_gate_required(packet, batch, key):
                require_gate(batch, key, "eligibility_audit", packet_hash)
        if args.to_state in {"Skipped", "Needs Review"} and packet["classification"] != args.to_state:
            raise ControlError("packet_classification_state_mismatch")
        if args.to_state in {"Package Prepared", "Awaiting User Review", "Submission Ready"}:
            if not packet_effectively_eligible(batch, key, packet) or effective_unresolved_items(batch, key, packet):
                raise ControlError("packet_not_materials_safe")
            if eligibility_gate_required(packet, batch, key):
                require_gate(batch, key, "eligibility_audit", packet_hash)
            require_gate(batch, key, "materials_qa", packet_hash)
        if args.to_state == "Submission Ready":
            approval = require_submission_approval(batch, key, packet_hash)
            submission_attempt_id = approval["submission_attempt_id"]
            submission_review_cycle_id = approval["submission_review_cycle_id"]
        if args.to_state == "Submitted":
            if (
                not packet_effectively_eligible(batch, key, packet)
                or effective_unresolved_items(batch, key, packet)
                or packet["score_breakdown"]["total"]
                < packet_eligible_threshold(batch, manifest, packet)
            ):
                raise ControlError("packet_not_submission_safe")
            if eligibility_gate_required(packet, batch, key):
                require_gate(batch, key, "eligibility_audit", packet_hash)
            require_gate(batch, key, "materials_qa", packet_hash)
            open_attempts = submission_attempt_lifecycle(
                read_jsonl(batch / "events.jsonl"),
            )["open_attempts_by_job"].get(key, [])
            if open_attempts:
                raise ControlError("submission_attempt_confirmation_pending")
            approval = require_submission_approval(batch, key, packet_hash)
            submission_attempt_id = approval["submission_attempt_id"]
            submission_review_cycle_id = approval["submission_review_cycle_id"]
            require_gate(
                batch,
                key,
                "submission_evidence",
                packet_hash,
                submission_attempt_id,
            )
        if args.to_state == "Submission Verified":
            if submission_attempt_id is None:
                submission_attempt_id = (
                    post_submit_attempt_state(batch, key)[1]
                    if post_submit_attempt_state(batch, key)
                    else current_submission_attempt(batch, key)
                )
            require_confirmation_gate(
                batch, key, packet_hash, submission_attempt_id,
            )
    event = {"schema_version": 1, "event_type": "state_transition", "at": now(), "batch_id": args.batch_id,
             "track": args.track, "job_key": key, "actor": actor, "from_state": previous, "to_state": args.to_state,
             "evidence": evidence, "affected_paths": args.path or [],
             "blocked_kind": args.blocked_kind if args.to_state == "Blocked" else None,
             "submission_attempt_id": submission_attempt_id}
    if submission_review_cycle_id is not None:
        event["submission_review_cycle_id"] = submission_review_cycle_id
    events_path = batch / "events.jsonl"
    with exclusive_lock(events_path):
        if job_state(batch, key) != previous:
            raise ControlError("state_changed_concurrently")
        locked_events = read_jsonl(events_path)
        if args.to_state in {"Submission Ready", "Submitted"}:
            if (
                not packet_effectively_eligible(batch, key, packet)
                or effective_unresolved_items(batch, key, packet)
                or packet["score_breakdown"]["total"]
                < packet_eligible_threshold(batch, manifest, packet)
            ):
                raise ControlError("packet_not_submission_safe")
            if eligibility_gate_required(packet, batch, key):
                require_gate(batch, key, "eligibility_audit", packet_hash)
            require_gate(batch, key, "materials_qa", packet_hash)
            locked_approval = require_submission_approval(
                batch, key, packet_hash,
            )
            if (
                locked_approval["submission_attempt_id"]
                != submission_attempt_id
                or locked_approval["submission_review_cycle_id"]
                != submission_review_cycle_id
            ):
                raise ControlError("submission_review_changed_concurrently")
        if args.to_state == "Submitted":
            open_attempts = submission_attempt_lifecycle(locked_events)[
                "open_attempts_by_job"
            ].get(key, [])
            if open_attempts:
                raise ControlError("submission_attempt_confirmation_pending")
            submission_gate = gate_event(
                batch, key, "submission_evidence", packet_hash,
                submission_attempt_id,
            )
            if submission_gate is None:
                raise ControlError("submission_evidence_pass_required")
            gate_cycle = submission_gate.get("submission_review_cycle_id")
            if (
                gate_cycle is not None
                and gate_cycle != submission_review_cycle_id
            ):
                raise ControlError("submission_review_changed_concurrently")
        if args.to_state == "Awaiting User Review":
            ordinal = 1 + sum(
                item.get("event_type") == "state_transition"
                and item.get("job_key") == key
                and item.get("to_state") == "Awaiting User Review"
                for item in locked_events
            )
            cycle_seed = f"{args.batch_id}|{key}|{ordinal}|{packet_hash}"
            submission_review_cycle_id = "review-cycle-" + hashlib.sha256(
                cycle_seed.encode(),
            ).hexdigest()[:24]
            event["submission_review_cycle_id"] = submission_review_cycle_id
        append_jsonl_unlocked(events_path, event)
    return {"event": rel(batch / "events.jsonl"), "job_key": key, "previous": previous, "state": args.to_state}


def init_packet(args: argparse.Namespace) -> dict[str, Any]:
    safe_track(args.track); key = safe_id(args.job_key, "job_key")
    batch, manifest = require_batch(args.track, args.batch_id)
    packet = read_json_arg(args.packet_json)
    modern = manifest.get("schema_version", 1) >= 2
    packet = validate_packet(
        packet,
        args.track,
        key,
        batch_fact_ids(batch, args.track),
        modern=modern,
        assessment=batch_assessment_policy(batch, manifest) if modern else None,
    )
    path = packet_path(batch, key)
    with exclusive_lock(path):
        if path.exists():
            raise ControlError("packet_already_exists")
        atomic_json(path, packet)
    return {"packet": rel(path), "packet_sha256": sha256(path), "job_key": key, "created": True}


def record_gate(args: argparse.Namespace) -> dict[str, Any]:
    safe_track(args.track)
    key = safe_id(args.job_key, "job_key")
    if args.gate_type not in GENERIC_GATE_TYPES:
        raise ControlError("structured_audit_command_required")
    batch, manifest = require_batch(args.track, args.batch_id)
    rule = GATE_RULES[args.gate_type]
    packet, packet_hash, _ = load_valid_packet(batch, args.track, key)
    evidence = evidence_reference(batch, args.evidence_path)
    events_path = batch / "events.jsonl"
    with exclusive_lock(events_path):
        current_state = job_state(batch, key)
        if args.actor != rule["actor"] or current_state not in rule["states"]:
            raise ControlError("gate_actor_or_state_invalid")
        if (
            not packet_effectively_eligible(batch, key, packet)
            or effective_unresolved_items(batch, key, packet)
        ):
            raise ControlError("packet_not_gate_safe")
        if eligibility_gate_required(packet, batch, key):
            require_gate(batch, key, "eligibility_audit", packet_hash)
        submission_attempt_id = None
        submission_review_cycle_id = None
        if args.gate_type == "submission_evidence":
            if (
                packet["score_breakdown"]["total"]
                < packet_eligible_threshold(batch, manifest, packet)
            ):
                raise ControlError("packet_not_submission_safe")
            approval = require_submission_approval(batch, key, packet_hash)
            submission_attempt_id = approval["submission_attempt_id"]
            submission_review_cycle_id = approval["submission_review_cycle_id"]
        event = {
            "schema_version": 1,
            "event_type": "gate",
            "at": now(),
            "batch_id": args.batch_id,
            "track": args.track,
            "job_key": key,
            "gate_type": args.gate_type,
            "actor": args.actor,
            "result": "pass",
            "packet_sha256": packet_hash,
            "submission_attempt_id": submission_attempt_id,
            "submission_review_cycle_id": submission_review_cycle_id,
            "evidence": evidence,
        }
        append_jsonl_unlocked(events_path, event)
    return {
        "event": rel(batch / "events.jsonl"),
        "job_key": key,
        "gate_type": args.gate_type,
        "packet_sha256": packet_hash,
        "state": current_state,
        "submission_attempt_id": submission_attempt_id,
        "submission_review_cycle_id": submission_review_cycle_id,
    }


def record_confirmation(args: argparse.Namespace) -> dict[str, Any]:
    key = safe_id(args.job_key, "job_key")
    batch, _ = require_batch(args.track, args.batch_id)
    packet, packet_hash, _ = load_valid_packet(batch, args.track, key)
    signals = require_exact_keys(
        read_json_arg(args.confirmation_json),
        {
            "employer", "role", "successful_submission",
            "required_identifier_present", "abnormalities",
        },
        "confirmation",
    )
    require_string(signals.get("employer"), "confirmation_employer")
    require_string(signals.get("role"), "confirmation_role")
    if not isinstance(signals.get("successful_submission"), bool):
        raise ControlError("confirmation_success_boolean_required")
    if not isinstance(signals.get("required_identifier_present"), bool):
        raise ControlError("confirmation_identifier_boolean_required")
    abnormalities = signals.get("abnormalities")
    if (
        not isinstance(abnormalities, list)
        or any(item not in CONFIRMATION_ABNORMALITIES for item in abnormalities)
    ):
        raise ControlError("invalid_confirmation_abnormality")
    identity_matches = (
        normalized(signals["employer"])
        == normalized(packet["metadata"]["company"])
        and normalized(signals["role"])
        == normalized(packet["metadata"]["role"])
    )
    if not identity_matches and "identity_mismatch" not in abnormalities:
        abnormalities = sorted(set(abnormalities) | {"identity_mismatch"})
    unambiguous = (
        identity_matches
        and signals["successful_submission"]
        and signals["required_identifier_present"]
        and not abnormalities
    )
    evidence = evidence_reference(batch, args.evidence_path)
    events_path = batch / "events.jsonl"
    with exclusive_lock(events_path):
        attempt_state = post_submit_attempt_state(batch, key)
        if attempt_state is None:
            raise ControlError("confirmation_requires_submitted_state")
        current_state, submission_attempt_id = attempt_state
        prior = confirmation_assessment_event(
            batch, key, submission_attempt_id,
        )
        if prior and prior.get("audit_required"):
            raise ControlError("confirmation_audit_required_after_abnormality")
        if prior:
            return {
                "job_key": key,
                "submission_attempt_id": submission_attempt_id,
                "result": prior["result"],
                "confirmation_audit_required": prior["audit_required"],
                "abnormalities": prior.get("abnormalities", []),
                "reused": True,
            }
        event = {
            "schema_version": 1,
            "event_type": "confirmation_assessment",
            "at": now(),
            "batch_id": args.batch_id,
            "track": args.track,
            "job_key": key,
            "actor": "submission",
            "result": "unambiguous" if unambiguous else "abnormal",
            "audit_required": not unambiguous,
            "abnormalities": abnormalities,
            "packet_sha256": packet_hash,
            "submission_attempt_id": submission_attempt_id,
            "evidence": evidence,
        }
        append_jsonl_unlocked(events_path, event)
        if event["audit_required"]:
            append_jsonl_unlocked(events_path, {
                "schema_version": 1,
                "event_type": "confirmation_audit_trigger",
                "at": now(),
                "batch_id": args.batch_id,
                "track": args.track,
                "job_key": key,
                "actor": "submission",
                "submission_attempt_id": submission_attempt_id,
                "packet_sha256": packet_hash,
                "abnormalities": abnormalities,
                "evidence": evidence,
            })
    return {
        "job_key": key,
        "submission_attempt_id": submission_attempt_id,
        "result": event["result"],
        "confirmation_audit_required": event["audit_required"],
        "abnormalities": abnormalities,
        "reused": False,
        "state": current_state,
    }


def record_confirmation_audit(args: argparse.Namespace) -> dict[str, Any]:
    key = safe_id(args.job_key, "job_key")
    if args.actor != "confirmation-audit":
        raise ControlError("confirmation_audit_actor_required")
    batch, _ = require_batch(args.track, args.batch_id)
    packet, packet_hash, _ = load_valid_packet(batch, args.track, key)
    evidence = evidence_reference(batch, args.evidence_path)
    events_path = batch / "events.jsonl"
    with exclusive_lock(events_path):
        attempt_state = post_submit_attempt_state(batch, key)
        if attempt_state is None:
            raise ControlError("confirmation_audit_requires_submitted_state")
        current_state, submission_attempt_id = attempt_state
        assessment = confirmation_assessment_event(
            batch, key, submission_attempt_id,
        )
        if not assessment or not assessment.get("audit_required"):
            raise ControlError("confirmation_audit_not_triggered")
        events = read_jsonl(events_path)
        prior = next((
            event for event in reversed(events)
            if event.get("event_type") == "confirmation_audit_result"
            and event.get("job_key") == key
            and event.get("submission_attempt_id") == submission_attempt_id
            and event.get("compatibility_alias") != "record-gate"
        ), None)
        if prior and prior.get("result") in {"verified", "not_submitted"}:
            if prior.get("result") != args.result:
                raise ControlError("confirmation_audit_already_resolved")
            return {
                "job_key": key,
                "submission_attempt_id": submission_attempt_id,
                "result": args.result,
                "reused": True,
            }
        version = 1 + sum(
            event.get("event_type") == "confirmation_audit_result"
            and event.get("job_key") == key
            and event.get("submission_attempt_id") == submission_attempt_id
            for event in events
        )
        result_event = {
            "schema_version": 1,
            "event_type": "confirmation_audit_result",
            "at": now(),
            "batch_id": args.batch_id,
            "track": args.track,
            "job_key": key,
            "actor": args.actor,
            "result": args.result,
            "resolution_version": version,
            "packet_sha256": packet_hash,
            "submission_attempt_id": submission_attempt_id,
            "evidence": evidence,
        }
        append_jsonl_unlocked(events_path, result_event)
        if args.result == "verified":
            append_jsonl_unlocked(events_path, {
                "schema_version": 1,
                "event_type": "gate",
                "at": now(),
                "batch_id": args.batch_id,
                "track": args.track,
                "job_key": key,
                "gate_type": "confirmation_audit",
                "actor": args.actor,
                "result": "pass",
                "packet_sha256": packet_hash,
                "submission_attempt_id": submission_attempt_id,
                "confirmation_audit_result": "verified",
                "evidence": evidence,
            })
        elif args.result == "not_submitted":
            append_jsonl_unlocked(events_path, {
                "schema_version": 1,
                "event_type": "state_transition",
                "at": now(),
                "batch_id": args.batch_id,
                "track": args.track,
                "job_key": key,
                "actor": "submission",
                "from_state": current_state,
                "to_state": "Failed",
                "submission_attempt_id": submission_attempt_id,
                "evidence": evidence,
                "affected_paths": [],
                "blocked_kind": None,
                "confirmation_audit_result": "not_submitted",
            })
    return {
        "job_key": key,
        "submission_attempt_id": submission_attempt_id,
        "result": args.result,
        "state": "Failed" if args.result == "not_submitted" else current_state,
        "reused": False,
    }


def record_audit_trigger(args: argparse.Namespace) -> dict[str, Any]:
    key = safe_id(args.job_key, "job_key")
    batch, _ = require_batch(args.track, args.batch_id)
    if args.actor != "lead":
        raise ControlError("only_lead_may_trigger_audit")
    if args.trigger not in ELIGIBILITY_AUDIT_TRIGGERS:
        raise ControlError("invalid_eligibility_audit_trigger")
    if job_state(batch, key) not in {"Assessed", "Eligible", "Needs Review"}:
        raise ControlError("eligibility_audit_trigger_wrong_state")
    evidence = evidence_reference(batch, args.evidence_path) if args.evidence_path else None
    events_path = batch / "events.jsonl"
    with exclusive_lock(events_path):
        if job_state(batch, key) not in {"Assessed", "Eligible", "Needs Review"}:
            raise ControlError("eligibility_audit_trigger_wrong_state")
        events = read_jsonl(events_path)
        for event in reversed(events):
            if (
                event.get("event_type") == "eligibility_audit_trigger"
                and event.get("job_key") == key
                and event.get("trigger") == args.trigger
                and (
                    (not evidence and not event.get("evidence"))
                    or (
                        evidence and isinstance(event.get("evidence"), dict)
                        and event["evidence"].get("sha256") == evidence["sha256"]
                    )
                )
            ):
                snapshot = eligibility_trigger_snapshot(batch, key)
                if event.get("trigger_id") in snapshot["unresolved_trigger_ids"]:
                    return {"job_key": key, "trigger": args.trigger, "trigger_id": event.get("trigger_id"), "reused": True}
        version = 1 + max(
            [
                event.get("trigger_version", 0)
                for event in events
                if event.get("event_type") == "eligibility_audit_trigger"
                and event.get("job_key") == key
                and isinstance(event.get("trigger_version", 0), int)
            ]
            or [0]
        )
        trigger_id = "trigger-" + hashlib.sha256(
            f"{key}|{args.trigger}|{version}|{evidence.get('sha256') if evidence else ''}".encode()
        ).hexdigest()[:24]
        event = {
            "schema_version": 1, "event_type": "eligibility_audit_trigger", "at": now(),
            "batch_id": args.batch_id, "track": args.track, "job_key": key,
            "actor": args.actor, "trigger": args.trigger,
            "trigger_id": trigger_id, "trigger_version": version,
            "evidence": evidence,
        }
        append_jsonl_unlocked(events_path, event)
    return {"job_key": key, "trigger": args.trigger, "trigger_id": trigger_id, "reused": False}


def record_eligibility_audit(args: argparse.Namespace) -> dict[str, Any]:
    key = safe_id(args.job_key, "job_key")
    batch, _ = require_batch(args.track, args.batch_id)
    if args.actor != "eligibility-audit":
        raise ControlError("eligibility_audit_actor_required")
    current = job_state(batch, key)
    if current not in {"Assessed", "Eligible", "Needs Review"}:
        raise ControlError("eligibility_audit_wrong_state")
    packet, packet_hash, _ = load_valid_packet(batch, args.track, key)
    if not packet_requires_eligibility_audit(packet, batch, key):
        raise ControlError("eligibility_audit_not_triggered")
    trigger_snapshot = eligibility_trigger_snapshot(batch, key, packet)
    unresolved_trigger_ids = trigger_snapshot["unresolved_trigger_ids"]
    requested_trigger_ids = list(dict.fromkeys(args.resolve_trigger_id or []))
    if not requested_trigger_ids:
        requested_trigger_ids = list(unresolved_trigger_ids)
    if any(item not in trigger_snapshot["trigger_ids"] for item in requested_trigger_ids):
        raise ControlError("eligibility_audit_unknown_trigger_id")
    covered_trigger_ids = sorted(set(trigger_snapshot["covered_trigger_ids"]) | set(requested_trigger_ids))
    remaining_trigger_ids = sorted(set(trigger_snapshot["trigger_ids"]) - set(covered_trigger_ids))
    allowed = {
        "pass": {"Eligible"},
        "pass_with_warnings": {"Eligible", "Needs Review"},
        "fail": {"Skipped", "Needs Review", "Blocked"},
    }
    if args.outcome not in allowed[args.result]:
        raise ControlError("eligibility_audit_result_outcome_mismatch")
    reviews = job_review_reasons(batch, key, packet)
    known_reason_ids = {
        review_reason_id(key, item["review_type"], item.get("reason_id"))
        for item in reviews
    }
    resolved_reason_ids = list(dict.fromkeys(args.resolve_reason_id or []))
    if any(reason_id not in known_reason_ids for reason_id in resolved_reason_ids):
        raise ControlError("eligibility_audit_unknown_review_reason")
    review_by_id = {
        review_reason_id(key, item["review_type"], item.get("reason_id")): item
        for item in reviews
    }
    if any(
        review_by_id[reason_id].get("review_type") in USER_EXCLUSIVE_REVIEW_TYPES
        for reason_id in resolved_reason_ids
    ):
        raise ControlError("eligibility_audit_user_exclusive_reason")
    evaluations = packet.get("hard_exclusions", {}).get("evaluations", [])
    unknown_rules = {
        item.get("rule_id") for item in evaluations
        if item.get("comparison_result") == "unknown"
    }
    resolved_hard_rules = list(dict.fromkeys(
        args.resolve_hard_exclusion_rule or []
    ))
    if any(rule_id not in unknown_rules for rule_id in resolved_hard_rules):
        raise ControlError("eligibility_audit_unknown_hard_exclusion")
    unresolved_items = set(packet.get("unresolved_items", []))
    resolved_unresolved_items = list(dict.fromkeys(
        args.resolve_unresolved_item or []
    ))
    if any(item not in unresolved_items for item in resolved_unresolved_items):
        raise ControlError("eligibility_audit_unknown_unresolved_item")
    user_exclusive_items = {
        item for review in reviews
        if review.get("review_type") in USER_EXCLUSIVE_REVIEW_TYPES
        for item in review.get("unresolved_item_ids", [])
    }
    if any(item in user_exclusive_items for item in resolved_unresolved_items):
        raise ControlError("eligibility_audit_user_exclusive_unresolved_item")
    resolved_blocker_ids = list(dict.fromkeys(args.resolve_blocker or []))
    if any(
        blocker not in {"sensitive-review", "referee-ambiguity"}
        for blocker in resolved_blocker_ids
    ):
        raise ControlError("eligibility_audit_unknown_blocker")
    proposed_overlay = {
        "result": args.result,
        "outcome": args.outcome,
        "resolved_reason_ids": resolved_reason_ids,
        "resolved_hard_exclusion_rules": resolved_hard_rules,
        "resolved_unresolved_items": resolved_unresolved_items,
        "resolved_blocker_ids": resolved_blocker_ids,
        "covered_trigger_ids": covered_trigger_ids,
        "eligibility_trigger_ids": trigger_snapshot["trigger_ids"],
        "eligibility_trigger_version": trigger_snapshot["trigger_version"],
        "packet_sha256": packet_hash,
    }
    effective = packet_effective_classification(
        batch, key, packet, proposed_audit=proposed_overlay,
    )
    if args.outcome == "Eligible" and effective != "Eligible":
        raise ControlError("eligibility_audit_cannot_override_unresolved_review")
    if args.outcome == "Eligible" and remaining_trigger_ids:
        raise ControlError("eligibility_audit_triggers_unresolved")
    if (
        args.result in {"pass", "pass_with_warnings"}
        and args.outcome != effective
    ):
        raise ControlError("eligibility_audit_outcome_not_reduced")
    if (
        args.result == "fail"
        and args.outcome == "Needs Review"
        and effective != "Needs Review"
    ):
        raise ControlError("eligibility_audit_outcome_not_reduced")
    if (
        args.result == "pass_with_warnings"
        and args.outcome == "Needs Review"
        and effective == "Eligible"
    ):
        raise ControlError("eligibility_audit_warning_reason_required")
    evidence = evidence_reference(batch, args.evidence_path)
    events_path = batch / "events.jsonl"
    with exclusive_lock(events_path):
        locked_current = job_state(batch, key)
        if locked_current not in {"Assessed", "Eligible", "Needs Review"}:
            raise ControlError("eligibility_audit_wrong_state")
        locked_trigger_snapshot = eligibility_trigger_snapshot(
            batch, key, packet,
        )
        if locked_trigger_snapshot != trigger_snapshot:
            raise ControlError("eligibility_audit_changed_concurrently")
        locked_reviews = job_review_reasons(batch, key, packet)
        locked_review_by_id = {
            review_reason_id(key, item["review_type"], item.get("reason_id")): item
            for item in locked_reviews
        }
        if any(
            reason_id not in locked_review_by_id
            for reason_id in resolved_reason_ids
        ):
            raise ControlError("eligibility_audit_changed_concurrently")
        if any(
            locked_review_by_id[reason_id].get("review_type")
            in USER_EXCLUSIVE_REVIEW_TYPES
            for reason_id in resolved_reason_ids
        ):
            raise ControlError("eligibility_audit_user_exclusive_reason")
        locked_effective = packet_effective_classification(
            batch, key, packet, proposed_audit=proposed_overlay,
        )
        if args.outcome == "Eligible" and locked_effective != "Eligible":
            raise ControlError("eligibility_audit_cannot_override_unresolved_review")
        if (
            args.result in {"pass", "pass_with_warnings"}
            and args.outcome != locked_effective
        ):
            raise ControlError("eligibility_audit_outcome_not_reduced")
        if (
            args.result == "fail"
            and args.outcome == "Needs Review"
            and locked_effective != "Needs Review"
        ):
            raise ControlError("eligibility_audit_outcome_not_reduced")
        current = locked_current
        events = read_jsonl(events_path)
        version = 1 + sum(
            event.get("event_type") == "eligibility_audit_resolution"
            and event.get("job_key") == key
            for event in events
        )
        overlay = {
            "schema_version": 1,
            "event_type": "eligibility_audit_resolution",
            "at": now(),
            "batch_id": args.batch_id,
            "track": args.track,
            "job_key": key,
            "actor": args.actor,
            "resolution_version": version,
            "packet_sha256": packet_hash,
            "result": args.result,
            "outcome": args.outcome,
            "resolved_reason_ids": resolved_reason_ids,
            "resolved_hard_exclusion_rules": resolved_hard_rules,
            "resolved_unresolved_items": resolved_unresolved_items,
            "resolved_blocker_ids": resolved_blocker_ids,
            "covered_trigger_ids": covered_trigger_ids,
            "eligibility_trigger_ids": trigger_snapshot["trigger_ids"],
            "eligibility_trigger_version": trigger_snapshot["trigger_version"],
            "evidence": evidence,
        }
        append_jsonl_unlocked(events_path, overlay)
        if args.result in {"pass", "pass_with_warnings"} and args.outcome == "Eligible":
            append_jsonl_unlocked(events_path, {
                "schema_version": 1,
                "event_type": "gate",
                "at": now(),
                "batch_id": args.batch_id,
                "track": args.track,
                "job_key": key,
                "gate_type": "eligibility_audit",
                "actor": args.actor,
                "result": "pass",
                "audit_result": args.result,
                "packet_sha256": packet_hash,
                "eligibility_trigger_ids": trigger_snapshot["trigger_ids"],
                "eligibility_trigger_version": trigger_snapshot["trigger_version"],
                "evidence": evidence,
            })
        if current != args.outcome:
            append_jsonl_unlocked(events_path, {
                "schema_version": 1,
                "event_type": "state_transition",
                "at": now(),
                "batch_id": args.batch_id,
                "track": args.track,
                "job_key": key,
                "actor": args.actor,
                "from_state": current,
                "to_state": args.outcome,
                "evidence": evidence,
                "affected_paths": [],
                "blocked_kind": (
                    "terminal" if args.outcome == "Blocked" else None
                ),
                "resolution_overlay_version": version,
            })
    return {
        "job_key": key,
        "result": args.result,
        "outcome": args.outcome,
        "resolution_version": version,
    }


def question_status(batch: Path, key: str, reason_id: str) -> dict[str, Any]:
    return latest_review_resolutions(batch, key).get(reason_id, {})


def record_user_decision(args: argparse.Namespace) -> dict[str, Any]:
    key = safe_id(args.job_key, "job_key")
    review_type = safe_id(args.review_type, "review_type")
    if review_type not in REVIEW_TYPES:
        raise ControlError("invalid_review_type")
    if args.actor != "lead":
        raise ControlError("only_lead_may_record_user_decision")
    batch, manifest = require_batch(args.track, args.batch_id)
    modern = manifest.get("schema_version", 1) >= 2
    packet = None
    packet_hash = None
    review = None
    if modern:
        if job_state(batch, key) != "Needs Review":
            raise ControlError("review_resolution_requires_needs_review_state")
        packet, packet_hash, _ = load_valid_packet(batch, args.track, key)
        candidates = [
            item for item in job_review_reasons(batch, key, packet)
            if item.get("review_type") == review_type
            and (
                args.reason_id is None
                or review_reason_id(
                    key, review_type, item.get("reason_id"),
                ) == args.reason_id
            )
        ]
        if len(candidates) != 1:
            raise ControlError(
                "review_reason_id_required"
                if len(candidates) > 1
                else "review_reason_not_found"
            )
        review = candidates[0]
        reason_id = review_reason_id(
            key, review_type, review.get("reason_id"),
        )
        fingerprint = review.get("question_fingerprint") or question_fingerprint(
            key, review_type, reason_id,
        )
    else:
        reason_id = (
            safe_id(args.reason_id, "reason_id")
            if args.reason_id
            else question_fingerprint(key, review_type)
        )
        fingerprint = question_fingerprint(key, review_type)
    prior = question_status(batch, key, reason_id)
    prior_status = prior.get("resolution_status")
    if prior and prior_status in {"resolved", "skipped"}:
        if prior.get("decision") != args.decision:
            raise ControlError("review_reason_already_final")
        return {
            "question_fingerprint": fingerprint,
            "reason_id": reason_id,
            "decision": prior["decision"],
            "resolution_status": prior_status,
            "reused": True,
        }
    allowed = REVIEW_DECISIONS[review_type]
    if args.decision not in allowed:
        raise ControlError(
            "experience_gap_review_continue_or_skip_only"
            if review_type == "continue_despite_experience_gap"
            else "unsupported_review_decision"
        )
    if modern:
        if (
            args.decision not in set(review.get("allowed_decisions", []))
            and not (
                args.decision == "resolve"
                and review_type in {
                    "unsupported_factual_answer",
                    "sensitive_declaration",
                    "document_request",
                }
            )
        ):
            raise ControlError("review_decision_not_allowed")
        if review_type == "continue_despite_experience_gap" and not any(
            (
                gap.get("question_fingerprint") == fingerprint
                or gap.get("requirement_id") == reason_id
            )
            and gap.get("requirement_level") != "mandatory"
            and gap.get("handling") == "continue_despite_experience_gap"
            for gap in packet.get("experience_gaps", [])
        ):
            raise ControlError("experience_gap_resolution_scope_invalid")
        if args.decision == "resolve" and not args.evidence_path:
            raise ControlError("review_resolution_evidence_required")
        resolution_evidence = (
            evidence_reference(batch, args.evidence_path)
            if args.evidence_path else None
        )
        resolution_status = (
            "skipped" if args.decision == "skip"
            else "remain_paused" if args.decision == "remain_paused"
            else "resolved"
        )
        resulting = (
            "Skipped"
            if args.decision == "skip"
            else "Needs Review"
            if args.decision == "remain_paused"
            else packet_effective_classification(
                batch, key, packet, {reason_id: args.decision},
            )
        )
    else:
        resolution_evidence = None
        resolution_status = (
            "skipped" if args.decision == "skip"
            else "remain_paused" if args.decision == "remain_paused"
            else "resolved"
        )
        resulting = None
    event = {
        "schema_version": 1,
        "event_type": "user_decision",
        "at": now(),
        "batch_id": args.batch_id,
        "track": args.track,
        "job_key": key,
        "review_type": review_type,
        "question_fingerprint": fingerprint,
        "decision": args.decision,
        "reason_id": reason_id,
        "resolution_status": resolution_status,
        "allowed_results": sorted(allowed),
        "effect": (
            "terminal_skip"
            if args.decision == "skip"
            else "immutable_resolution_overlay"
            if modern
            else "processing_authorisation_only"
        ),
        "candidate_facts_changed": False,
        "evidence": resolution_evidence,
    }
    events_path = batch / "events.jsonl"
    if modern:
        with exclusive_lock(events_path):
            if job_state(batch, key) != "Needs Review":
                raise ControlError("review_resolution_requires_needs_review_state")
            locked_candidates = [
                item for item in job_review_reasons(batch, key, packet)
                if item.get("review_type") == review_type
                and review_reason_id(
                    key, review_type, item.get("reason_id"),
                ) == reason_id
            ]
            if len(locked_candidates) != 1:
                raise ControlError("review_reason_changed_concurrently")
            review = locked_candidates[0]
            locked_prior = question_status(batch, key, reason_id)
            locked_prior_status = locked_prior.get("resolution_status")
            if locked_prior and locked_prior_status in {"resolved", "skipped"}:
                if locked_prior.get("decision") != args.decision:
                    raise ControlError("review_reason_already_final")
                return {
                    "question_fingerprint": fingerprint,
                    "reason_id": reason_id,
                    "decision": locked_prior["decision"],
                    "resolution_status": locked_prior_status,
                    "reused": True,
                }
            resulting = (
                "Skipped"
                if args.decision == "skip"
                else "Needs Review"
                if args.decision == "remain_paused"
                else packet_effective_classification(
                    batch, key, packet, {reason_id: args.decision},
                )
            )
            event["resolution_status"] = resolution_status
            events = read_jsonl(events_path)
            append_jsonl_unlocked(events_path, event)
            overlay = {
                "schema_version": 1,
                "event_type": "eligibility_resolution",
                "at": now(),
                "batch_id": args.batch_id,
                "track": args.track,
                "job_key": key,
                "actor": "lead",
                "resolution_version": 1 + sum(
                    item.get("event_type") == "eligibility_resolution"
                    and item.get("job_key") == key
                    for item in events
                ),
                "packet_sha256": packet_hash,
                "reason_id": reason_id,
                "review_type": review_type,
                "allowed_results": sorted(allowed),
                "decision": args.decision,
                "resolution_status": resolution_status,
                "resolved_unresolved_items": (
                    review.get("unresolved_item_ids", [])
                    if resolution_status == "resolved" else []
                ),
                "resulting_classification": resulting,
                "evidence": resolution_evidence,
            }
            append_jsonl_unlocked(events_path, overlay)
            if resulting != "Needs Review":
                append_jsonl_unlocked(events_path, {
                    "schema_version": 1,
                    "event_type": "state_transition",
                    "at": now(),
                    "batch_id": args.batch_id,
                    "track": args.track,
                    "job_key": key,
                    "actor": "lead",
                    "from_state": "Needs Review",
                    "to_state": resulting,
                    "evidence": None,
                    "affected_paths": [],
                    "blocked_kind": None,
                    "resolution_overlay_version": overlay["resolution_version"],
                })
    else:
        append_jsonl(batch / "events.jsonl", event)
    return {
        "question_fingerprint": fingerprint,
        "reason_id": reason_id,
        "decision": args.decision,
        "resolution_status": resolution_status,
        "resulting_classification": resulting,
        "reused": False,
    }


def record_review_reason(args: argparse.Namespace) -> dict[str, Any]:
    key = safe_id(args.job_key, "job_key")
    review_type = safe_id(args.review_type, "review_type")
    reason_id = safe_id(args.reason_id, "reason_id")
    if review_type not in REVIEW_TYPES:
        raise ControlError("invalid_review_type")
    if args.actor not in {"submission", "lead"}:
        raise ControlError("review_reason_actor_invalid")
    batch, _ = require_batch(args.track, args.batch_id)
    packet, packet_hash, _ = load_valid_packet(batch, args.track, key)
    unresolved_item_ids = list(dict.fromkeys(args.unresolved_item or []))
    evidence = evidence_reference(batch, args.evidence_path)
    fingerprint = question_fingerprint(key, review_type, reason_id)
    events_path = batch / "events.jsonl"
    with exclusive_lock(events_path):
        current = job_state(batch, key)
        if current in {"Submitted", "Submission Verified"} or (
            current == "Blocked" and post_submit_attempt_state(batch, key) is not None
        ):
            raise ControlError("post_submit_issue_requires_confirmation_path")
        if current not in {
            "Package Prepared", "Awaiting User Review", "Submission Ready",
            "Needs Review",
        }:
            raise ControlError("review_reason_wrong_state")
        if any(
            review_reason_id(key, item["review_type"], item.get("reason_id"))
            == reason_id
            for item in job_review_reasons(batch, key, packet)
        ):
            raise ControlError("duplicate_review_reason_id")
        append_jsonl_unlocked(events_path, {
            "schema_version": 1,
            "event_type": "review_reason_added",
            "at": now(),
            "batch_id": args.batch_id,
            "track": args.track,
            "job_key": key,
            "actor": args.actor,
            "packet_sha256": packet_hash,
            "reason_id": reason_id,
            "review_type": review_type,
            "question_fingerprint": fingerprint,
            "allowed_decisions": sorted(REVIEW_DECISIONS[review_type]),
            "unresolved_item_ids": unresolved_item_ids,
            "evidence": evidence,
        })
        if current != "Needs Review":
            append_jsonl_unlocked(events_path, {
                "schema_version": 1,
                "event_type": "state_transition",
                "at": now(),
                "batch_id": args.batch_id,
                "track": args.track,
                "job_key": key,
                "actor": args.actor,
                "from_state": current,
                "to_state": "Needs Review",
                "evidence": evidence,
                "affected_paths": [],
                "blocked_kind": None,
            })
    return {
        "job_key": key,
        "reason_id": reason_id,
        "question_fingerprint": fingerprint,
        "state": "Needs Review",
    }


def submission_review_payload(batch: Path, value: Any) -> dict[str, Any]:
    item = require_exact_keys(
        value,
        {
            "job_url", "page_fingerprint", "answers_path", "attachment_paths",
            "declarations_sha256",
        },
        "submission_review",
    )
    require_string(item.get("job_url"), "submission_review_job_url")
    if not re.fullmatch(r"[a-f0-9]{64}", str(item.get("page_fingerprint", ""))):
        raise ControlError("submission_review_page_fingerprint_required")
    if not re.fullmatch(r"[a-f0-9]{64}", str(item.get("declarations_sha256", ""))):
        raise ControlError("submission_review_declarations_hash_required")
    paths = [item.get("answers_path")]
    attachments = item.get("attachment_paths")
    if not isinstance(attachments, list) or not attachments:
        raise ControlError("submission_review_attachments_required")
    paths.extend(attachments)
    if not all(isinstance(path, str) and path for path in paths):
        raise ControlError("submission_review_paths_required")
    artifacts = [evidence_reference(batch, path) for path in paths]
    normalized_payload = {
        "job_url": item["job_url"],
        "page_fingerprint": item["page_fingerprint"],
        "answers": artifacts[0],
        "attachments": artifacts[1:],
        "declarations_sha256": item["declarations_sha256"],
    }
    digest = hashlib.sha256(json.dumps(
        normalized_payload, sort_keys=True, separators=(",", ":"),
    ).encode()).hexdigest()
    return {**normalized_payload, "review_id": "review-" + digest[:24]}


def submission_review_cycle_snapshot(
    events: list[dict[str, Any]], key: str,
) -> dict[str, Any] | None:
    """Return the current Awaiting User Review cycle for a job.

    New events carry an explicit cycle ID. Existing schema-v2 batches remain
    readable through a deterministic event-position fallback.
    """
    latest: dict[str, Any] | None = None
    for index, event in enumerate(events):
        if (
            event.get("event_type") == "state_transition"
            and event.get("job_key") == key
            and event.get("to_state") == "Awaiting User Review"
        ):
            cycle_id = event.get("submission_review_cycle_id")
            if not isinstance(cycle_id, str) or not cycle_id:
                cycle_id = f"legacy-review-cycle-{index + 1}"
            latest = {
                "cycle_id": cycle_id,
                "event_index": index,
                "event": event,
            }
    return latest


def current_submission_review_event(
    events: list[dict[str, Any]], key: str,
) -> tuple[dict[str, Any], dict[str, Any], int] | None:
    """Return the latest review created inside the current review cycle."""
    cycle = submission_review_cycle_snapshot(events, key)
    if cycle is None:
        return None
    for index in range(len(events) - 1, cycle["event_index"], -1):
        event = events[index]
        if (
            event.get("event_type") != "submission_review"
            or event.get("job_key") != key
        ):
            continue
        event_cycle = event.get("submission_review_cycle_id")
        if (
            isinstance(event_cycle, str)
            and event_cycle
            and event_cycle != cycle["cycle_id"]
        ):
            continue
        return event, cycle, index
    return None


def record_submission_review(args: argparse.Namespace) -> dict[str, Any]:
    key = safe_id(args.job_key, "job_key")
    batch, _ = require_batch(args.track, args.batch_id)
    if args.actor != "submission" or job_state(batch, key) != "Awaiting User Review":
        raise ControlError("submission_review_actor_or_state_invalid")
    if not role_owned(batch, key, "submission", args.actor):
        raise ControlError("submission_review_ownership_required")
    packet, packet_hash, _ = load_valid_packet(batch, args.track, key)
    review = submission_review_payload(batch, read_json_arg(args.review_json))
    if not packet_matches_url(packet, review["job_url"]):
        raise ControlError("submission_review_job_identity_mismatch")
    evidence = evidence_reference(batch, args.evidence_path)
    events_path = batch / "events.jsonl"
    with exclusive_lock(events_path):
        events = read_jsonl(events_path)
        if job_state(batch, key) != "Awaiting User Review":
            raise ControlError("submission_review_actor_or_state_invalid")
        open_attempts = submission_attempt_lifecycle(events)[
            "open_attempts_by_job"
        ].get(key, [])
        if open_attempts:
            raise ControlError("submission_attempt_confirmation_pending")
        cycle = submission_review_cycle_snapshot(events, key)
        if cycle is None:
            raise ControlError("submission_review_cycle_required")
        ordinal = 1 + sum(
            event.get("event_type") == "submission_review"
            and event.get("job_key") == key
            for event in events
        )
        attempt_seed = (
            f"{args.batch_id}|{key}|{cycle['cycle_id']}|{ordinal}|"
            f"{review['review_id']}"
        )
        attempt_id = "attempt-" + hashlib.sha256(
            attempt_seed.encode(),
        ).hexdigest()[:24]
        event = {
            "schema_version": 1, "event_type": "submission_review", "at": now(),
            "batch_id": args.batch_id, "track": args.track, "job_key": key,
            "actor": args.actor, "packet_sha256": packet_hash, "review": review,
            "submission_attempt_id": attempt_id,
            "submission_review_cycle_id": cycle["cycle_id"],
            "evidence": evidence,
        }
        append_jsonl_unlocked(events_path, event)
    return {
        "job_key": key,
        "review_id": review["review_id"],
        "submission_attempt_id": attempt_id,
        "submission_review_cycle_id": cycle["cycle_id"],
        "approval_required": True,
    }


def latest_submission_review(batch: Path, key: str) -> dict[str, Any] | None:
    return next((
        event for event in reversed(read_jsonl(batch / "events.jsonl"))
        if event.get("event_type") == "submission_review" and event.get("job_key") == key
    ), None)


def record_submission_approval(args: argparse.Namespace) -> dict[str, Any]:
    key = safe_id(args.job_key, "job_key")
    if args.actor != "lead":
        raise ControlError("only_lead_may_record_user_approval")
    batch, _ = require_batch(args.track, args.batch_id)
    if job_state(batch, key) != "Awaiting User Review":
        raise ControlError("submission_approval_wrong_state")
    events_path = batch / "events.jsonl"
    evidence = evidence_reference(batch, args.evidence_path)
    with exclusive_lock(events_path):
        events = read_jsonl(events_path)
        if job_state(batch, key) != "Awaiting User Review":
            raise ControlError("submission_approval_wrong_state")
        current = current_submission_review_event(events, key)
        if current is None:
            raise ControlError("current_submission_review_required")
        review, cycle, review_index = current
        if review.get("review", {}).get("review_id") != args.review_id:
            raise ControlError("current_submission_review_required")
        attempt_id = review.get("submission_attempt_id")
        if not isinstance(attempt_id, str):
            attempt_id = "legacy-" + args.review_id
        existing = next((
            event for event in reversed(events[review_index + 1:])
            if event.get("event_type") == "submission_approval"
            and event.get("job_key") == key
            and event.get("submission_attempt_id") == attempt_id
            and event.get("submission_review_cycle_id", cycle["cycle_id"])
            == cycle["cycle_id"]
        ), None)
        if existing:
            return {
                "job_key": key,
                "review_id": args.review_id,
                "submission_attempt_id": attempt_id,
                "submission_review_cycle_id": cycle["cycle_id"],
                "approved": True,
                "reused": True,
            }
        event = {
            "schema_version": 1, "event_type": "submission_approval", "at": now(),
            "batch_id": args.batch_id, "track": args.track, "job_key": key,
            "actor": "lead", "approved_by": "user", "scope": "single_job_single_review",
            "review_id": args.review_id, "packet_sha256": review["packet_sha256"],
            "submission_attempt_id": attempt_id,
            "submission_review_cycle_id": cycle["cycle_id"],
            "evidence": evidence,
        }
        append_jsonl_unlocked(events_path, event)
    return {
        "job_key": key,
        "review_id": args.review_id,
        "submission_attempt_id": attempt_id,
        "submission_review_cycle_id": cycle["cycle_id"],
        "approved": True,
        "reused": False,
    }


def require_submission_approval(
    batch: Path, key: str, packet_hash: str,
) -> dict[str, Any]:
    events = read_jsonl(batch / "events.jsonl")
    current = current_submission_review_event(events, key)
    if current is None:
        raise ControlError("current_submission_review_required")
    review, cycle, review_index = current
    if review.get("packet_sha256") != packet_hash:
        raise ControlError("current_submission_review_required")
    review_id = review.get("review", {}).get("review_id")
    attempt_id = review.get("submission_attempt_id")
    if not isinstance(attempt_id, str):
        attempt_id = "legacy-" + str(review_id)
    open_attempts = submission_attempt_lifecycle(events)[
        "open_attempts_by_job"
    ].get(key, [])
    if open_attempts:
        raise ControlError("submission_attempt_confirmation_pending")
    approval = next((
        event for event in reversed(events[review_index + 1:])
        if event.get("event_type") == "submission_approval"
        and event.get("job_key") == key and event.get("review_id") == review_id
        and event.get("submission_attempt_id", attempt_id) == attempt_id
        and event.get("submission_review_cycle_id", cycle["cycle_id"])
        == cycle["cycle_id"]
    ), None)
    if not approval or approval.get("approved_by") != "user":
        raise ControlError("explicit_user_submission_approval_required")
    if any(
        event.get("event_type") == "state_transition"
        and event.get("job_key") == key
        and event.get("to_state") == "Submitted"
        and event.get("submission_attempt_id") == attempt_id
        for event in events
    ):
        raise ControlError("submission_approval_already_consumed")
    for event in (review, approval):
        record = event.get("evidence")
        if not isinstance(record, dict):
            raise ControlError("submission_review_invalidated")
        try:
            path = public_workspace_path(record.get("path", ""))
        except ControlError as exc:
            raise ControlError("submission_review_invalidated") from exc
        if not path.is_file() or sha256(path) != record.get("sha256"):
            raise ControlError("submission_review_invalidated")
    payload = review.get("review", {})
    for record in [payload.get("answers"), *payload.get("attachments", [])]:
        if not isinstance(record, dict):
            raise ControlError("submission_review_invalidated")
        try:
            path = public_workspace_path(record.get("path", ""))
        except ControlError as exc:
            raise ControlError("submission_review_invalidated") from exc
        if not path.is_file() or sha256(path) != record.get("sha256"):
            raise ControlError("submission_review_invalidated")
    return {
        "submission_attempt_id": attempt_id,
        "submission_review_cycle_id": cycle["cycle_id"],
        "review_id": review_id,
        "review": review,
        "approval": approval,
    }


def claim_role(args: argparse.Namespace) -> dict[str, Any]:
    key = safe_id(args.job_key, "job_key")
    role = safe_id(args.role, "role")
    actor = validate_actor(args.actor)
    batch, _ = require_batch(args.track, args.batch_id)
    allowed_states = {
        "discovery": {None, "Discovered"},
        "eligibility-audit": {"Assessed", "Eligible", "Needs Review"},
        "materials": {"Eligible"},
        "submission": {"Package Prepared", "Awaiting User Review", "Submission Ready", "Failed"},
        "confirmation-audit": {"Submitted"},
    }
    current_state = job_state(batch, key)
    post_submit_confirmation_recovery = (
        role == "confirmation-audit"
        and current_state == "Blocked"
        and post_submit_attempt_state(batch, key) is not None
    )
    if (
        role not in WORKER_ROLES
        or actor != ROLE_ACTOR[role]
        or (
            current_state not in allowed_states[role]
            and not post_submit_confirmation_recovery
        )
    ):
        raise ControlError("role_claim_not_allowed")
    events_path = batch / "events.jsonl"
    with exclusive_lock(events_path):
        current_state = job_state(batch, key)
        post_submit_confirmation_recovery = (
            role == "confirmation-audit"
            and current_state == "Blocked"
            and post_submit_attempt_state(batch, key) is not None
        )
        if (
            current_state not in allowed_states[role]
            and not post_submit_confirmation_recovery
        ):
            raise ControlError("role_claim_not_allowed")
        for event in reversed(read_jsonl(events_path)):
            if event.get("event_type") == "role_claim" and event.get("job_key") == key and event.get("role") == role:
                if event.get("actor") != actor:
                    raise ControlError("role_already_owned")
                return {"role": role, "actor": actor, "reused": True}
        append_jsonl_unlocked(events_path, {
            "schema_version": 1, "event_type": "role_claim", "at": now(),
            "batch_id": args.batch_id, "track": args.track, "job_key": key,
            "role": role, "actor": actor,
        })
    return {"role": role, "actor": actor, "reused": False}


def submission_role_owned(batch: Path, key: str, actor: str) -> bool:
    return any(
        event.get("event_type") == "role_claim"
        and event.get("job_key") == key
        and event.get("role") == "submission"
        and event.get("actor") == actor
        for event in read_jsonl(batch / "events.jsonl")
    )


def parse_private_field(text: str, field: str) -> str:
    ordinary_compatibility_aliases = {
        "full_name": {"full name", "legal name", "name", "legal / passport name", "legal/passport name", "passport name"},
        "preferred_name": {"preferred name"},
        "title": {"title", "salutation"},
        "email": {"email", "email address"},
        "phone": {"phone", "phone number", "mobile", "mobile number"},
    }
    aliases = PRIVATE_FIELD_LABELS.get(field) or ordinary_compatibility_aliases.get(field)
    if not aliases:
        raise ControlError("private_field_not_approved")
    for raw in text.splitlines():
        line = raw.strip()
        if not line:
            continue
        table = re.fullmatch(r"\|\s*([^|]+?)\s*\|\s*([^|]+?)\s*\|", line)
        if table and normalized(table.group(1)) in aliases:
            value = table.group(2).strip()
            if value and normalized(value) not in {"value", "details"}:
                return value
        pair = re.fullmatch(r"(?:[-*]\s*)?([^:]+):\s*(.+)", line)
        if pair and normalized(pair.group(1)) in aliases:
            return pair.group(2).strip()
    raise ControlError("private_field_not_found")


def private_field(args: argparse.Namespace) -> dict[str, Any]:
    # Returning a sensitive value through a CLI necessarily exposes it to stdout
    # and the invoking model. Keep the compatibility command but fail closed.
    raise ControlError("manual_sensitive_input_required")


def replay_agent_calls(events: list[dict[str, Any]]) -> dict[str, Any]:
    records: dict[str, dict[str, Any]] = {}
    completions: list[dict[str, Any]] = []
    starts = 0
    for event in events:
        if event.get("event_type") != "agent_call":
            continue
        call_id = event.get("call_id")
        phase = event.get("phase")
        if not isinstance(call_id, str) or not call_id:
            raise ControlError("agent_call_invalid_call_id")
        if phase == "start":
            if call_id in records:
                raise ControlError("agent_call_id_reused")
            records[call_id] = {
                "state": "active",
                "worker_role": event.get("worker_role"),
                "job_key": event.get("job_key"),
            }
            starts += 1
        elif phase == "complete":
            record = records.get(call_id)
            if record is None:
                raise ControlError("agent_call_complete_before_start")
            if record["state"] == "complete":
                raise ControlError("agent_call_duplicate_complete")
            if (
                record["worker_role"] != event.get("worker_role")
                or record["job_key"] != event.get("job_key")
            ):
                raise ControlError("agent_call_completion_identity_mismatch")
            record["state"] = "complete"
            completions.append(event)
        else:
            raise ControlError("agent_call_invalid_phase")
    return {
        "records": records,
        "active": {
            call_id: record
            for call_id, record in records.items()
            if record["state"] == "active"
        },
        "starts": starts,
        "completions": completions,
    }


def agent_policy_extensions(events: list[dict[str, Any]]) -> int:
    return sum(
        event.get("additional_calls", 0)
        for event in events
        if event.get("event_type") == "agent_policy_extension"
        and isinstance(event.get("additional_calls"), int)
        and event.get("additional_calls", 0) > 0
    )


def agent_events_after_reset(
    events: list[dict[str, Any]],
    worker_role: str,
    job_key_value: str | None = None,
) -> list[dict[str, Any]]:
    reset_index = -1
    for index, event in enumerate(events):
        if (
            event.get("event_type") == "agent_policy_extension"
            and event.get("worker_role") == worker_role
            and (
                event.get("job_key") is None
                or event.get("job_key") == job_key_value
            )
        ):
            reset_index = index
    return events[reset_index + 1:]


def role_no_yield_streak(
    events: list[dict[str, Any]], worker_role: str,
) -> int:
    scoped = agent_events_after_reset(events, worker_role, None)
    completions = [
        event for event in scoped
        if event.get("event_type") == "agent_call"
        and event.get("phase") == "complete"
        and event.get("worker_role") == worker_role
    ]
    count = 0
    for event in reversed(completions):
        if event.get("outcome") != "no_yield":
            break
        count += 1
    return count


def discovery_closeout_work_exists(
    batch: Path, manifest: dict[str, Any],
) -> bool:
    """Return whether discovery reserve calls can close already observed work."""
    state = load_discovery_state(batch, manifest)
    return any(
        candidate.get("status") in {"unseen", "claimed", "full_ad_opened"}
        for candidate in state.get("candidates", {}).values()
    )


def record_agent_call(args: argparse.Namespace) -> dict[str, Any]:
    call_id = safe_id(args.call_id, "call_id")
    worker_role = safe_id(args.worker_role, "worker_role")
    batch, manifest = require_batch(args.track, args.batch_id)
    if args.actor != "lead":
        raise ControlError("only_lead_may_delegate")
    if worker_role not in WORKER_ROLES:
        raise ControlError("invalid_worker_role")
    job_key_value = safe_id(args.job_key, "job_key") if args.job_key else None
    policy = batch_policy(manifest)["limits"]
    events_path = batch / "events.jsonl"
    with exclusive_lock(events_path):
        events = read_jsonl(events_path)
        lifecycle = replay_agent_calls(events)
        active = lifecycle["active"]
        effective_total_budget = (
            policy["max_total_agent_calls"] + agent_policy_extensions(events)
        )
        if args.phase == "start":
            if call_id in lifecycle["records"]:
                raise ControlError("agent_call_id_reused")
            if lifecycle["starts"] >= effective_total_budget:
                raise ControlError("total_agent_call_limit")
            if (
                worker_role == "discovery"
                and effective_total_budget > 3
                and lifecycle["starts"] >= effective_total_budget - 3
                and not discovery_closeout_work_exists(batch, manifest)
            ):
                raise ControlError("agent_call_closeout_reserve")
            if len(active) >= policy["max_active_workers"]:
                raise ControlError("subagent_concurrency_limit")
            if (
                worker_role == "discovery"
                and sum(
                    record["worker_role"] == "discovery"
                    for record in active.values()
                ) >= policy["max_discovery_workers"]
            ):
                raise ControlError("discovery_worker_concurrency_limit")
            scoped_events = agent_events_after_reset(
                events, worker_role, job_key_value,
            )
            failed_attempts = sum(
                event.get("phase") == "complete"
                and event.get("worker_role") == worker_role
                and event.get("job_key") == job_key_value
                and event.get("outcome") in {"failed", "no_yield"}
                for event in scoped_events
                if event.get("event_type") == "agent_call"
            )
            if (
                job_key_value
                and failed_attempts >= policy["max_job_role_attempts"]
            ):
                raise ControlError("job_role_retry_limit")
            trailing_no_yield = role_no_yield_streak(
                events, worker_role,
            )
            if trailing_no_yield >= policy["max_consecutive_no_yield_calls"]:
                raise ControlError("low_yield_circuit_open")
            activate_batch(batch, manifest)
        else:
            record = active.get(call_id)
            if record is None:
                if call_id in lifecycle["records"]:
                    raise ControlError("agent_call_duplicate_complete")
                raise ControlError("agent_call_complete_before_start")
            if (
                record["worker_role"] != worker_role
                or record["job_key"] != job_key_value
            ):
                raise ControlError("agent_call_completion_identity_mismatch")
        append_jsonl_unlocked(events_path, {
            "schema_version": 1, "event_type": "agent_call", "at": now(),
            "batch_id": args.batch_id, "track": args.track, "actor": args.actor,
            "call_id": call_id, "worker_role": worker_role,
            "job_key": job_key_value, "phase": args.phase,
            "outcome": args.outcome if args.phase == "complete" else None,
        })
    return {"call_id": call_id, "phase": args.phase}


def resume_agent_calls(args: argparse.Namespace) -> dict[str, Any]:
    if args.actor != "lead" or not args.user_authorized:
        raise ControlError("explicit_user_authorization_required")
    worker_role = safe_id(args.worker_role, "worker_role")
    if worker_role not in WORKER_ROLES:
        raise ControlError("invalid_worker_role")
    if args.additional_calls < 0 or args.additional_calls > 100:
        raise ControlError("invalid_agent_call_extension")
    job_key_value = safe_id(args.job_key, "job_key") if args.job_key else None
    batch, manifest = require_batch(args.track, args.batch_id)
    evidence = evidence_reference(batch, args.evidence_path)
    events_path = batch / "events.jsonl"
    with exclusive_lock(events_path):
        events = read_jsonl(events_path)
        circuit_streak = role_no_yield_streak(events, worker_role)
        circuit_open = (
            circuit_streak
            >= batch_policy(manifest)["limits"]["max_consecutive_no_yield_calls"]
        )
        if job_key_value is not None and circuit_open:
            raise ControlError("role_circuit_requires_role_wide_reset")
        event = {
            "schema_version": 1,
            "event_type": "agent_policy_extension",
            "at": now(),
            "batch_id": args.batch_id,
            "track": args.track,
            "actor": "lead",
            "authorized_by": "user",
            "worker_role": worker_role,
            "job_key": job_key_value,
            "additional_calls": args.additional_calls,
            "frozen_base_limit": batch_policy(manifest)["limits"][
                "max_total_agent_calls"
            ],
            "evidence": evidence,
        }
        append_jsonl_unlocked(events_path, event)
    role_wide = job_key_value is None
    return {
        "worker_role": worker_role,
        "job_key": job_key_value,
        "additional_calls": args.additional_calls,
        "reset_scope": "role" if role_wide else "job_role",
        "job_retry_reset": True,
        "role_circuit_reset": role_wide,
        "circuit_reset": role_wide,
        "role_circuit_was_open": circuit_open,
        "role_circuit_open_after_reset": False if role_wide else circuit_open,
    }


def normalized_site_id(value: str) -> str:
    site = re.sub(r"[^a-z0-9]+", "-", normalized(value)).strip("-")
    if not site:
        raise ControlError("invalid_site_id")
    return site[:120]


CONTROL_RISK_SIGNALS = {"material_risk", "state_unreliable"}


def control_signal_identifier(event: dict[str, Any], index: int) -> str:
    signal_id = event.get("control_signal_id")
    if isinstance(signal_id, str) and signal_id:
        return signal_id
    seed = "|".join((
        str(event.get("batch_id", "")),
        str(event.get("event_type", "")),
        str(event.get("job_key", "")),
        str(event.get("at", "")),
        str(index),
    ))
    return "legacy-signal-" + hashlib.sha256(seed.encode()).hexdigest()[:24]


def unresolved_control_signals(
    events: list[dict[str, Any]],
) -> dict[str, list[dict[str, Any]]]:
    signals: dict[str, dict[str, Any]] = {}
    resolved: set[str] = set()
    for index, event in enumerate(events):
        event_type = event.get("event_type")
        if event_type in CONTROL_RISK_SIGNALS:
            signal_id = control_signal_identifier(event, index)
            signals[signal_id] = {
                "control_signal_id": signal_id,
                "signal": event_type,
                "job_key": event.get("job_key"),
                "event": event,
            }
        elif event_type == "control_signal_resolution":
            signal_id = event.get("control_signal_id")
            if (
                isinstance(signal_id, str)
                and event.get("resolution") == "resolved"
            ):
                resolved.add(signal_id)
    active = {
        signal_id: item for signal_id, item in signals.items()
        if signal_id not in resolved
    }
    return {
        signal: sorted(
            (
                item for item in active.values()
                if item["signal"] == signal
            ),
            key=lambda item: item["control_signal_id"],
        )
        for signal in sorted(CONTROL_RISK_SIGNALS)
    }


def record_control_signal(args: argparse.Namespace) -> dict[str, Any]:
    if args.actor not in (ACTORS - {"user"}):
        raise ControlError("control_signal_agent_actor_required")
    batch, _ = require_batch(args.track, args.batch_id)
    if args.signal == "manual_takeover_required" and not args.site_id:
        raise ControlError("manual_takeover_site_required")
    site_id = (
        normalized_site_id(args.site_id)
        if args.signal == "manual_takeover_required"
        else None
    )
    job_key_value = (
        safe_id(args.job_key, "job_key") if args.job_key else None
    )
    evidence = evidence_reference(batch, args.evidence_path)
    events_path = batch / "events.jsonl"
    with exclusive_lock(events_path):
        events = read_jsonl(events_path)
        if site_id and any(
            event.get("event_type") == "manual_takeover_required"
            and event.get("site_id") == site_id
            for event in events
        ):
            return {
                "signal": args.signal,
                "site_id": site_id,
                "reused": True,
            }
        if args.signal in CONTROL_RISK_SIGNALS:
            active = unresolved_control_signals(events)[args.signal]
            for item in active:
                event = item["event"]
                if (
                    event.get("job_key") == job_key_value
                    and isinstance(event.get("evidence"), dict)
                    and event["evidence"].get("sha256") == evidence["sha256"]
                ):
                    return {
                        "signal": args.signal,
                        "control_signal_id": item["control_signal_id"],
                        "site_id": None,
                        "reused": True,
                    }
        ordinal = 1 + sum(
            event.get("event_type") == args.signal for event in events
        )
        signal_seed = "|".join((
            args.batch_id, args.signal, job_key_value or "", str(ordinal),
            evidence["sha256"],
        ))
        signal_id = "signal-" + hashlib.sha256(
            signal_seed.encode(),
        ).hexdigest()[:24]
        append_jsonl_unlocked(events_path, {
            "schema_version": 1,
            "event_type": args.signal,
            "at": now(),
            "batch_id": args.batch_id,
            "track": args.track,
            "actor": args.actor,
            "job_key": job_key_value,
            "site_id": site_id,
            "control_signal_id": signal_id,
            "evidence": evidence,
        })
    return {
        "signal": args.signal,
        "control_signal_id": signal_id,
        "site_id": site_id,
        "reused": False,
    }


def resolve_control_signal(args: argparse.Namespace) -> dict[str, Any]:
    if args.actor != "lead" or not args.user_authorized:
        raise ControlError("explicit_user_authorization_required")
    signal_id = safe_id(args.signal_id, "signal_id")
    batch, _ = require_batch(args.track, args.batch_id)
    evidence = evidence_reference(batch, args.evidence_path)
    events_path = batch / "events.jsonl"
    with exclusive_lock(events_path):
        events = read_jsonl(events_path)
        active = unresolved_control_signals(events)
        active_by_id = {
            item["control_signal_id"]: item
            for items in active.values() for item in items
        }
        if signal_id not in active_by_id:
            if any(
                event.get("event_type") == "control_signal_resolution"
                and event.get("control_signal_id") == signal_id
                and event.get("resolution") == "resolved"
                for event in events
            ):
                return {
                    "control_signal_id": signal_id,
                    "resolved": True,
                    "reused": True,
                }
            raise ControlError("active_control_signal_required")
        item = active_by_id[signal_id]
        append_jsonl_unlocked(events_path, {
            "schema_version": 1,
            "event_type": "control_signal_resolution",
            "at": now(),
            "batch_id": args.batch_id,
            "track": args.track,
            "actor": "lead",
            "authorized_by": "user",
            "control_signal_id": signal_id,
            "signal": item["signal"],
            "job_key": item.get("job_key"),
            "resolution": "resolved",
            "evidence": evidence,
        })
    return {
        "control_signal_id": signal_id,
        "signal": item["signal"],
        "resolved": True,
        "reused": False,
    }


def submission_attempt_lifecycle(
    events: list[dict[str, Any]],
) -> dict[str, Any]:
    """Replay every submission attempt without allowing a later attempt to hide it."""
    ordered: list[str] = []
    outcomes: dict[str, str] = {}
    attempt_jobs: dict[str, str] = {}
    legacy_ordinals: dict[str, int] = {}
    for event in events:
        if event.get("event_type") != "state_transition":
            continue
        job_key_value = event.get("job_key")
        if not isinstance(job_key_value, str):
            continue
        target = event.get("to_state")
        attempt_id = event.get("submission_attempt_id")
        if target == "Submitted":
            if not isinstance(attempt_id, str) or not attempt_id:
                legacy_ordinals[job_key_value] = (
                    legacy_ordinals.get(job_key_value, 0) + 1
                )
                attempt_id = (
                    f"legacy-state-{job_key_value}-"
                    f"{legacy_ordinals[job_key_value]}"
                )
            if attempt_id in attempt_jobs:
                raise ControlError("submission_attempt_id_reused")
            ordered.append(attempt_id)
            attempt_jobs[attempt_id] = job_key_value
        elif target in {"Failed", "Submission Verified"}:
            if not isinstance(attempt_id, str) or not attempt_id:
                open_for_job = [
                    item for item in ordered
                    if attempt_jobs.get(item) == job_key_value
                    and item not in outcomes
                ]
                attempt_id = open_for_job[-1] if open_for_job else None
            if attempt_id is None:
                # A pre-submit failure is not a submission-attempt result.
                continue
            if attempt_id not in attempt_jobs:
                raise ControlError("submission_attempt_result_without_start")
            if attempt_jobs[attempt_id] != job_key_value:
                raise ControlError("submission_attempt_job_mismatch")
            if attempt_id in outcomes:
                raise ControlError("submission_attempt_duplicate_final_result")
            outcomes[attempt_id] = (
                "verified" if target == "Submission Verified" else "failed"
            )
    open_attempt_ids = [
        attempt_id for attempt_id in ordered if attempt_id not in outcomes
    ]
    open_attempts_by_job: dict[str, list[str]] = {}
    for attempt_id in open_attempt_ids:
        open_attempts_by_job.setdefault(
            attempt_jobs[attempt_id], [],
        ).append(attempt_id)
    # Preserve the historical one-attempt-per-job shape for callers that only
    # need the current attempt, while exposing the complete attempt set too.
    open_attempts = {
        job_key_value: attempt_ids[-1]
        for job_key_value, attempt_ids in open_attempts_by_job.items()
    }
    consecutive_failures = 0
    for attempt_id in reversed(ordered):
        outcome = outcomes.get(attempt_id)
        if outcome == "verified":
            break
        if outcome == "failed":
            consecutive_failures += 1
        # An open Submitted attempt neither increments nor resets the sequence.
    return {
        "ordered": ordered,
        "attempt_jobs": attempt_jobs,
        "outcomes": outcomes,
        "open_attempts": open_attempts,
        "open_attempt_ids": open_attempt_ids,
        "open_attempts_by_job": open_attempts_by_job,
        "consecutive_failures": consecutive_failures,
    }


def failure_limit_terminalizable_attempts(
    events: list[dict[str, Any]],
) -> dict[str, str]:
    lifecycle = submission_attempt_lifecycle(events)
    latest_states: dict[str, str] = {}
    for event in events:
        if event.get("event_type") == "state_transition":
            job_key_value = event.get("job_key")
            state = event.get("to_state")
            if isinstance(job_key_value, str) and isinstance(state, str):
                latest_states[job_key_value] = state
    terminalizable_states = {
        "Failed", "Package Prepared", "Awaiting User Review", "Submission Ready",
    }
    result: dict[str, str] = {}
    for attempt_id in reversed(lifecycle["ordered"]):
        outcome = lifecycle["outcomes"].get(attempt_id)
        if outcome == "verified":
            break
        if outcome != "failed":
            continue
        job_key_value = lifecycle["attempt_jobs"][attempt_id]
        if latest_states.get(job_key_value) in terminalizable_states:
            result.setdefault(job_key_value, attempt_id)
    return result


def role_scope_has_unresolved_work(
    role: str,
    job_key_value: str,
    latest_state: str | None,
    scoped_events: list[dict[str, Any]],
) -> bool:
    """Return whether another call for this role/job is still required."""
    completions = [
        event for event in scoped_events
        if event.get("event_type") == "agent_call"
        and event.get("phase") == "complete"
        and event.get("worker_role") == role
        and event.get("job_key") == job_key_value
    ]
    if not completions:
        return True
    last = completions[-1]
    if last.get("outcome") != "productive":
        return True
    if role == "materials":
        return latest_state not in {
            "Package Prepared", "Awaiting User Review", "Submission Ready",
            "Submitted", "Submission Verified", "Failed", "Skipped",
            "Expired", "Duplicate", "Withdrawn",
        }
    if role == "submission":
        return latest_state not in {
            # Failed is deliberately nonterminal: a not-submitted result
            # requires a fresh reviewed/approved attempt after an authorised
            # retry extension.
            "Submitted", "Submission Verified", "Skipped",
            "Expired", "Duplicate", "Withdrawn",
        }
    if role == "confirmation-audit":
        return latest_state not in {
            "Submission Verified", "Failed", "Skipped", "Expired",
            "Duplicate", "Withdrawn",
        }
    if role == "eligibility-audit":
        return latest_state not in {
            "Eligible", "Skipped", "Blocked", "Needs Review",
            "Expired", "Duplicate", "Withdrawn",
        }
    # Discovery calls are frontier-scoped; a productive job call is complete
    # once it has crossed the ordinary assessment boundary.
    return latest_state not in {
        "Assessed", "Eligible", "Package Prepared", "Awaiting User Review",
        "Submission Ready", "Submitted", "Submission Verified", "Failed",
        "Skipped", "Expired", "Duplicate", "Withdrawn", "Needs Review",
    }


def derive_counters(
    batch: Path,
    manifest: dict[str, Any],
    discovery_state: dict[str, Any] | None = None,
) -> dict[str, Any]:
    events = read_jsonl(batch / "events.jsonl")
    latest_events: dict[str, dict[str, Any]] = {}
    for event in events:
        if event.get("event_type") == "state_transition":
            latest_events[event.get("job_key")] = event
    latest = {
        key: event.get("to_state") for key, event in latest_events.items()
    }
    state = discovery_state or load_discovery_state(batch, manifest)
    integrity = discovery_integrity(batch, manifest, state)
    fully_assessed = integrity["valid_fully_assessed"]
    frontiers = [
        {"partition_id": key, "status": item.get("status")}
        for key, item in state["partitions"].items()
    ]
    unprocessed_candidates = sum(
        item.get("status") in {"unseen", "claimed", "full_ad_opened"}
        for item in state["candidates"].values()
    )
    claimed_or_open_candidates = sum(
        item.get("status") in {"claimed", "full_ad_opened"}
        for item in state["candidates"].values()
    )
    deferred_candidates = sum(
        item.get("status") == "deferred_due_to_batch_stop"
        for item in state["candidates"].values()
    )
    call_lifecycle = replay_agent_calls(events)
    completions = call_lifecycle["completions"]
    agent_limits = batch_policy(manifest)["limits"]
    no_yield_by_role = {
        role: role_no_yield_streak(events, role)
        for role in WORKER_ROLES
    }
    circuit_roles = sorted(
        role for role, count in no_yield_by_role.items()
        if count >= agent_limits["max_consecutive_no_yield_calls"]
    )
    consecutive_no_yield = max(no_yield_by_role.values(), default=0)
    retry_exhausted_scopes: list[str] = []
    started_scopes = {
        (event.get("worker_role"), event.get("job_key"))
        for event in events
        if event.get("event_type") == "agent_call"
        and event.get("phase") == "start"
        and event.get("job_key")
    }
    for role, job_key_value in started_scopes:
        scoped = agent_events_after_reset(events, role, job_key_value)
        failed_attempts = sum(
            event.get("event_type") == "agent_call"
            and event.get("phase") == "complete"
            and event.get("worker_role") == role
            and event.get("job_key") == job_key_value
            and event.get("outcome") in {"failed", "no_yield"}
            for event in scoped
        )
        active_scope = any(
            event.get("event_type") == "agent_call"
            and event.get("phase") == "start"
            and event.get("call_id") in call_lifecycle["active"]
            and event.get("worker_role") == role
            and event.get("job_key") == job_key_value
            for event in scoped
        )
        if (
            failed_attempts >= agent_limits["max_job_role_attempts"]
            and not active_scope
            and role_scope_has_unresolved_work(
                role, job_key_value, latest.get(job_key_value), scoped,
            )
        ):
            retry_exhausted_scopes.append(f"{role}:{job_key_value}")
    effective_call_budget = (
        agent_limits["max_total_agent_calls"] + agent_policy_extensions(events)
    )
    submission_attempts = submission_attempt_lifecycle(events)
    submission_failures = submission_attempts["consecutive_failures"]
    failure_terminalizable = failure_limit_terminalizable_attempts(events)
    unresolved_submission_confirmations = len(
        submission_attempts["open_attempt_ids"]
    )
    frontier = frontier_summary(state)
    all_frontiers_terminal = frontier["all_complete"]
    active_frontiers = frontier["active"]
    reserve_active = (
        effective_call_budget > 3
        and call_lifecycle["starts"] >= effective_call_budget - 3
    )
    discovery_closeout_work = unprocessed_candidates > 0
    discovery_paused = (
        reserve_active
        and not discovery_closeout_work
        and active_frontiers > 0
    )
    active_control_signals = unresolved_control_signals(events)
    needs_review = sum(state == "Needs Review" for state in latest.values())
    waiting_user_blocked = sum(
        event.get("to_state") == "Blocked"
        and event.get("blocked_kind") == "waiting_user"
        for event in latest_events.values()
    )
    recoverable_blocked = sum(
        event.get("to_state") == "Blocked"
        and event.get("blocked_kind") in {None, "recoverable"}
        for event in latest_events.values()
    )
    automatic_states = {
        "Discovered", "Assessed", "Eligible", "Package Prepared",
        "Awaiting User Review", "Submission Ready", "Submitted", "Failed",
    }
    automatically_processable = (
        sum(state in automatic_states for state in latest.values())
        + recoverable_blocked
        + unprocessed_candidates
        + len(integrity["errors"])
        + unresolved_submission_confirmations
    )
    pending_user_items = needs_review + waiting_user_blocked
    completion_states = {
        "Skipped", "Expired", "Duplicate", "Submission Verified", "Withdrawn",
    }
    jobs_complete = all(
        state in completion_states
        or (
            state == "Blocked"
            and latest_events[key].get("blocked_kind") == "terminal"
            and not submission_attempts["open_attempts_by_job"].get(key)
        )
        for key, state in latest.items()
    )
    eligible_count = sum(state in {
        "Eligible", "Package Prepared", "Awaiting User Review", "Submission Ready",
        "Submitted", "Submission Verified",
    } for state in latest.values())
    return {
        "policy_source": batch_policy_source(manifest),
        "agent_calls": call_lifecycle["starts"],
        "active_agent_calls": len(call_lifecycle["active"]),
        "active_agent_call_ids": sorted(call_lifecycle["active"]),
        "effective_agent_call_budget": effective_call_budget,
        "remaining_agent_call_budget": max(0, effective_call_budget - call_lifecycle["starts"]),
        "closeout_reserve_calls": 3 if effective_call_budget > 3 else 0,
        "agent_call_budget_exhausted": (
            call_lifecycle["starts"] >= effective_call_budget
        ),
        "discovery_closeout_reserve_active": reserve_active,
        "discovery_closeout_work_available": discovery_closeout_work,
        "discovery_paused": discovery_paused,
        "discovery_pause_reason": (
            "discovery_budget_reserved_for_closeout"
            if discovery_paused else None
        ),
        "low_yield_circuit_roles": circuit_roles,
        "retry_exhausted_scopes": sorted(retry_exhausted_scopes),
        "consecutive_no_yield_calls": consecutive_no_yield,
        "successful_verified_submissions": sum(state == "Submission Verified" for state in latest.values()),
        "fully_assessed_ads": fully_assessed,
        "eligible_at_or_above_threshold": eligible_count,
        "consecutive_submission_failures": submission_failures,
        "failure_limit_terminalizable_jobs": sorted(failure_terminalizable),
        "unresolved_submission_confirmations": unresolved_submission_confirmations,
        "submission_confirmation_pending_jobs": sorted(
            submission_attempts["open_attempts_by_job"]
        ),
        "submission_confirmation_pending_attempts": sorted(
            submission_attempts["open_attempt_ids"]
        ),
        "manual_takeover_sites": len({
            event.get("site_id") or f"legacy-{index}"
            for index, event in enumerate(events)
            if event.get("event_type") == "manual_takeover_required"
        }),
        "needs_review_items": needs_review,
        "waiting_user_blocked_items": waiting_user_blocked,
        "pending_user_items": pending_user_items,
        "recoverable_blocked_items": recoverable_blocked,
        "automatically_processable_items": automatically_processable,
        "unprocessed_candidates": unprocessed_candidates,
        "claimed_or_open_candidates": claimed_or_open_candidates,
        "deferred_due_to_batch_stop": deferred_candidates,
        "invalid_discovery_candidates": len(integrity["errors"]),
        "active_frontiers": active_frontiers,
        "blocked_frontiers": frontier["blocked"],
        "all_frontiers_terminal": all_frontiers_terminal,
        "normal_completion_ready": (
            all_frontiers_terminal
            and unprocessed_candidates == 0
            and pending_user_items == 0
            and automatically_processable == 0
            and jobs_complete
            and unresolved_submission_confirmations == 0
        ),
        "waiting_user_pause_ready": (
            pending_user_items > 0
            and all_frontiers_terminal
            and unprocessed_candidates == 0
            and automatically_processable == 0
        ),
        "material_risk": bool(active_control_signals["material_risk"]),
        "state_unreliable": bool(active_control_signals["state_unreliable"]),
        "unresolved_material_risk_signal_ids": [
            item["control_signal_id"]
            for item in active_control_signals["material_risk"]
        ],
        "unresolved_state_unreliable_signal_ids": [
            item["control_signal_id"]
            for item in active_control_signals["state_unreliable"]
        ],
        "discovery_frontiers": frontiers,
    }


def stop_result(counters: dict[str, Any], policy: dict[str, Any] | None = None) -> dict[str, Any]:
    stops = (policy or batch_policy())["stop_conditions"]
    frontiers = counters.get("discovery_frontiers")
    if isinstance(frontiers, dict):
        frontiers = list(frontiers.values())
    all_frontiers_exhausted_or_saturated = (
        isinstance(frontiers, list) and bool(frontiers)
        and all(
            isinstance(frontier, dict)
            and frontier.get("status") in {"saturated", "exhausted"}
            for frontier in frontiers
        )
    )
    eligible_count = counters.get(
        "eligible_at_or_above_threshold",
        counters.get("eligible_at_or_above_70", 0),
    )
    pending_user_items = counters.get(
        "pending_user_items",
        1 if counters.get("all_remaining_need_user_input") else 0,
    )
    automatic_work = counters.get("automatically_processable_items", 0)
    unprocessed = counters.get("unprocessed_candidates", 0)
    active_frontiers = counters.get(
        "active_frontiers",
        sum(
            isinstance(frontier, dict) and frontier.get("status") == "active"
            for frontier in (frontiers or [])
        ),
    )
    pause_ready = counters.get(
        "waiting_user_pause_ready",
        pending_user_items > 0
        and all_frontiers_exhausted_or_saturated
        and automatic_work == 0
        and unprocessed == 0
        and active_frontiers == 0,
    )
    normal_completion = counters.get(
        "normal_completion_ready",
        all_frontiers_exhausted_or_saturated
        and pending_user_items == 0
        and automatic_work == 0
        and unprocessed == 0
        and eligible_count == 0,
    )
    ordered = [
        (1, counters.get("successful_verified_submissions", 0) >= stops["verified_submissions"], "verified_submission_target"),
        (
            2,
            counters.get("fully_assessed_ads", 0) >= stops["fully_assessed_ads"],
            "fully_assessed_target",
        ),
        (3, bool(normal_completion), "search_exhausted_normal_completion"),
        (4, counters.get("consecutive_submission_failures", 0) >= stops["consecutive_submission_failures"], "consecutive_submission_failure_limit"),
        (5, counters.get("manual_takeover_sites", 0) >= stops["manual_takeover_sites"], "manual_takeover_limit"),
    ]
    pending_stop = next(
        (
            {"number": number, "reason": reason}
            for number, hit, reason in ordered if hit
        ),
        None,
    )
    failure_limit_reached = (
        counters.get("consecutive_submission_failures", 0)
        >= stops["consecutive_submission_failures"]
    )
    failure_jobs = counters.get("failure_limit_terminalizable_jobs", [])

    def annotate_failure_terminalization(
        result: dict[str, Any],
    ) -> dict[str, Any]:
        if failure_limit_reached:
            result["submission_failure_limit_reached"] = True
            result["terminalization_required_jobs"] = failure_jobs
            if failure_jobs:
                result["terminalization_action"] = (
                    "run terminalize-failure-limit with explicit evidence; "
                    "no further submission retry is required"
                )
        return result

    def pause_result(result: dict[str, Any]) -> dict[str, Any]:
        if pending_stop is not None:
            result["pending_stop"] = True
            result["pending_stop_number"] = pending_stop["number"]
            result["pending_stop_reason"] = pending_stop["reason"]
        return annotate_failure_terminalization(result)

    stop_closeout_complete = (
        pending_stop is not None
        and counters.get("active_agent_calls", 0) == 0
        and counters.get("unresolved_submission_confirmations", 0) == 0
        and counters.get("unprocessed_candidates", 0) == 0
        and counters.get("pending_user_items", 0) == 0
        and counters.get("recoverable_blocked_items", 0) == 0
        and counters.get("automatically_processable_items", 0) == 0
        and counters.get("blocked_frontiers", 0) == 0
        and bool(counters.get(
            "all_frontiers_terminal",
            all_frontiers_exhausted_or_saturated,
        ))
        and not failure_jobs
    )

    if counters.get("state_unreliable"):
        return annotate_failure_terminalization({
            "stop": False,
            "pause": True,
            "number": 9,
            "reason": "state_unreliable",
            "recovery_action": "repair and validate state, then resolve each active state_unreliable control signal with explicit user authorization",
        })
    if counters.get("material_risk"):
        return annotate_failure_terminalization({
            "stop": False,
            "pause": True,
            "number": 7,
            "reason": "material_security_privacy_truthfulness_or_rule_risk",
            "recovery_action": "resolve the material risk, preserve evidence, then resolve each active material_risk control signal with explicit user authorization",
        })
    if counters.get("active_agent_calls", 0):
        active_call_ids = counters.get("active_agent_call_ids", [])
        return pause_result({
            "stop": False,
            "pause": True,
            "number": None,
            "reason": "agent_calls_in_progress",
            "active_agent_call_ids": active_call_ids,
            "recovery_action": (
                "record completion for every active call with the same call_id; "
                "do not start a replacement call"
            ),
        })
    if counters.get("unresolved_submission_confirmations", 0):
        return pause_result({
            "stop": False,
            "pause": True,
            "number": None,
            "reason": "submission_confirmation_pending",
        })
    if (
        counters.get("agent_call_budget_exhausted")
        and not stop_closeout_complete
    ):
        return pause_result({
            "stop": False,
            "pause": True,
            "number": None,
            "reason": "agent_call_budget_exhausted",
        })
    if counters.get("discovery_paused"):
        return pause_result({
            "stop": False,
            "pause": True,
            "number": None,
            "reason": counters.get("discovery_pause_reason")
            or "discovery_budget_reserved_for_closeout",
            "recovery_action": "authorize additional agent calls to continue search expansion; already observed candidates remain eligible for closeout processing",
        })
    retry_scopes = counters.get("retry_exhausted_scopes", [])
    if retry_scopes:
        return pause_result({
            "stop": False,
            "pause": True,
            "number": None,
            "reason": "agent_retry_exhausted:" + ",".join(retry_scopes),
            "recovery_action": "record explicit user authorisation with resume-agent-calls for each role/job scope; the next submission attempt requires a new review and approval",
            "retry_exhausted_scopes": retry_scopes,
        })
    circuit_roles = counters.get("low_yield_circuit_roles", [])
    if circuit_roles:
        return pause_result({
            "stop": False,
            "pause": True,
            "number": None,
            "reason": "agent_call_circuit_open:" + ",".join(circuit_roles),
        })
    if counters.get("blocked_frontiers", 0):
        return pause_result({
            "stop": False,
            "pause": True,
            "number": None,
            "reason": "blocked_discovery_frontier",
        })
    if pause_ready:
        return pause_result({
            "stop": False,
            "pause": True,
            "number": 6,
            "reason": "waiting_for_user_input",
        })
    if pending_stop is not None:
        result = {
            "stop": True,
            "pause": False,
            "number": pending_stop["number"],
            "reason": pending_stop["reason"],
        }
        if (
            pending_stop["reason"] == "consecutive_submission_failure_limit"
            and failure_jobs
        ):
            result["recovery_action"] = (
                "run terminalize-failure-limit with explicit evidence; "
                "no further submission retry is required"
            )
        return annotate_failure_terminalization(result)
    return {"stop": False, "pause": False, "number": None, "reason": None}


def check_stop(args: argparse.Namespace) -> dict[str, Any]:
    if not args.track or not args.batch_id:
        raise ControlError("track_and_batch_required_for_derived_counters")
    batch, manifest = require_batch(args.track, args.batch_id, allow_completed=True)
    counters = derive_counters(batch, manifest)
    if args.counters_json:
        supplied = read_json_arg(args.counters_json)
        if supplied != counters:
            raise ControlError("caller_supplied_counters_rejected")
    result = stop_result(counters, batch_policy(manifest))
    return {
        **result,
        "global_pause": result["pause"],
        "discovery_paused": counters["discovery_paused"],
        "discovery_pause_reason": counters["discovery_pause_reason"],
        "counters": counters,
    }


def terminalize_failure_limit(args: argparse.Namespace) -> dict[str, Any]:
    if args.actor != "lead":
        raise ControlError("only_lead_may_terminalize_failure_limit")
    batch, manifest = require_batch(args.track, args.batch_id)
    evidence = evidence_reference(batch, args.evidence_path)
    events_path = batch / "events.jsonl"
    with exclusive_lock(events_path):
        events = read_jsonl(events_path)
        lifecycle = submission_attempt_lifecycle(events)
        limit = batch_policy(manifest)["stop_conditions"][
            "consecutive_submission_failures"
        ]
        if lifecycle["consecutive_failures"] < limit:
            raise ControlError("submission_failure_limit_not_reached")
        if lifecycle["open_attempt_ids"]:
            raise ControlError("submission_attempt_confirmation_pending")
        terminalizable = failure_limit_terminalizable_attempts(events)
        terminalized: list[str] = []
        for job_key_value, attempt_id in sorted(terminalizable.items()):
            current = job_state(batch, job_key_value)
            if current not in {
                "Failed", "Package Prepared", "Awaiting User Review",
                "Submission Ready",
            }:
                continue
            append_jsonl_unlocked(events_path, {
                "schema_version": 1,
                "event_type": "state_transition",
                "at": now(),
                "batch_id": args.batch_id,
                "track": args.track,
                "job_key": job_key_value,
                "actor": "lead",
                "from_state": current,
                "to_state": "Blocked",
                "blocked_kind": "terminal",
                "terminal_reason": "consecutive_submission_failure_limit",
                "submission_attempt_id": attempt_id,
                "evidence": evidence,
                "affected_paths": [],
            })
            terminalized.append(job_key_value)
    return {
        "failure_limit": limit,
        "consecutive_submission_failures": lifecycle["consecutive_failures"],
        "terminalized_jobs": terminalized,
        "reused": not terminalized,
    }


def append_fingerprint(args: argparse.Namespace) -> dict[str, Any]:
    safe_track(args.track); batch, _ = require_batch(args.track, args.batch_id)
    fields = {"source": args.source, "query": args.query, "location": args.location, "filters": args.filters, "date_range": args.date_range}
    fingerprint = search_fingerprint(args.track, **fields)
    known = read_json(CONTROL / "cache" / args.track / "search_fingerprints.json", {"items": {}}).get("items", {})
    current_batch = {event.get("fingerprint") for event in read_jsonl(batch / "events.jsonl")
                     if event.get("event_type") == "search_fingerprint"}
    # A later batch may intentionally revisit an active search; only the current batch is exclusive.
    if fingerprint in current_batch and not args.allow_repeat:
        raise ControlError("duplicate_search_fingerprint")
    append_jsonl(batch / "events.jsonl", {"schema_version": 1, "event_type": "search_fingerprint", "at": now(),
                                           "batch_id": args.batch_id, "track": args.track, "fingerprint": fingerprint, "fields": fields})
    return {"fingerprint": fingerprint, "previously_seen_in_other_batch": fingerprint in known}


def discovery_path(batch: Path) -> Path:
    return batch / "discovery_state.json"


def discovery_event_path(batch: Path) -> Path:
    return batch / "discovery_events.jsonl"


DISCOVERY_EVENT_ZERO_HASH = "0" * 64


def discovery_event_hash(event: dict[str, Any], previous_hash: str) -> str:
    payload = {
        key: value for key, value in event.items()
        if key != "event_sha256"
    }
    encoded = json.dumps(
        payload, ensure_ascii=False, sort_keys=True, separators=(",", ":"),
    ).encode("utf-8")
    digest = hashlib.sha256()
    digest.update(previous_hash.encode("ascii"))
    digest.update(b"\0")
    digest.update(encoded)
    return digest.hexdigest()


def discovery_history_tail(events: list[dict[str, Any]]) -> str:
    tail = DISCOVERY_EVENT_ZERO_HASH
    versioned_seen = False
    for index, event in enumerate(events, 1):
        metadata = (
            event.get("event_sequence"),
            event.get("previous_event_sha256"),
            event.get("event_sha256"),
        )
        versioned = any(value is not None for value in metadata)
        if versioned:
            if (
                event.get("event_sequence") != index
                or event.get("previous_event_sha256") != tail
                or not isinstance(event.get("event_sha256"), str)
                or event["event_sha256"] != discovery_event_hash(event, tail)
            ):
                raise ControlError("discovery_event_chain_invalid")
            versioned_seen = True
            tail = event["event_sha256"]
        else:
            if versioned_seen:
                raise ControlError("discovery_event_chain_regressed")
            tail = discovery_event_hash(event, tail)
    return tail


def build_discovery_event(
    events: list[dict[str, Any]],
    track: str,
    batch_id: str,
    event_type: str,
    delta: dict[str, Any],
) -> dict[str, Any]:
    previous_hash = discovery_history_tail(events)
    event = {
        "schema_version": DISCOVERY_SCHEMA_VERSION,
        "event_type": event_type,
        "at": now(),
        "track": track,
        "batch_id": batch_id,
        "delta": delta,
        "event_sequence": len(events) + 1,
        "previous_event_sha256": previous_hash,
    }
    event["event_sha256"] = discovery_event_hash(event, previous_hash)
    return event


def apply_discovery_delta(state: dict[str, Any], delta: dict[str, Any]) -> None:
    state["config"].update(copy.deepcopy(delta.get("config_update", {})))
    for partition_id, update in delta.get("partition_updates", {}).items():
        partition = state["partitions"].setdefault(partition_id, {"observations": []})
        partition.update(copy.deepcopy(update))
        partition.setdefault("observations", [])
    for partition_id, observations in delta.get("append_partition_observations", {}).items():
        state["partitions"][partition_id]["observations"].extend(
            copy.deepcopy(observations)
        )
    state["candidates"].update(copy.deepcopy(delta.get("candidate_updates", {})))
    state["observations"].extend(copy.deepcopy(delta.get("append_observations", [])))
    if "schedule_update" in delta:
        state["schedule"] = copy.deepcopy(delta["schedule_update"])


def empty_discovery_state(
    track: str, batch_id: str, card_limit: int = DEFAULT_CARD_OBSERVATION_LIMIT,
) -> dict[str, Any]:
    return {
        "schema_version": DISCOVERY_SCHEMA_VERSION,
        "track": track,
        "batch_id": batch_id,
        "config": {
            "card_observation_limit": card_limit,
            "per_fingerprint_round_limit": 5,
            "viable_queue_target": None,
        },
        "partitions": {},
        "candidates": {},
        "observations": [],
        "schedule": {"round": 1, "last_partition": None, "fingerprint_claims": {}},
        "event_sequence": 0,
        "event_tail_sha256": DISCOVERY_EVENT_ZERO_HASH,
    }


def normalize_discovery_state(
    raw: Any,
    track: str,
    batch_id: str,
    card_limit: int = DEFAULT_CARD_OBSERVATION_LIMIT,
) -> dict[str, Any]:
    """Load old or partial state with conservative defaults; never infer completion."""
    state = raw if isinstance(raw, dict) else {}
    state.setdefault("schema_version", DISCOVERY_SCHEMA_VERSION)
    state.setdefault("track", track)
    state.setdefault("batch_id", batch_id)
    if state["track"] != track or state["batch_id"] != batch_id:
        raise ControlError("discovery_state_identity_mismatch")
    config = state.setdefault("config", {})
    config.setdefault("card_observation_limit", card_limit)
    config.setdefault("per_fingerprint_round_limit", 5)
    config.setdefault("viable_queue_target", None)
    state.setdefault("partitions", {})
    state.setdefault("candidates", {})
    state.setdefault("observations", [])
    schedule = state.setdefault("schedule", {})
    schedule.setdefault("round", 1)
    schedule.setdefault("last_partition", None)
    schedule.setdefault("fingerprint_claims", {})
    sequence = state.setdefault("event_sequence", 0)
    tail_hash = state.setdefault(
        "event_tail_sha256", DISCOVERY_EVENT_ZERO_HASH,
    )
    if isinstance(sequence, bool) or not isinstance(sequence, int) or sequence < 0:
        raise ControlError("invalid_discovery_snapshot_sequence")
    if not isinstance(tail_hash, str) or not re.fullmatch(r"[a-f0-9]{64}", tail_hash):
        raise ControlError("invalid_discovery_snapshot_tail_hash")
    for partition_id, partition in state["partitions"].items():
        partition.setdefault("fingerprint", f"legacy-{partition_id}")
        partition.setdefault("status", "active")
        partition.setdefault("cursor", None)
        partition.setdefault("next_cursor", None)
        partition.setdefault("boundary", {})
        partition.setdefault("observations", [])
        partition.setdefault("windows_observed", 0)
        partition.setdefault("saturation_reason", None)
    if len(state["observations"]) >= config["card_observation_limit"]:
        for partition in state["partitions"].values():
            if partition.get("status") == "active":
                partition["status"] = "saturated"
                partition["saturation_reason"] = (
                    "card_observation_limit_reached"
                )
    for candidate in state["candidates"].values():
        candidate.setdefault("source", "")
        candidate.setdefault("listing_id", "")
        candidate.setdefault("url", "")
        candidate.setdefault("status", "unseen")
        if not candidate["listing_id"] and not candidate["url"]:
            candidate["status"] = "unopenable"
        candidate.setdefault("partition_ids", [])
        candidate.setdefault("full_ad_opened", candidate.get("status") in {"full_ad_opened", "fully_assessed"})
        candidate.setdefault("fully_assessed", candidate.get("status") == "fully_assessed")
        candidate.setdefault("claimed_by", None)
        candidate.setdefault("job_key", None)
        candidate.setdefault("deferred_reason", None)
        candidate.setdefault("deferred_at", None)
        candidate.setdefault("terminal_reason", None)
        candidate.setdefault("terminal_evidence", None)
    return state


def require_discovery_batch(args: argparse.Namespace) -> tuple[Path, Path]:
    safe_track(args.track)
    batch, _ = require_batch(args.track, args.batch_id)
    return batch, discovery_path(batch)


def discovery_state_delta(state: dict[str, Any]) -> dict[str, Any]:
    return {
        "config_update": copy.deepcopy(state["config"]),
        "partition_updates": {
            partition_id: {
                key: copy.deepcopy(value)
                for key, value in partition.items()
                if key != "observations"
            }
            for partition_id, partition in state["partitions"].items()
        },
        "append_partition_observations": {
            partition_id: copy.deepcopy(partition.get("observations", []))
            for partition_id, partition in state["partitions"].items()
        },
        "candidate_updates": copy.deepcopy(state["candidates"]),
        "append_observations": copy.deepcopy(state["observations"]),
        "schedule_update": copy.deepcopy(state["schedule"]),
    }


def stamp_discovery_snapshot(
    state: dict[str, Any], events: list[dict[str, Any]],
) -> dict[str, Any]:
    state["event_sequence"] = len(events)
    state["event_tail_sha256"] = discovery_history_tail(events)
    return state


def discovery_state_payload(state: dict[str, Any]) -> dict[str, Any]:
    payload = copy.deepcopy(state)
    payload.pop("event_sequence", None)
    payload.pop("event_tail_sha256", None)
    return payload


def replay_discovery_events(
    batch: Path,
    manifest: dict[str, Any],
    events: list[dict[str, Any]] | None = None,
    *,
    card_limit: int = DEFAULT_CARD_OBSERVATION_LIMIT,
) -> dict[str, Any]:
    events = read_jsonl(discovery_event_path(batch)) if events is None else events
    discovery_history_tail(events)
    state = empty_discovery_state(
        manifest["track"], manifest["batch_id"], card_limit,
    )
    for event in events:
        if (
            event.get("track") != manifest["track"]
            or event.get("batch_id") != manifest["batch_id"]
        ):
            raise ControlError("discovery_event_identity_mismatch")
        delta = event.get("delta")
        if not isinstance(delta, dict):
            raise ControlError("invalid_discovery_event_delta")
        apply_discovery_delta(state, delta)
    state = normalize_discovery_state(
        state, manifest["track"], manifest["batch_id"], card_limit,
    )
    return stamp_discovery_snapshot(state, events)


def load_discovery_state(batch: Path, manifest: dict[str, Any]) -> dict[str, Any]:
    events = read_jsonl(discovery_event_path(batch))
    if events:
        return replay_discovery_events(batch, manifest, events)
    state = normalize_discovery_state(
        read_json(discovery_path(batch)),
        manifest["track"],
        manifest["batch_id"],
    )
    return stamp_discovery_snapshot(state, [])


@contextmanager
def discovery_transaction(
    batch: Path,
    manifest: dict[str, Any],
    *,
    card_limit: int | None = None,
):
    """Replay, validate, mutate and cache discovery state under one log lock."""
    event_path = discovery_event_path(batch)
    snapshot_path = discovery_path(batch)
    with exclusive_lock(event_path):
        events = read_jsonl(event_path)
        if not events and snapshot_path.exists():
            legacy_state = normalize_discovery_state(
                read_json(snapshot_path),
                manifest["track"],
                manifest["batch_id"],
                card_limit or DEFAULT_CARD_OBSERVATION_LIMIT,
            )
            bootstrap = build_discovery_event(
                events,
                manifest["track"],
                manifest["batch_id"],
                "discovery_snapshot_bootstrap",
                discovery_state_delta(legacy_state),
            )
            append_jsonl_unlocked(event_path, bootstrap)
            events.append(bootstrap)
        state = replay_discovery_events(
            batch, manifest, events,
            card_limit=card_limit or DEFAULT_CARD_OBSERVATION_LIMIT,
        )
        integrity = discovery_integrity(batch, manifest, state)
        if integrity["errors"]:
            raise ControlError(
                "discovery_event_history_invalid:"
                + ",".join(integrity["errors"])
            )
        cached = normalize_discovery_state(
            read_json(snapshot_path),
            manifest["track"],
            manifest["batch_id"],
            card_limit or DEFAULT_CARD_OBSERVATION_LIMIT,
        )
        if cached != state:
            atomic_json(snapshot_path, state)
        base_state = copy.deepcopy(state)
        committed = False

        def commit(event_type: str, delta: dict[str, Any]) -> None:
            nonlocal committed, events
            if committed:
                raise ControlError("discovery_transaction_already_committed")
            expected = copy.deepcopy(base_state)
            apply_discovery_delta(expected, delta)
            expected = normalize_discovery_state(
                expected,
                manifest["track"],
                manifest["batch_id"],
                card_limit or DEFAULT_CARD_OBSERVATION_LIMIT,
            )
            actual = normalize_discovery_state(
                copy.deepcopy(state),
                manifest["track"],
                manifest["batch_id"],
                card_limit or DEFAULT_CARD_OBSERVATION_LIMIT,
            )
            if discovery_state_payload(expected) != discovery_state_payload(actual):
                raise ControlError("discovery_delta_state_mismatch")
            event = build_discovery_event(
                events,
                manifest["track"],
                manifest["batch_id"],
                event_type,
                delta,
            )
            append_jsonl_unlocked(event_path, event)
            events.append(event)
            expected = stamp_discovery_snapshot(expected, events)
            atomic_json(snapshot_path, expected)
            state.clear()
            state.update(copy.deepcopy(expected))
            committed = True

        yield state, commit


def discovery_snapshot_consistent(
    batch: Path, manifest: dict[str, Any], state: dict[str, Any] | None = None,
) -> bool:
    authoritative = state or load_discovery_state(batch, manifest)
    cached = normalize_discovery_state(
        read_json(discovery_path(batch)),
        manifest["track"],
        manifest["batch_id"],
    )
    return cached == authoritative


def frontier_summary(state: dict[str, Any]) -> dict[str, Any]:
    statuses = [
        partition.get("status", "active")
        for partition in state["partitions"].values()
    ]
    return {
        "statuses": statuses,
        "active": sum(status == "active" for status in statuses),
        "blocked": sum(
            status in DISCOVERY_PAUSED_PARTITION_STATES for status in statuses
        ),
        "all_complete": bool(statuses) and all(
            status in DISCOVERY_COMPLETE_PARTITION_STATES for status in statuses
        ),
    }


def discovery_integrity(
    batch: Path,
    manifest: dict[str, Any],
    state: dict[str, Any],
) -> dict[str, Any]:
    """Validate modern candidate lifecycle and assessed-job linkage."""
    if manifest.get("schema_version", 1) < 2:
        return {
            "errors": [],
            "valid_fully_assessed": sum(
                bool(item.get("fully_assessed"))
                for item in state["candidates"].values()
            ),
        }
    errors: list[str] = []
    allowed_changes = {
        "unseen": {"claimed", *DISCOVERY_SUPPRESSED_STATES, "deferred_due_to_batch_stop"},
        "claimed": {"full_ad_opened", *DISCOVERY_SUPPRESSED_STATES},
        "full_ad_opened": {"fully_assessed", *DISCOVERY_SUPPRESSED_STATES},
    }
    replayed: dict[str, str] = {}
    for event in read_jsonl(discovery_event_path(batch)):
        delta = event.get("delta")
        if not isinstance(delta, dict):
            errors.append("invalid_discovery_event_delta")
            continue
        updates = delta.get("candidate_updates", {})
        if not isinstance(updates, dict):
            errors.append("invalid_discovery_candidate_updates")
            continue
        for candidate_key, candidate in updates.items():
            status = candidate.get("status") if isinstance(candidate, dict) else None
            if status not in DISCOVERY_CANDIDATE_STATES:
                errors.append(f"invalid_discovery_candidate_status:{candidate_key}")
                continue
            previous = replayed.get(candidate_key)
            if previous is None:
                if (
                    event.get("event_type") != "discovery_snapshot_bootstrap"
                    and status not in ({"unseen"} | DISCOVERY_SUPPRESSED_STATES)
                ):
                    errors.append(
                        f"invalid_discovery_candidate_initial_state:{candidate_key}"
                    )
            elif status != previous and status not in allowed_changes.get(previous, set()):
                errors.append(
                    f"illegal_discovery_candidate_lifecycle:{candidate_key}"
                )
            replayed[candidate_key] = status

    assessed_job_keys: set[str] = set()
    state_events = [
        event for event in read_jsonl(batch / "events.jsonl")
        if event.get("event_type") == "state_transition"
    ]
    jobs_reaching_assessed = {
        event.get("job_key")
        for event in state_events
        if event.get("to_state") == "Assessed"
    }
    valid_fully_assessed = 0
    for candidate_key, candidate in state["candidates"].items():
        status = candidate.get("status")
        if status not in DISCOVERY_CANDIDATE_STATES:
            errors.append(f"invalid_discovery_candidate_status:{candidate_key}")
            continue
        if replayed and replayed.get(candidate_key) != status:
            errors.append(f"discovery_candidate_replay_mismatch:{candidate_key}")
        if status == "deferred_due_to_batch_stop":
            if (
                candidate.get("full_ad_opened")
                or candidate.get("fully_assessed")
                or not isinstance(candidate.get("deferred_reason"), str)
                or not candidate["deferred_reason"]
                or not isinstance(candidate.get("deferred_at"), str)
                or not candidate["deferred_at"]
            ):
                errors.append(f"invalid_deferred_candidate:{candidate_key}")
            continue
        if status in CANDIDATE_MECHANICAL_JOB_STATE and (
            candidate.get("full_ad_opened") or candidate.get("claimed_by")
        ):
            if (
                not isinstance(candidate.get("terminal_reason"), str)
                or not candidate["terminal_reason"]
                or not isinstance(candidate.get("terminal_evidence"), dict)
            ):
                errors.append(f"invalid_mechanical_terminal_candidate:{candidate_key}")
            else:
                record = candidate["terminal_evidence"]
                try:
                    evidence_path = public_workspace_path(record.get("path", ""))
                    if (
                        not evidence_path.is_file()
                        or sha256(evidence_path) != record.get("sha256")
                    ):
                        errors.append(
                            f"invalid_mechanical_terminal_evidence:{candidate_key}"
                        )
                except ControlError:
                    errors.append(
                        f"invalid_mechanical_terminal_evidence:{candidate_key}"
                    )
        if candidate.get("fully_assessed") != (status == "fully_assessed"):
            errors.append(f"candidate_fully_assessed_flag_mismatch:{candidate_key}")
        if status in {"full_ad_opened", "fully_assessed"} and not candidate.get("full_ad_opened"):
            errors.append(f"candidate_full_ad_flag_mismatch:{candidate_key}")
        if status != "fully_assessed":
            continue
        job_key_value = candidate.get("job_key")
        if not isinstance(job_key_value, str) or not job_key_value:
            errors.append(f"fully_assessed_candidate_missing_job_key:{candidate_key}")
            continue
        if job_key_value in assessed_job_keys:
            errors.append(f"duplicate_fully_assessed_job_key:{job_key_value}")
            continue
        assessed_job_keys.add(job_key_value)
        if job_key_value not in jobs_reaching_assessed:
            errors.append(
                f"fully_assessed_candidate_missing_assessed_state:{candidate_key}"
            )
            continue
        try:
            packet, _, _ = load_valid_packet(
                batch, manifest["track"], job_key_value,
            )
        except ControlError as exc:
            errors.append(
                f"fully_assessed_candidate_invalid_packet:{candidate_key}:{exc}"
            )
            continue
        candidate_url = candidate.get("url")
        if (
            isinstance(candidate_url, str)
            and candidate_url
            and not packet_matches_url(packet, candidate_url)
        ):
            errors.append(f"fully_assessed_candidate_identity_mismatch:{candidate_key}")
            continue
        valid_fully_assessed += 1
    return {
        "errors": list(dict.fromkeys(errors)),
        "valid_fully_assessed": valid_fully_assessed,
    }


def canonical_listing_key(source: str, listing_id: str, url: str) -> str:
    source_value = normalized(source)
    listing_value = normalized(listing_id)
    if listing_value:
        identity = f"id|{source_value}|{listing_value}"
    else:
        identity = f"url|{canonical_url(url)}"
    return hashlib.sha256(identity.encode()).hexdigest()[:24]


def validate_frontier_boundary(value: Any) -> dict[str, Any]:
    if not isinstance(value, dict):
        raise ControlError("frontier_boundary_object_required")
    advancement_keys = {
        "site", "location", "date_range", "employment_type", "sort", "page",
        "scroll_position", "rank_window", "cursor",
    }
    if not any(key in value and value[key] not in (None, "") for key in advancement_keys):
        raise ControlError("frontier_requires_result_space_boundary")
    return value


def discovery_observe(args: argparse.Namespace) -> dict[str, Any]:
    batch, path = require_discovery_batch(args)
    manifest = read_json(batch / "manifest.json", {})
    configured_limit = batch_policy(manifest)["limits"]["card_observation_limit"]
    card_limit = args.card_limit if args.card_limit is not None else configured_limit
    if card_limit < 1 or card_limit > configured_limit:
        raise ControlError("card_observation_limit_positive")
    partition_id = safe_id(args.partition_id, "partition_id")
    fingerprint = safe_id(args.fingerprint, "fingerprint")
    window = read_json_arg(args.window_json)
    if not isinstance(window, list):
        raise ControlError("search_window_array_required")
    boundary = read_json_arg(args.boundary_json)
    with discovery_transaction(
        batch, manifest, card_limit=card_limit,
    ) as (state, commit):
        state["config"]["per_fingerprint_round_limit"] = batch_policy(manifest)["limits"]["per_fingerprint_round_limit"]
        if not isinstance(state["partitions"], dict) or not isinstance(state["candidates"], dict):
            raise ControlError("invalid_discovery_state")
        partition = state["partitions"].get(partition_id)
        if partition is None:
            boundary = validate_frontier_boundary(boundary)
            partition = {
                "fingerprint": fingerprint,
                "boundary": boundary,
                "cursor": args.cursor,
                "next_cursor": args.next_cursor,
                "status": "active",
                "observations": [],
                "windows_observed": 0,
            }
            state["partitions"][partition_id] = partition
        elif partition.get("fingerprint") != fingerprint:
            raise ControlError("partition_fingerprint_mismatch")
        elif partition.get("status") != "active":
            raise ControlError("discovery_frontier_not_active")
        limit = state["config"]["card_observation_limit"]
        requested_observations = len(window)
        remaining_observations = max(0, limit - len(state["observations"]))
        window = window[:remaining_observations]

        new_count = 0
        suppressed_count = 0
        changed_candidates: set[str] = set()
        appended_observations: list[dict[str, Any]] = []
        appended_partition_observations: list[dict[str, Any]] = []
        for raw in window:
            if not isinstance(raw, dict):
                raise ControlError("search_window_listing_object_required")
            allowed = {"source", "listing_id", "url", "rank", "status"}
            if set(raw) - allowed:
                raise ControlError("search_window_listing_unexpected_field")
            source = require_string(raw.get("source"), "listing_source")
            listing_id = raw.get("listing_id", "")
            url = raw.get("url", "")
            if not isinstance(listing_id, str) or not isinstance(url, str):
                raise ControlError("listing_identity_string_required")
            rank = raw.get("rank")
            if isinstance(rank, bool) or not isinstance(rank, int) or rank < 1:
                raise ControlError("listing_rank_positive_integer_required")
            observed_status = raw.get("status", "unseen")
            if observed_status not in ({"unseen"} | DISCOVERY_SUPPRESSED_STATES):
                raise ControlError("invalid_observation_status")
            candidate_key = canonical_listing_key(source, listing_id, url)
            candidate = state["candidates"].get(candidate_key)
            is_new = candidate is None
            if is_new:
                candidate = {
                    "source": source,
                    "listing_id": listing_id,
                    "url": url,
                    "status": observed_status,
                    "partition_ids": [partition_id],
                    "first_observed_at": now(),
                    "claimed_by": None,
                    "full_ad_opened": False,
                    "fully_assessed": False,
                }
                state["candidates"][candidate_key] = candidate
                new_count += 1
                changed_candidates.add(candidate_key)
            elif partition_id not in candidate["partition_ids"]:
                candidate["partition_ids"].append(partition_id)
                changed_candidates.add(candidate_key)
            if (
                not is_new and observed_status in DISCOVERY_SUPPRESSED_STATES
                and candidate["status"] == "unseen"
            ):
                candidate["status"] = observed_status
                changed_candidates.add(candidate_key)
            suppressed = (not is_new) or observed_status in DISCOVERY_SUPPRESSED_STATES
            if suppressed:
                suppressed_count += 1
            observation = {
                "partition_id": partition_id,
                "fingerprint": fingerprint,
                "candidate_key": candidate_key,
                "rank": rank,
                "cursor": args.cursor,
                "status": observed_status,
                "is_new": is_new,
                "suppressed": suppressed,
            }
            state["observations"].append(observation)
            appended_observations.append(observation)
            partition_observation = {
                "candidate_key": candidate_key,
                "rank": rank,
                "cursor": args.cursor,
                "status": observed_status,
                "is_new": is_new,
                "suppressed": suppressed,
            }
            partition["observations"].append(partition_observation)
            appended_partition_observations.append(partition_observation)

        partition["cursor"] = args.cursor
        partition["next_cursor"] = args.next_cursor
        partition["windows_observed"] += 1
        recent = partition["observations"]
        saturated = (
            len(recent) >= 10 and all(item["suppressed"] for item in recent[-10:])
        ) or (
            len(recent) >= 20 and sum(1 for item in recent[-20:] if not item["suppressed"]) < 2
        )
        if saturated:
            partition["status"] = "saturated"
            partition["saturation_reason"] = "low_unique_yield"
        card_limit_reached = len(state["observations"]) >= limit
        partition_updates: dict[str, Any] = {}
        if card_limit_reached:
            for changed_partition_id, changed_partition in state["partitions"].items():
                if changed_partition.get("status") == "active":
                    changed_partition["status"] = "saturated"
                    changed_partition["saturation_reason"] = (
                        "card_observation_limit_reached"
                    )
                if (
                    changed_partition_id == partition_id
                    or changed_partition.get("saturation_reason")
                    == "card_observation_limit_reached"
                ):
                    partition_updates[changed_partition_id] = {
                        key: value for key, value in changed_partition.items()
                        if key != "observations"
                    }
        else:
            partition_updates[partition_id] = {
                key: value for key, value in partition.items()
                if key != "observations"
            }
        commit("discovery_observe", {
            "config_update": state["config"],
            "partition_updates": partition_updates,
            "append_partition_observations": {
                partition_id: appended_partition_observations,
            },
            "candidate_updates": {
                key: state["candidates"][key] for key in changed_candidates
            },
            "append_observations": appended_observations,
        })
    return {
        "state": rel(path),
        "partition_id": partition_id,
        "observed": len(window),
        "requested_observations": requested_observations,
        "omitted_due_to_card_limit": requested_observations - len(window),
        "card_observation_limit_reached": card_limit_reached,
        "new_listings": new_count,
        "duplicates_suppressed": suppressed_count,
        "partition_status": partition["status"],
        "cursor": partition["cursor"],
        "next_cursor": partition["next_cursor"],
    }


def candidate_partitions(state: dict[str, Any], candidate: dict[str, Any]) -> list[str]:
    """Return observed partitions from which the candidate may be drained.

    Saturation/exhaustion closes search expansion, not already observed work.
    Only a blocked partition prevents a candidate from being claimed.
    """
    return [
        partition_id for partition_id in candidate["partition_ids"]
        if state["partitions"].get(partition_id, {}).get("status")
        in DISCOVERY_COMPLETE_PARTITION_STATES | {"active"}
    ]


def defer_unseen_candidates(
    state: dict[str, Any],
    reason: str,
    *,
    close_active_frontiers: bool,
) -> tuple[dict[str, Any], dict[str, Any]]:
    candidate_updates: dict[str, Any] = {}
    partition_updates: dict[str, Any] = {}
    deferred_at = now()
    for candidate_key, candidate in state["candidates"].items():
        if candidate.get("status") != "unseen":
            continue
        candidate["status"] = "deferred_due_to_batch_stop"
        candidate["deferred_reason"] = reason
        candidate["deferred_at"] = deferred_at
        candidate_updates[candidate_key] = candidate
    if close_active_frontiers:
        for partition_id, partition in state["partitions"].items():
            if partition.get("status") != "active":
                continue
            partition["status"] = "exhausted"
            partition["closed_due_to_batch_stop"] = True
            partition["stop_reason"] = reason
            partition_updates[partition_id] = {
                key: value for key, value in partition.items()
                if key != "observations"
            }
    return candidate_updates, partition_updates


def discovery_drain(args: argparse.Namespace) -> dict[str, Any]:
    batch, path = require_discovery_batch(args)
    manifest = read_json(batch / "manifest.json", {})
    with discovery_transaction(batch, manifest) as (state, commit):
        counters = derive_counters(batch, manifest, state)
        stopping = stop_result(counters, batch_policy(manifest))
        frontier = frontier_summary(state)
        if stopping["stop"] or stopping.get("pending_stop"):
            reason = stopping.get("pending_stop_reason") or stopping["reason"]
            close_active = True
        elif frontier["blocked"]:
            raise ControlError("blocked_discovery_frontier_requires_resume")
        elif any(
            item.get("status") == "unseen"
            for item in state["candidates"].values()
        ):
            raise ControlError("unprocessed_discovery_candidates_require_claim")
        else:
            return {
                "deferred": 0,
                "remaining_claimed_or_open": counters[
                    "claimed_or_open_candidates"
                ],
                "reason": None,
                "idempotent": True,
            }
        candidate_updates, partition_updates = defer_unseen_candidates(
            state, reason, close_active_frontiers=close_active,
        )
        if candidate_updates or partition_updates:
            commit(
                "discovery_deferred_due_to_batch_stop",
                {
                    "candidate_updates": candidate_updates,
                    "partition_updates": partition_updates,
                },
            )
        remaining = sum(
            item.get("status") in {"claimed", "full_ad_opened"}
            for item in state["candidates"].values()
        )
    return {
        "deferred": len(candidate_updates),
        "remaining_claimed_or_open": remaining,
        "reason": reason,
        "idempotent": not candidate_updates and not partition_updates,
    }


def discovery_claim(args: argparse.Namespace) -> dict[str, Any]:
    batch, path = require_discovery_batch(args)
    manifest = read_json(batch / "manifest.json", {})
    worker = safe_id(args.worker, "worker")
    with discovery_transaction(batch, manifest) as (state, commit):
        stopping = stop_result(
            derive_counters(batch, manifest, state),
            batch_policy(manifest),
        )
        frontier = frontier_summary(state)
        if stopping["stop"] or stopping.get("pending_stop"):
            reason = stopping.get("pending_stop_reason") or stopping["reason"]
            candidate_updates, partition_updates = defer_unseen_candidates(
                state,
                reason,
                close_active_frontiers=True,
            )
            if candidate_updates or partition_updates:
                commit(
                    "discovery_deferred_due_to_batch_stop",
                    {
                        "candidate_updates": candidate_updates,
                        "partition_updates": partition_updates,
                    },
                )
            return {
                "claimed": False,
                "batch_stop": True,
                "stop_reason": reason,
                "deferred": len(candidate_updates),
                "remaining_claimed_or_open": sum(
                    item.get("status") in {"claimed", "full_ad_opened"}
                    for item in state["candidates"].values()
                ),
            }
        partitions = list(state["partitions"])
        last = state["schedule"]["last_partition"]
        if last in partitions:
            index = partitions.index(last) + 1
            partitions = partitions[index:] + partitions[:index]

        def choose() -> tuple[str, str] | None:
            claims = state["schedule"]["fingerprint_claims"]
            limit = state["config"]["per_fingerprint_round_limit"]
            for partition_id in partitions:
                partition = state["partitions"][partition_id]
                fingerprint = partition["fingerprint"]
                if claims.get(fingerprint, 0) >= limit:
                    continue
                for candidate_key, candidate in state["candidates"].items():
                    if candidate["status"] != "unseen" or partition_id not in candidate_partitions(state, candidate):
                        continue
                    return partition_id, candidate_key
            return None

        selected = choose()
        has_unseen = any(
            candidate["status"] == "unseen" and candidate_partitions(state, candidate)
            for candidate in state["candidates"].values()
        )
        if selected is None and has_unseen:
            state["schedule"]["round"] += 1
            state["schedule"]["fingerprint_claims"] = {}
            selected = choose()
        if selected is None:
            active_frontier = any(
                partition.get("status", "active") == "active"
                for partition in state["partitions"].values()
            )
            commit("discovery_claim_empty", {
                "schedule_update": state["schedule"],
            })
            return {
                "claimed": False,
                "frontier_pending": active_frontier,
                "round": state["schedule"]["round"],
            }
        partition_id, candidate_key = selected
        candidate = state["candidates"][candidate_key]
        fingerprint = state["partitions"][partition_id]["fingerprint"]
        candidate["status"] = "claimed"
        candidate["claimed_by"] = worker
        candidate["claimed_at"] = now()
        candidate["claimed_partition_id"] = partition_id
        state["schedule"]["last_partition"] = partition_id
        claims = state["schedule"]["fingerprint_claims"]
        claims[fingerprint] = claims.get(fingerprint, 0) + 1
        commit("discovery_claim", {
            "candidate_updates": {candidate_key: candidate},
            "schedule_update": state["schedule"],
        })
    return {
        "claimed": True,
        "candidate_key": candidate_key,
        "partition_id": partition_id,
        "fingerprint": fingerprint,
        "candidate": {
            "source": candidate["source"],
            "listing_id": candidate["listing_id"],
            "url": candidate["url"],
        },
        "round": state["schedule"]["round"],
        "fingerprint_claims_this_round": claims[fingerprint],
    }


def discovery_update_candidate(args: argparse.Namespace) -> dict[str, Any]:
    batch, path = require_discovery_batch(args)
    manifest = read_json(batch / "manifest.json", {})
    candidate_key = safe_id(args.candidate_key, "candidate_key")
    with discovery_transaction(batch, manifest) as (state, commit):
        candidate = state["candidates"].get(candidate_key)
        if candidate is None:
            raise ControlError("unknown_discovery_candidate")
        target = args.status
        previous = candidate["status"]
        allowed = {
            "claimed": {"full_ad_opened", *DISCOVERY_SUPPRESSED_STATES},
            "full_ad_opened": {"fully_assessed", *DISCOVERY_SUPPRESSED_STATES},
        }
        if target not in allowed.get(previous, set()):
            raise ControlError("illegal_discovery_candidate_transition")
        candidate["status"] = target
        if target in CANDIDATE_MECHANICAL_JOB_STATE:
            if manifest.get("schema_version", 1) >= 2:
                require_string(args.reason, "candidate_terminal_reason")
                if not args.evidence_path:
                    raise ControlError("candidate_terminal_evidence_required")
                candidate["terminal_reason"] = args.reason
                candidate["terminal_evidence"] = evidence_reference(
                    batch, args.evidence_path,
                )
                if args.job_key:
                    job_key_value = safe_id(args.job_key, "job_key")
                    if job_state(batch, job_key_value) != CANDIDATE_MECHANICAL_JOB_STATE[target]:
                        raise ControlError("candidate_job_mechanical_state_mismatch")
                    candidate["job_key"] = job_key_value
            elif args.reason:
                candidate["terminal_reason"] = args.reason
        if target == "full_ad_opened":
            candidate["full_ad_opened"] = True
        if target == "fully_assessed":
            if manifest.get("schema_version", 1) >= 2:
                if not args.job_key:
                    raise ControlError("fully_assessed_job_key_required")
                job_key_value = safe_id(args.job_key, "job_key")
                if any(
                    item.get("status") == "fully_assessed"
                    and item.get("job_key") == job_key_value
                    and key != candidate_key
                    for key, item in state["candidates"].items()
                ):
                    raise ControlError("fully_assessed_job_key_already_linked")
                if not any(
                    event.get("event_type") == "state_transition"
                    and event.get("job_key") == job_key_value
                    and event.get("to_state") == "Assessed"
                    for event in read_jsonl(batch / "events.jsonl")
                ):
                    raise ControlError("fully_assessed_requires_assessed_job_state")
                packet, _, _ = load_valid_packet(
                    batch, args.track, job_key_value,
                )
                if (
                    candidate.get("url")
                    and not packet_matches_url(packet, candidate["url"])
                ):
                    raise ControlError("fully_assessed_job_identity_mismatch")
                candidate["job_key"] = job_key_value
            elif args.job_key:
                candidate["job_key"] = safe_id(args.job_key, "job_key")
            candidate["full_ad_opened"] = True
            candidate["fully_assessed"] = True
        commit("discovery_candidate_status", {
            "candidate_updates": {candidate_key: candidate},
        })
    return {
        "candidate_key": candidate_key,
        "previous": previous,
        "status": target,
        "job_key": candidate.get("job_key"),
        "terminal_job_state": CANDIDATE_MECHANICAL_JOB_STATE.get(target),
    }


def discovery_advance(args: argparse.Namespace) -> dict[str, Any]:
    batch, path = require_discovery_batch(args)
    manifest = read_json(batch / "manifest.json", {})
    partition_id = safe_id(args.partition_id, "partition_id")
    with discovery_transaction(batch, manifest) as (state, commit):
        partition = state["partitions"].get(partition_id)
        if partition is None:
            raise ControlError("unknown_discovery_partition")
        if partition.get("status") != "active":
            raise ControlError("discovery_frontier_not_active")
        if (
            len(state["observations"])
            >= state["config"]["card_observation_limit"]
        ):
            raise ControlError("card_observation_limit_reached")
        partition["cursor"] = args.cursor
        partition["next_cursor"] = args.next_cursor
        partition["status"] = "active"
        partition["saturation_reason"] = None
        commit("discovery_frontier_advance", {
            "partition_updates": {partition_id: {
                key: value for key, value in partition.items() if key != "observations"
            }},
        })
    return {
        "partition_id": partition_id,
        "status": "active",
        "cursor": args.cursor,
        "next_cursor": args.next_cursor,
    }


def discovery_mark_partition(args: argparse.Namespace) -> dict[str, Any]:
    batch, path = require_discovery_batch(args)
    manifest = read_json(batch / "manifest.json", {})
    partition_id = safe_id(args.partition_id, "partition_id")
    with discovery_transaction(batch, manifest) as (state, commit):
        partition = state["partitions"].get(partition_id)
        if partition is None:
            raise ControlError("unknown_discovery_partition")
        previous_status = partition.get("status", "active")
        if (
            previous_status in {"saturated", "exhausted"}
            and args.status != previous_status
        ):
            raise ControlError("terminal_discovery_frontier_immutable")
        if (
            args.status == "active"
            and len(state["observations"])
            >= state["config"]["card_observation_limit"]
        ):
            raise ControlError("card_observation_limit_reached")
        partition["status"] = args.status
        if args.status == "active":
            partition["saturation_reason"] = None
        if args.cursor is not None:
            partition["cursor"] = args.cursor
        commit("discovery_partition_state", {
            "partition_updates": {partition_id: {
                key: value for key, value in partition.items() if key != "observations"
            }},
        })
    return {"partition_id": partition_id, "status": args.status, "cursor": partition["cursor"]}


def discovery_summary(args: argparse.Namespace) -> dict[str, Any]:
    batch, path = require_discovery_batch(args)
    manifest = read_json(batch / "manifest.json", {})
    state = load_discovery_state(batch, manifest)
    integrity = discovery_integrity(batch, manifest, state)
    observations = state["observations"]
    candidates = state["candidates"]
    partitions = {
        partition_id: {
            "fingerprint": partition["fingerprint"],
            "status": partition["status"],
            "saturation_reason": partition.get("saturation_reason"),
            "cursor": partition["cursor"],
            "next_cursor": partition["next_cursor"],
            "windows_observed": partition["windows_observed"],
        }
        for partition_id, partition in state["partitions"].items()
    }
    frontier = frontier_summary(state)
    return {
        "state": rel(path),
        "schema_version": state["schema_version"],
        "config": state["config"],
        "counters": {
            "cards_observed": len(observations),
            "unique_listings_observed": len(candidates),
            "duplicates_suppressed": sum(1 for item in observations if item.get("suppressed")),
            "full_ads_opened": sum(1 for item in candidates.values() if item.get("full_ad_opened")),
            "fully_assessed": integrity["valid_fully_assessed"],
            "invalid_discovery_candidates": len(integrity["errors"]),
            "deferred_due_to_batch_stop": sum(
                item.get("status") == "deferred_due_to_batch_stop"
                for item in candidates.values()
            ),
            "claimed_or_open": sum(
                item.get("status") in {"claimed", "full_ad_opened"}
                for item in candidates.values()
            ),
        },
        "partitions": partitions,
        "all_frontiers_terminal": frontier["all_complete"],
        "blocked_frontiers": frontier["blocked"],
        "frontier_pause_required": frontier["blocked"] > 0,
        "integrity_errors": integrity["errors"],
        "schedule": state["schedule"],
    }


def discovery_rebuild(args: argparse.Namespace) -> dict[str, Any]:
    batch, path = require_discovery_batch(args)
    manifest = read_json(batch / "manifest.json", {})
    event_path = discovery_event_path(batch)
    with exclusive_lock(event_path):
        events = read_jsonl(event_path)
        if not events:
            raise ControlError("discovery_event_history_required")
        state = replay_discovery_events(batch, manifest, events)
        integrity = discovery_integrity(batch, manifest, state)
        if integrity["errors"]:
            raise ControlError(
                "discovery_event_history_invalid:"
                + ",".join(integrity["errors"])
            )
        atomic_json(path, state)
    return {
        "state": rel(path),
        "events_replayed": len(events),
        "event_tail_sha256": state["event_tail_sha256"],
        "candidates": len(state["candidates"]),
        "observations": len(state["observations"]),
    }


def reduce_classification_command(args: argparse.Namespace) -> dict[str, Any]:
    try:
        return reduce_classification(read_json_arg(args.signals_json))
    except ClassificationError as exc:
        raise ControlError(str(exc)) from exc


def validate(args: argparse.Namespace) -> dict[str, Any]:
    scope = ROOT / args.track if args.track else ROOT
    checked, errors, markdown, toml_files, skipped_sensitive = [], [], [], [], 0
    schema_errors: list[str] = []
    # Legacy compatibility failures remain visible, but are reported after
    # current modern-batch diagnostics so a broken active batch is actionable.
    legacy_compat_errors: list[str] = []
    policy_sources: dict[str, str] = {}
    try:
        workspace_config()
    except ControlError as exc:
        errors.append(str(exc))
    def public_paths(pattern: str):
        nonlocal skipped_sensitive
        for path in scope.rglob(pattern):
            if (ROOT / "jobseek-template") in path.parents:
                continue
            if path.name.casefold() in SENSITIVE_NAMES or "private_details" in path.name.casefold() or is_sensitive_path(path):
                skipped_sensitive += 1
                continue
            yield path
    for path in public_paths("*.json"):
        try:
            read_json(path); checked.append(rel(path))
        except ControlError as exc:
            errors.append(str(exc))
    for path in public_paths("*.jsonl"):
        try:
            read_jsonl(path); checked.append(rel(path))
        except ControlError as exc:
            errors.append(str(exc))
    # Track validation still covers the repository authority that controls all
    # workers.  Do not recursively sweep templates or arbitrary vendor trees.
    toml_candidates = set(public_paths("*.toml"))
    for authority_dir in (ROOT / ".codex", ROOT / ".agents"):
        if authority_dir.exists():
            toml_candidates.update(authority_dir.rglob("*.toml"))
    for path in sorted(toml_candidates):
        if (ROOT / "jobseek-template") in path.parents or is_sensitive_path(path):
            continue
        try:
            parsed_toml = parse_authority_toml(path.read_text(encoding="utf-8"))
            # Root worker configuration must retain usable agent authority;
            # individual worker files are parsed above and intentionally may
            # disable child agents.
            if path == ROOT / ".codex" / "config.toml":
                agents = parsed_toml.get("agents")
                if not isinstance(agents, dict) or "enabled" not in agents:
                    raise ValueError("missing_agents_authority")
            toml_files.append(rel(path))
        except (OSError, ValueError, tomllib.TOMLDecodeError if tomllib else ValueError) as exc:  # type: ignore[union-attr]
            errors.append(f"invalid_toml:{rel(path)}:{exc}")
    for path in public_paths("*.md"):
        text = path.read_text(encoding="utf-8")
        if "[TODO:" in text or "{{" in text:
            errors.append(f"unresolved_placeholder:{rel(path)}")
        markdown.append(rel(path))
    batches = CONTROL / "batches"
    for manifest_path in batches.glob("*/manifest.json") if batches.exists() else []:
        manifest = read_json(manifest_path, {})
        try:
            batch = manifest_path.parent
            if manifest.get("schema_version", 1) < 2:
                # Preflight/resume performs the one-time migration. Validate is
                # diagnostic-only and never creates a compatibility snapshot.
                # Historical Preflight and Completed records are read-only
                # archives; only resumable active legacy batches need a
                # compatibility-source diagnostic here.
                if manifest.get("state") not in {"Preflight", "Completed"}:
                    try:
                        ensure_legacy_compatibility(
                            batch, manifest, manifest.get("track", args.track), mutate=False,
                        )
                    except ControlError as exc:
                        legacy_compat_errors.append(str(exc) + ":" + rel(batch))
                policy_sources[rel(batch)] = batch_policy_source(manifest)
                continue
            validate_batch_snapshot(manifest_path.parent, manifest)
            batch_policy(manifest)
            policy_sources[rel(manifest_path.parent)] = batch_policy_source(manifest)
            batch_events = read_jsonl(manifest_path.parent / "events.jsonl")
            replay_agent_calls(batch_events)
            submission_attempt_lifecycle(batch_events)
            if BATCH_ID_RE.fullmatch(str(manifest.get("batch_id", ""))):
                schema_errors.extend(schema_validate_file(
                    manifest, manifest_path,
                    ROOT / ".jobseek" / "schemas" / "batch_manifest.schema.json",
                ))
            event_schema = ROOT / ".jobseek" / "schemas" / "event.schema.json"
            for event_index, event in enumerate(batch_events):
                schema_errors.extend(schema_validate_file(
                    event, batch / "events.jsonl", event_schema,
                ))
            packet_schema = ROOT / ".jobseek" / "schemas" / "job_evidence_packet.schema.json"
            for packet_file in sorted((batch / "jobs").glob("*/job_evidence_packet.json")):
                packet_value = read_json(packet_file, {})
                schema_errors.extend(schema_validate_file(packet_value, packet_file, packet_schema))
            discovery_file = discovery_path(batch)
            if discovery_file.exists():
                schema_errors.extend(schema_validate_file(
                    load_discovery_state(batch, manifest), discovery_file,
                    ROOT / ".jobseek" / "schemas" / "discovery_state.schema.json",
                ))
            for event in batch_events:
                if event.get("actor") is not None and event.get("actor") not in ACTORS:
                    raise ControlError("event_unknown_actor:" + rel(manifest_path.parent))
                evidence = event.get("evidence")
                if evidence is not None and (
                    not isinstance(evidence, dict)
                    or not isinstance(evidence.get("path"), str)
                    or not evidence["path"]
                    or not re.fullmatch(r"[a-f0-9]{64}", str(evidence.get("sha256", "")))
                ):
                    raise ControlError("event_invalid_evidence:" + rel(manifest_path.parent))
            state = load_discovery_state(manifest_path.parent, manifest)
            if not discovery_snapshot_consistent(
                manifest_path.parent, manifest, state,
            ):
                raise ControlError(
                    "discovery_snapshot_replay_mismatch:"
                    + rel(manifest_path.parent)
                )
            integrity = discovery_integrity(
                manifest_path.parent, manifest, state,
            )
            if integrity["errors"]:
                raise ControlError(
                    "discovery_integrity_invalid:"
                    + rel(manifest_path.parent)
                    + ":"
                    + integrity["errors"][0]
                )
            counters = derive_counters(batch, manifest, state)
            if counters.get("unresolved_submission_confirmations"):
                errors.append(
                    f"submission_confirmation_unresolved:{rel(batch)}"
                )
            latest_states: dict[str, str] = {}
            attempt_bound_types = {
                "submission_review", "submission_approval", "confirmation_assessment",
                "confirmation_audit_trigger", "confirmation_audit_result",
                "submission_records_finalization_intent", "submission_records_finalized",
            }
            for event in batch_events:
                attempt_bound = event.get("event_type") in attempt_bound_types or (
                    event.get("event_type") == "gate"
                    and event.get("gate_type") in {
                        "submission_evidence", "confirmation_audit",
                    }
                )
                if attempt_bound:
                    attempt = event.get("submission_attempt_id")
                    if not isinstance(attempt, str) or not attempt:
                        errors.append(f"submission_attempt_binding_invalid:{rel(batch)}")
            for event in batch_events:
                if event.get("event_type") == "state_transition":
                    latest_states[event.get("job_key")] = event.get("to_state")
            for key, state_value in latest_states.items():
                packet_file = packet_path(batch, key)
                if not packet_file.exists():
                    continue
                packet = read_json(packet_file, {})
                try:
                    packet_hash = sha256(packet_file)
                except OSError:
                    continue
                if state_value in {
                    "Package Prepared", "Awaiting User Review", "Submission Ready",
                    "Submitted", "Submission Verified",
                } and eligibility_gate_required(packet, batch, key):
                    if gate_event(batch, key, "eligibility_audit", packet_hash) is None:
                        errors.append(f"eligibility_gate_stale:{rel(batch)}:{key}")
                if state_value == "Submission Verified":
                    attempt = latest_state_attempt(batch_events, key, "Submission Verified")
                    try:
                        if not attempt:
                            raise ControlError("missing_attempt")
                        require_confirmation_gate(batch, key, packet_hash, attempt)
                    except ControlError:
                        errors.append(f"verified_submission_confirmation_chain_invalid:{rel(batch)}:{key}")
                if state_value in {"Submitted", "Blocked"} and post_submit_attempt_state(batch, key):
                    if counters.get("unresolved_submission_confirmations"):
                        errors.append(f"submission_confirmation_unresolved:{rel(batch)}:{key}")
            if counters.get("retry_exhausted_scopes"):
                for scope in counters["retry_exhausted_scopes"]:
                    errors.append(f"retry_exhausted_scope:{rel(batch)}:{scope}")
            if manifest.get("state") == "Completed":
                if counters.get("active_agent_calls"):
                    errors.append(f"finalized_active_agent_calls:{rel(batch)}")
                if counters.get("unresolved_submission_confirmations"):
                    errors.append(f"finalized_unresolved_submission:{rel(batch)}")
                if not counters.get("all_frontiers_terminal"):
                    errors.append(f"finalized_unresolved_frontier:{rel(batch)}")
                for scope in verified_submissions_missing_records(batch, batch_events):
                    errors.append(f"finalized_submission_records_missing:{rel(batch)}:{scope}")
        except ControlError as exc:
            errors.append(str(exc))
    errors.extend(schema_errors)
    errors.extend(legacy_compat_errors)
    return {"ok": not errors, "checked": len(checked), "markdown_checked": len(markdown),
            "toml_checked": len(toml_files), "sensitive_files_excluded": skipped_sensitive,
            "policy_sources": policy_sources, "errors": errors}


def verify_files(args: argparse.Namespace) -> dict[str, Any]:
    records = read_json_arg(args.files_json)
    if not isinstance(records, list):
        raise ControlError("files_json_must_be_list")
    failures = []
    for item in records:
        if not isinstance(item, dict) or not isinstance(item.get("path"), str):
            failures.append({"path": None, "error": "invalid_file_record"}); continue
        try:
            # Resolve/reject before any exists() or sha256() call.
            path = public_workspace_path(item["path"])
        except ControlError as exc:
            failures.append({"path": None if str(exc) == "sensitive_path_rejected" else item["path"], "error": str(exc)}); continue
        if not path.exists():
            if item.get("required", True): failures.append({"path": item.get("path"), "error": "missing"})
            continue
        if item.get("sha256") and sha256(path) != item["sha256"]:
            failures.append({"path": item.get("path"), "error": "hash_mismatch"})
    return {"ok": not failures, "files_checked": len(records), "failures": failures}


def tracker_append_plan(track: str, record: Any, identifier: str = "application_id") -> tuple[Path, bytes, str]:
    safe_track(track)
    if not isinstance(record, dict): raise ControlError("tracker_record_must_be_object")
    if not identifier or identifier not in record: raise ControlError("tracker_identifier_missing")
    path = ROOT / track / "Tracker" / "applications.jsonl"
    rows = read_jsonl(path)
    if any(row.get(identifier) == record[identifier] for row in rows):
        raise ControlError("tracker_identifier_already_exists")
    return path, (json.dumps(record, ensure_ascii=False, separators=(",", ":")) + "\n").encode("utf-8"), str(record[identifier])


def append_bytes(path: Path, payload: bytes) -> int:
    before = path.stat().st_size if path.exists() else 0
    prefix = b"" if before == 0 or path.read_bytes().endswith(b"\n") else b"\n"
    with path.open("ab") as handle:
        handle.write(prefix + payload); handle.flush(); os.fsync(handle.fileno())
    return before


def rollback_to(path: Path, size: int) -> None:
    with path.open("r+b") as handle:
        handle.truncate(size); handle.flush(); os.fsync(handle.fileno())


def workspace_path(value: str) -> Path:
    if not isinstance(value, str) or not value:
        raise ControlError("invalid_workspace_path")
    path = (ROOT / value).resolve()
    if ROOT not in path.parents and path != ROOT:
        raise ControlError("path_outside_workspace")
    return path


def raw_sensitive_path(value: str) -> bool:
    return any(sensitive_path_component(part) for part in Path(value).parts)


def sensitive_path_component(part: str) -> bool:
    # Split separators and CamelCase: PassportDetails is sensitive, Visagio is not a visa path.
    expanded = re.sub(r"(?<=[a-z])(?=[A-Z])", " ", part)
    words = set(re.findall(r"[a-z0-9]+", expanded.casefold()))
    if words.intersection(set(SENSITIVE_PATH_TOKENS) - {"bank"}):
        return True
    # A generic content bank is not a banking record; require banking context for this token.
    return "bank" in words and bool(words.intersection({"account", "details", "statement", "card", "bsb"}))


def is_sensitive_path(path: Path) -> bool:
    """Classify by path only; never open, hash or stat a potentially private file."""
    private_details = (ROOT / "Profile" / "Private_Details.md").resolve()
    resolved = path.resolve()
    if resolved == private_details or resolved in private_details.parents:
        return True
    return any(sensitive_path_component(part) for part in resolved.parts)


def public_workspace_path(value: str) -> Path:
    # Both the caller spelling and resolved target are checked, so ../ and symlink bypasses fail.
    if raw_sensitive_path(value):
        raise ControlError("sensitive_path_rejected")
    path = workspace_path(value)
    if is_sensitive_path(path):
        raise ControlError("sensitive_path_rejected")
    return path


def canonical_json_sha256(value: Any) -> str:
    return hashlib.sha256(
        json.dumps(value, ensure_ascii=False, sort_keys=True, separators=(",", ":")).encode("utf-8")
    ).hexdigest()


def archive_matches_plan(archive: Path, files: list[dict[str, str]]) -> bool:
    if not archive.is_dir():
        return False
    actual = {
        str(path.relative_to(archive)): sha256(path)
        for path in archive.rglob("*")
        if path.is_file()
    }
    expected = {item["path"]: item["sha256"] for item in files}
    return actual == expected


def tracker_record_status(
    path: Path,
    record: dict[str, Any],
    identifier: str,
) -> str:
    matches = [row for row in read_jsonl(path) if row.get(identifier) == record[identifier]]
    if not matches:
        return "missing"
    if len(matches) == 1 and matches[0] == record:
        return "present"
    raise ControlError("tracker_identifier_conflict")


def finalization_event(
    events: list[dict[str, Any]],
    event_type: str,
    key: str,
    attempt_id: str,
) -> dict[str, Any] | None:
    return next((
        event for event in reversed(events)
        if event.get("event_type") == event_type
        and event.get("job_key") == key
        and event.get("submission_attempt_id") == attempt_id
    ), None)


def finalize_records(args: argparse.Namespace) -> dict[str, Any]:
    safe_track(args.track)
    key = safe_id(args.job_key, "job_key")
    batch, _ = require_batch(args.track, args.batch_id)
    if job_state(batch, key) != "Submission Verified":
        raise ControlError("submission_verification_required")
    _, packet_hash, _ = load_valid_packet(batch, args.track, key)
    attempt_id = current_submission_attempt(batch, key)
    require_confirmation_gate(batch, key, packet_hash, attempt_id)

    events_path = batch / "events.jsonl"
    events = read_jsonl(events_path)
    existing = finalization_event(
        events, "submission_records_finalized", key, attempt_id,
    )
    if existing:
        return {**existing.get("result", {}), "reused": True}

    source = public_workspace_path(args.source_dir)
    archive = public_workspace_path(args.archive_dir)
    application_root = (ROOT / args.track / "Applications").resolve()
    if application_root not in archive.parents:
        raise ControlError("invalid_archive_location")
    records = read_json_arg(args.files_json)
    if not isinstance(records, list) or not records:
        raise ControlError("files_json_must_be_nonempty_list")
    tracker_record = read_json_arg(args.tracker_record_json)
    if not isinstance(tracker_record, dict):
        raise ControlError("tracker_record_must_be_object")
    if not args.identifier or args.identifier not in tracker_record:
        raise ControlError("tracker_identifier_missing")
    if "\x00" in args.log_line or not args.log_line.strip():
        raise ControlError("invalid_log_line")

    copied: list[dict[str, str]] = []
    for item in records:
        if not isinstance(item, dict):
            raise ControlError("invalid_archive_file_path")
        relative_name = item.get("path")
        if (
            not isinstance(relative_name, str)
            or not relative_name
            or Path(relative_name).is_absolute()
            or ".." in Path(relative_name).parts
        ):
            raise ControlError("invalid_archive_file_path")
        if raw_sensitive_path(relative_name):
            raise ControlError("sensitive_path_rejected")
        expected_hash = item.get("sha256")
        if expected_hash is not None and not re.fullmatch(r"[a-f0-9]{64}", str(expected_hash)):
            raise ControlError("archive_source_hash_mismatch")
        # If a previous process already committed the archive, recovery must not
        # require the temporary source directory to still exist.
        if archive.is_dir():
            archived = (archive / relative_name).resolve()
            if archive not in archived.parents or not archived.is_file() or is_sensitive_path(archived):
                raise ControlError("archive_recovery_mismatch")
            actual_hash = sha256(archived)
        else:
            if not source.is_dir():
                raise ControlError("invalid_archive_location")
            origin = (source / relative_name).resolve()
            if source not in origin.parents or not origin.is_file() or is_sensitive_path(origin):
                raise ControlError("missing_or_unsafe_archive_source")
            actual_hash = sha256(origin)
        if expected_hash and actual_hash != expected_hash:
            raise ControlError("archive_source_hash_mismatch")
        copied.append({"path": relative_name, "sha256": actual_hash})
    if len({item["path"] for item in copied}) != len(copied):
        raise ControlError("duplicate_archive_file_path")
    copied.sort(key=lambda item: item["path"])

    tracker_path = ROOT / args.track / "Tracker" / "applications.jsonl"
    log_path = ROOT / args.track / "Logs" / "Run_Log.md"
    identifier = str(tracker_record[args.identifier])
    finalization_id = "finalization-" + hashlib.sha256(
        f"{args.batch_id}|{key}|{attempt_id}".encode()
    ).hexdigest()[:24]
    log_marker = f"<!-- jobseek-finalization:{finalization_id} -->"
    change_path = batch / "change_manifests" / f"{key}.json"
    result = {
        "archive": rel(archive),
        "change_manifest": rel(change_path),
        "files": len(copied),
        "tracker": {
            "path": rel(tracker_path),
            "appended": True,
            "identifier": identifier,
        },
        "submission_attempt_id": attempt_id,
        "finalization_id": finalization_id,
    }
    request = {
        "batch_id": args.batch_id,
        "track": args.track,
        "job_key": key,
        "submission_attempt_id": attempt_id,
        "source_dir": rel(source),
        "archive_dir": rel(archive),
        "files": copied,
        "tracker_record": tracker_record,
        "tracker_identifier_field": args.identifier,
        "log_line": args.log_line.rstrip(),
    }
    request_hash = canonical_json_sha256(request)
    intent_event = {
        "schema_version": 1,
        "event_type": "submission_records_finalization_intent",
        "at": now(),
        "batch_id": args.batch_id,
        "track": args.track,
        "job_key": key,
        "actor": "lead",
        "submission_attempt_id": attempt_id,
        "packet_sha256": packet_hash,
        "finalization_id": finalization_id,
        "request_sha256": request_hash,
        "archive_files": copied,
        "change_manifest": rel(change_path),
        "result": result,
    }

    with exclusive_lock(events_path):
        locked_events = read_jsonl(events_path)
        completed = finalization_event(
            locked_events, "submission_records_finalized", key, attempt_id,
        )
        if completed:
            return {**completed.get("result", {}), "reused": True}
        prior_intent = finalization_event(
            locked_events, "submission_records_finalization_intent", key, attempt_id,
        )
        if prior_intent:
            if (
                prior_intent.get("request_sha256") != request_hash
                or prior_intent.get("finalization_id") != finalization_id
            ):
                raise ControlError("submission_records_finalization_request_changed")
        else:
            append_jsonl_unlocked(events_path, intent_event)

    operation_lock = batch / "record_finalization" / f"{key}-{attempt_id}"
    with exclusive_lock(operation_lock):
        manifest = {
            "schema_version": 2,
            "batch_id": args.batch_id,
            "track": args.track,
            "job_key": key,
            "created_at": now(),
            "finalization_id": finalization_id,
            "request_sha256": request_hash,
            "archive_path": rel(archive),
            "files": copied,
            "tracker": {
                "path": rel(tracker_path),
                "action": "append_idempotent",
                "identifier_field": args.identifier,
                "identifier": identifier,
                "record_sha256": canonical_json_sha256(tracker_record),
            },
            "log": {
                "path": rel(log_path),
                "action": "append_idempotent",
                "marker": log_marker,
                "line_sha256": hashlib.sha256(args.log_line.rstrip().encode()).hexdigest(),
            },
            "notice": "Recoverable append-only finalization intent; no semantic conclusion generated.",
        }
        prior_manifest = read_json(change_path, None)
        if isinstance(prior_manifest, dict):
            # Old pre-repair manifests are accepted only when their committed
            # archive/tracker identity matches this exact retry request.
            compatible_old = (
                prior_manifest.get("batch_id") == args.batch_id
                and prior_manifest.get("track") == args.track
                and prior_manifest.get("job_key") == key
                and prior_manifest.get("archive_path") == rel(archive)
                and prior_manifest.get("files") == copied
                and isinstance(prior_manifest.get("tracker"), dict)
                and prior_manifest["tracker"].get("path") == rel(tracker_path)
                and str(prior_manifest["tracker"].get("identifier")) == identifier
            )
            if prior_manifest.get("request_sha256") != request_hash and not compatible_old:
                raise ControlError("change_manifest_conflict")
        atomic_json(change_path, manifest)

        if archive.exists():
            if not archive_matches_plan(archive, copied):
                raise ControlError("archive_recovery_mismatch")
        else:
            if not source.is_dir():
                raise ControlError("missing_or_unsafe_archive_source")
            staging_root = batch / "record_staging"
            staging_root.mkdir(parents=True, exist_ok=True)
            staging = Path(tempfile.mkdtemp(prefix=f".{key}.", dir=staging_root))
            try:
                for item in copied:
                    origin = (source / item["path"]).resolve()
                    target = (staging / item["path"]).resolve()
                    if source not in origin.parents or staging not in target.parents or not origin.is_file():
                        raise ControlError("missing_or_unsafe_archive_source")
                    if sha256(origin) != item["sha256"]:
                        raise ControlError("archive_source_hash_mismatch")
                    target.parent.mkdir(parents=True, exist_ok=True)
                    shutil.copy2(origin, target)
                    if sha256(target) != item["sha256"]:
                        raise ControlError("archive_copy_verification_failed")
                archive.parent.mkdir(parents=True, exist_ok=True)
                staging.replace(archive)
            except Exception:
                shutil.rmtree(staging, ignore_errors=True)
                raise

        tracker_payload = (
            json.dumps(tracker_record, ensure_ascii=False, separators=(",", ":")) + "\n"
        ).encode("utf-8")
        with exclusive_lock(tracker_path), exclusive_lock(log_path):
            if tracker_record_status(tracker_path, tracker_record, args.identifier) == "missing":
                append_bytes(tracker_path, tracker_payload)
            log_text = log_path.read_text(encoding="utf-8") if log_path.exists() else ""
            if log_marker not in log_text:
                exact_line_present = any(
                    line.rstrip() == args.log_line.rstrip()
                    for line in log_text.splitlines()
                )
                payload = (
                    ("\n" if log_text else "")
                    + ("" if exact_line_present else args.log_line.rstrip() + "\n")
                    + log_marker
                    + "\n"
                ).encode("utf-8")
                append_bytes(log_path, payload)

        if not archive_matches_plan(archive, copied):
            raise ControlError("archive_recovery_mismatch")
        if tracker_record_status(tracker_path, tracker_record, args.identifier) != "present":
            raise ControlError("tracker_finalization_missing")
        if log_marker not in log_path.read_text(encoding="utf-8"):
            raise ControlError("log_finalization_missing")

        finalized_event = {
            "schema_version": 1,
            "event_type": "submission_records_finalized",
            "at": now(),
            "batch_id": args.batch_id,
            "track": args.track,
            "job_key": key,
            "actor": "lead",
            "submission_attempt_id": attempt_id,
            "packet_sha256": packet_hash,
            "finalization_id": finalization_id,
            "request_sha256": request_hash,
            "change_manifest": rel(change_path),
            "result": result,
        }
        with exclusive_lock(events_path):
            locked_events = read_jsonl(events_path)
            completed = finalization_event(
                locked_events, "submission_records_finalized", key, attempt_id,
            )
            if not completed:
                append_jsonl_unlocked(events_path, finalized_event)
    return {**result, "reused": False}

def verified_submissions_missing_records(batch: Path, events: list[dict[str, Any]]) -> list[str]:
    """Return attempt-scoped verified submissions without finalised records."""
    required = {
        (event.get("job_key"), event.get("submission_attempt_id"))
        for event in events
        if event.get("event_type") == "state_transition"
        and event.get("to_state") == "Submission Verified"
        and isinstance(event.get("job_key"), str)
        and isinstance(event.get("submission_attempt_id"), str)
    }
    completed = {
        (event.get("job_key"), event.get("submission_attempt_id"))
        for event in events
        if event.get("event_type") == "submission_records_finalized"
    }
    return sorted(f"{key}:{attempt}" for key, attempt in required - completed)


def finalize_batch(args: argparse.Namespace) -> dict[str, Any]:
    """Close a drained batch after a deterministic aggregate stop condition."""
    if args.actor != "lead":
        raise ControlError("only_lead_may_finalize_batch")
    batch, manifest = require_batch(args.track, args.batch_id)
    events_path = batch / "events.jsonl"
    discovery_events_path = discovery_event_path(batch)
    with exclusive_lock(events_path), exclusive_lock(discovery_events_path):
        locked_manifest = read_json(batch / "manifest.json", manifest)
        events = read_jsonl(events_path)
        prior = next((
            event for event in reversed(events)
            if event.get("event_type") == "batch_finalized"
        ), None)
        if prior is not None:
            completed_at = prior.get("at")
            if locked_manifest.get("state") != "Completed":
                atomic_json(batch / "manifest.json", {
                    **locked_manifest,
                    "state": "Completed",
                    "completed_at": completed_at,
                    "stopping_condition_number": prior.get(
                        "stopping_condition_number"
                    ),
                    "stopping_reason": prior.get("stopping_reason"),
                })
            return {
                "batch_id": args.batch_id,
                "state": "Completed",
                "completed_at": completed_at,
                "stopping_condition_number": prior.get(
                    "stopping_condition_number"
                ),
                "stopping_reason": prior.get("stopping_reason"),
                "reused": True,
            }
        if locked_manifest.get("state") == "Completed":
            raise ControlError("completed_batch_missing_finalization_event")

        active = sorted(replay_agent_calls(events)["active"])
        if active:
            raise ControlError("batch_has_active_worker_calls")
        discovery_events = read_jsonl(discovery_events_path)
        if discovery_events:
            state = replay_discovery_events(
                batch, locked_manifest, discovery_events,
            )
        else:
            state = normalize_discovery_state(
                read_json(discovery_path(batch)),
                locked_manifest["track"],
                locked_manifest["batch_id"],
            )
            state = stamp_discovery_snapshot(state, [])
        integrity = discovery_integrity(batch, locked_manifest, state)
        if integrity["errors"]:
            raise ControlError("batch_discovery_integrity_invalid")
        counters = derive_counters(batch, locked_manifest, state)
        if args.counters_json and read_json_arg(args.counters_json) != counters:
            raise ControlError("caller_supplied_counters_rejected")
        if counters.get("state_unreliable"):
            raise ControlError("batch_has_unresolved_state_unreliable_signal")
        if counters.get("material_risk"):
            raise ControlError("batch_has_unresolved_material_risk_signal")
        if counters.get("unresolved_submission_confirmations"):
            raise ControlError("batch_has_unresolved_submission_confirmation")
        missing_records = verified_submissions_missing_records(batch, events)
        if missing_records:
            raise ControlError(
                "submission_records_finalization_required:"
                + ",".join(missing_records)
            )
        if counters["blocked_frontiers"]:
            raise ControlError("batch_has_blocked_discovery_frontiers")
        if not counters["all_frontiers_terminal"]:
            raise ControlError("batch_frontiers_not_terminal")
        if counters["unprocessed_candidates"]:
            raise ControlError("batch_has_unprocessed_discovery_items")
        if counters["pending_user_items"]:
            raise ControlError("batch_waiting_for_user")
        if counters["recoverable_blocked_items"]:
            raise ControlError("batch_has_recoverable_blocked_jobs")
        if counters["automatically_processable_items"]:
            raise ControlError("batch_has_automatically_processable_work")

        latest_states: dict[str, str] = {}
        for event in events:
            if event.get("event_type") == "state_transition":
                latest_states[event.get("job_key")] = event.get("to_state")
        transient = {
            key: state_value for key, state_value in latest_states.items()
            if state_value in {
                "Discovered", "Assessed", "Eligible", "Package Prepared",
                "Awaiting User Review", "Submission Ready", "Submitted",
                "Failed",
            }
        }
        if transient:
            raise ControlError("batch_has_nonterminal_jobs")

        stopping = stop_result(counters, batch_policy(locked_manifest))
        if stopping.get("pause"):
            raise ControlError("batch_pause_cannot_finalize")
        if not stopping["stop"]:
            raise ControlError("batch_stop_condition_not_met")
        finalized_at = now()
        event = {
            "schema_version": 1,
            "event_type": "batch_finalized",
            "at": finalized_at,
            "batch_id": args.batch_id,
            "track": args.track,
            "actor": args.actor,
            "stopping_condition_number": stopping["number"],
            "stopping_reason": stopping["reason"],
            "active_worker_calls": 0,
            "counters": counters,
        }
        append_jsonl_unlocked(events_path, event)
        atomic_json(batch / "manifest.json", {
            **locked_manifest,
            "state": "Completed",
            "completed_at": finalized_at,
            "stopping_condition_number": stopping["number"],
            "stopping_reason": stopping["reason"],
        })
    return {
        "batch_id": args.batch_id,
        "state": "Completed",
        "completed_at": finalized_at,
        "stopping_condition_number": stopping["number"],
        "stopping_reason": stopping["reason"],
        "reused": False,
    }


def command(args: argparse.Namespace) -> dict[str, Any]:
    read_only_batch_actions = {"discovery-summary", "question-status", "runtime-context", "validate"}
    if (
        args.action != "preflight"
        and hasattr(args, "track")
        and hasattr(args, "batch_id")
        and args.track
        and args.batch_id
    ):
        require_batch(
            args.track,
            args.batch_id,
            allow_completed=args.action in read_only_batch_actions,
            migrate_legacy=args.action != "validate",
        )
    if args.action == "preflight":
        return init_batch(
            args.track, args.batch_id, args.dry_run, args.new_batch,
            args.test_mode, args.legacy_test_mode,
        )
    if args.action == "runtime-context":
        batch, manifest = require_batch(
            args.track, args.batch_id, allow_completed=True,
        )
        return batch_runtime_context(batch, manifest)
    if args.action == "rebuild-cache": return rebuild_cache(args.track)
